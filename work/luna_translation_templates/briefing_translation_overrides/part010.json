{
  "packet": 10,
  "translations": [
    {"file_id":"BRIEFING_FILES_BLOCK_0331A0","unique_index":1,"cn_text":"我也不情愿，但别无选择。毫不抵抗只会任人剥削，祖国迄今的历史已经证明了这一点。","review_flag":"AUX_REFERENCE_REJECTED_SEGMENTATION_REBUILT"},
    {"file_id":"BRIEFING_FILES_BLOCK_0331A0","unique_index":3,"cn_text":"可要带来和平，首先必须清除卖国贼。","review_flag":"SEGMENTATION_REBUILT"},
    {"file_id":"BRIEFING_FILES_BLOCK_033680","unique_index":5,"cn_text":"格瓦拉也是<R=桑地诺民族解放阵线,FSLN>的英雄吗？","review_flag":"RUBY_LOCALIZED"},
    {"file_id":"BRIEFING_FILES_BLOCK_033680","unique_index":6,"cn_text":"当然。<R=桑地诺民族解放阵线,FSLN>正是认同Che和Fidel的思想才成立的。","review_flag":"RUBY_LOCALIZED"},
    {"file_id":"BRIEFING_FILES_BLOCK_033680","unique_index":10,"cn_text":"即使当上古巴部长，他仍放弃休假去务农、参加土木劳动，而且还是志愿劳动。","review_flag":"AUX_REFERENCE_INCOMPLETE_SEGMENTATION_REBUILT"},
    {"file_id":"BRIEFING_FILES_BLOCK_033680","unique_index":11,"cn_text":"这些我也听说过。但能否说，正是这种洁癖把格瓦拉自己逼入了绝境？","review_flag":"SEGMENTATION_REBUILT"},
    {"file_id":"BRIEFING_FILES_BLOCK_033680","unique_index":18,"cn_text":"若有他那样的<R=领袖,COMANDANTE>，<R=桑地诺民族解放阵线,FSLN>的士气也会提高吧。","review_flag":"RUBY_LOCALIZED"},
    {"file_id":"BRIEFING_FILES_BLOCK_034100","unique_index":6,"cn_text":"看到它以后，有名队员说“里面坐着<R=新人,HOMBRE NUEVO>”。","review_flag":"RUBY_LOCALIZED"},
    {"file_id":"BRIEFING_FILES_BLOCK_034100","unique_index":9,"cn_text":"因为“<R=新人,HOMBRE NUEVO>”正是格瓦拉追求的理想，也是加入<R=桑地诺民族解放阵线,FSLN>之人的目标。","review_flag":"SEGMENTATION_REBUILT_RUBY_LOCALIZED"},
    {"file_id":"BRIEFING_FILES_BLOCK_034100","unique_index":10,"cn_text":"讲求道德、以自发劳动为乐的“新人”……把这个名字送给那种怪物，实在令人不甘。","review_flag":"SEGMENTATION_REBUILT"},
    {"file_id":"BRIEFING_FILES_BLOCK_0346C0","unique_index":0,"cn_text":"Chico把那架直升机叫作Colibrí。","review_flag":"JPN_DIRECT_TRANSLATION"},
    {"file_id":"BRIEFING_FILES_BLOCK_0346C0","unique_index":1,"cn_text":"这里把蜂鸟叫作Colibrí，那架直升机的动作也很像，比如悬停在空中。","review_flag":"JPN_DIRECT_TRANSLATION"},
    {"file_id":"BRIEFING_FILES_BLOCK_0346C0","unique_index":2,"cn_text":"体型倒差得远。","review_flag":"JPN_DIRECT_TRANSLATION"},
    {"file_id":"BRIEFING_FILES_BLOCK_0346C0","unique_index":3,"cn_text":"是啊。不过这个名字总比Hombre Nuevo好。","review_flag":"JPN_DIRECT_TRANSLATION"},
    {"file_id":"BRIEFING_FILES_BLOCK_0346C0","unique_index":4,"cn_text":"一旦被Colibrí<R=掳走,RAPTAR>就完了。会被带到战俘营，受尽折磨，直到供出伙伴。","review_flag":"JPN_DIRECT_TRANSLATION_RUBY_LOCALIZED"},
    {"file_id":"BRIEFING_FILES_BLOCK_0346C0","unique_index":5,"cn_text":"Chico就是被它<R=掳走,ABDUCT>的吗……","review_flag":"JPN_DIRECT_TRANSLATION_RUBY_LOCALIZED"},
    {"file_id":"BRIEFING_FILES_BLOCK_0346C0","unique_index":6,"cn_text":"他们用刑毫不留情。即使开口，也会被当成破布一样扔掉……","review_flag":"JPN_DIRECT_TRANSLATION"},
    {"file_id":"BRIEFING_FILES_BLOCK_0346C0","unique_index":7,"cn_text":"我明知如此，却没能救下Chico。既然救不了，不如亲手……","review_flag":"JPN_DIRECT_TRANSLATION"},
    {"file_id":"BRIEFING_FILES_BLOCK_0346C0","unique_index":8,"cn_text":"别轻易说这种话。有时即便失去名誉，也必须活下去。","review_flag":"JPN_DIRECT_TRANSLATION"},
    {"file_id":"BRIEFING_FILES_BLOCK_0346C0","unique_index":9,"cn_text":"放心，我一定会救出Chico。","review_flag":"JPN_DIRECT_TRANSLATION"},
    {"file_id":"BRIEFING_FILES_BLOCK_034C20","unique_index":0,"cn_text":"Snake，我想听听你的看法。敌方雇佣兵实力如何？","review_flag":"JPN_DIRECT_TRANSLATION"},
    {"file_id":"BRIEFING_FILES_BLOCK_034C20","unique_index":1,"cn_text":"训练有素，人数充足，也习惯实战。大概有很多越战老兵，是群强敌。","review_flag":"JPN_DIRECT_TRANSLATION"},
    {"file_id":"BRIEFING_FILES_BLOCK_034C20","unique_index":2,"cn_text":"装备也很精良。能如此大规模运用坦克与攻击直升机的雇佣兵部队并不多见。","review_flag":"JPN_DIRECT_TRANSLATION"},
    {"file_id":"BRIEFING_FILES_BLOCK_034C20","unique_index":3,"cn_text":"说明他们资金充裕，也有取得那些大型武器的门路。","review_flag":"JPN_DIRECT_TRANSLATION"},
    {"file_id":"BRIEFING_FILES_BLOCK_034C20","unique_index":4,"cn_text":"背后有大名鼎鼎的CIA支持，当然了。","review_flag":"JPN_DIRECT_TRANSLATION"},
    {"file_id":"BRIEFING_FILES_BLOCK_034C20","unique_index":5,"cn_text":"反观我们，一半是农民，一半是学生，还有<R=孩子,CHICO>；就连武器也得从敌人手里抢来凑数。","review_flag":"JPN_DIRECT_TRANSLATION_RUBY_LOCALIZED"},
    {"file_id":"BRIEFING_FILES_BLOCK_034C20","unique_index":6,"cn_text":"虽然不甘心，但始终被他们压着打。","review_flag":"JPN_DIRECT_TRANSLATION"},
    {"file_id":"BRIEFING_FILES_BLOCK_034C20","unique_index":7,"cn_text":"是啊。","review_flag":"JPN_DIRECT_TRANSLATION"},
    {"file_id":"BRIEFING_FILES_BLOCK_034C20","unique_index":8,"cn_text":"就连我们依靠的<R=父亲,MI VIEJO>也失去了……","review_flag":"JPN_DIRECT_TRANSLATION_RUBY_LOCALIZED"},
    {"file_id":"BRIEFING_FILES_BLOCK_034C20","unique_index":9,"cn_text":"嗯，是啊。","review_flag":"JPN_DIRECT_TRANSLATION"},
    {"file_id":"BRIEFING_FILES_BLOCK_034C20","unique_index":10,"cn_text":"……我们真的能赢吗？","review_flag":"JPN_DIRECT_TRANSLATION"},
    {"file_id":"BRIEFING_FILES_BLOCK_034C20","unique_index":11,"cn_text":"Snake，你怎么看？","review_flag":"JPN_DIRECT_TRANSLATION"},
    {"file_id":"BRIEFING_FILES_BLOCK_034C20","unique_index":12,"cn_text":"没有信心吗？","review_flag":"JPN_DIRECT_TRANSLATION"},
    {"file_id":"BRIEFING_FILES_BLOCK_034C20","unique_index":13,"cn_text":"可是……","review_flag":"JPN_DIRECT_TRANSLATION"},
    {"file_id":"BRIEFING_FILES_BLOCK_034C20","unique_index":14,"cn_text":"Amanda。","review_flag":"JPN_DIRECT_TRANSLATION"},
    {"file_id":"BRIEFING_FILES_BLOCK_034C20","unique_index":15,"cn_text":"什么？","review_flag":"JPN_DIRECT_TRANSLATION"},
    {"file_id":"BRIEFING_FILES_BLOCK_034C20","unique_index":16,"cn_text":"听好，绝不能在伙伴面前用这种语气说话。","review_flag":"JPN_DIRECT_TRANSLATION"},
    {"file_id":"BRIEFING_FILES_BLOCK_034C20","unique_index":17,"cn_text":"……啊？","review_flag":"JPN_DIRECT_TRANSLATION"},
    {"file_id":"BRIEFING_FILES_BLOCK_034C20","unique_index":18,"cn_text":"你是领袖。领袖无论何时都必须昂首挺立。","review_flag":"JPN_DIRECT_TRANSLATION"},
    {"file_id":"BRIEFING_FILES_BLOCK_034C20","unique_index":19,"cn_text":"哪怕内心承受再多痛苦，哪怕快被不安和恐惧压垮。","review_flag":"JPN_DIRECT_TRANSLATION"},
    {"file_id":"BRIEFING_FILES_BLOCK_034C20","unique_index":20,"cn_text":"让伙伴和部下感到坚不可摧的安心，这就是领袖的职责。别忘了。","review_flag":"JPN_DIRECT_TRANSLATION"},
    {"file_id":"BRIEFING_FILES_BLOCK_034C20","unique_index":21,"cn_text":"……Snake。","review_flag":"JPN_DIRECT_TRANSLATION"},
    {"file_id":"BRIEFING_FILES_BLOCK_034C20","unique_index":22,"cn_text":"想寻求安慰就去教堂，我没有更多话可说。","review_flag":"JPN_DIRECT_TRANSLATION"},
    {"file_id":"BRIEFING_FILES_BLOCK_034C20","unique_index":23,"cn_text":"你说得对。对不起，我必须振作起来。","review_flag":"JPN_DIRECT_TRANSLATION"},
    {"file_id":"BRIEFING_FILES_BLOCK_034C20","unique_index":24,"cn_text":"没错，你一定能做到。","review_flag":"JPN_DIRECT_TRANSLATION"},
    {"file_id":"BRIEFING_FILES_BLOCK_034C20","unique_index":25,"cn_text":"谢谢你，Snake。","review_flag":"JPN_DIRECT_TRANSLATION"},
    {"file_id":"BRIEFING_FILES_BLOCK_035660","unique_index":0,"cn_text":"<R=祖国,尼加拉瓜>的土地属于我们，却又不属于我们。","review_flag":"RUBY_LOCALIZED"},
    {"file_id":"BRIEFING_FILES_BLOCK_035660","unique_index":2,"cn_text":"沿海全是香蕉园，山区全是咖啡田。不过<R=这一带,哥斯达黎加>也差不多。","review_flag":"AUX_REFERENCE_INCOMPLETE_RUBY_LOCALIZED"},
    {"file_id":"BRIEFING_FILES_BLOCK_035660","unique_index":4,"cn_text":"收获的香蕉与咖啡大多用于出口，货款被地主独占，农民只能拿到一点点钱。","review_flag":"SEGMENTATION_REBUILT"},
    {"file_id":"BRIEFING_FILES_BLOCK_035660","unique_index":5,"cn_text":"更糟的是，最大的地主正是<R=蛤蟆,SOMOZA>家族。","review_flag":"RUBY_LOCALIZED"},
    {"file_id":"BRIEFING_FILES_BLOCK_035660","unique_index":11,"cn_text":"太荒唐了。我们必须夺回自己的土地，这也是我们的目标之一。","review_flag":"SEGMENTATION_REBUILT"},
    {"file_id":"BRIEFING_FILES_BLOCK_035C60","unique_index":1,"cn_text":"大约半年前。在那之前只能吃豆子，后来突然开始有人送来鸡蛋和面粉，子弹也不再短缺。","review_flag":"SEGMENTATION_REBUILT"},
    {"file_id":"BRIEFING_FILES_BLOCK_035C60","unique_index":2,"cn_text":"<R=毒品,可卡因>是怎么弄到的？","review_flag":"RUBY_LOCALIZED"},
    {"file_id":"BRIEFING_FILES_BLOCK_035C60","unique_index":4,"cn_text":"这一带也能种古柯，但原料大多应该来自哥伦比亚或玻利维亚。","review_flag":"SEGMENTATION_REBUILT"},
    {"file_id":"BRIEFING_FILES_BLOCK_035C60","unique_index":8,"cn_text":"等等。既然<R=CIA,LA CIA>也用这条路线，难道<R=CIA,LA CIA>也在向美国贩卖？","review_flag":"AUX_REFERENCE_INCOMPLETE_RUBY_LOCALIZED"},
    {"file_id":"BRIEFING_FILES_BLOCK_036310","unique_index":0,"cn_text":"<R=CIA,LA CIA>的核武器叫Peace Walker，对吧？","review_flag":"RUBY_LOCALIZED"},
    {"file_id":"BRIEFING_FILES_BLOCK_036310","unique_index":2,"cn_text":"这是在讽刺<R=尼加拉瓜人,NICO>。","review_flag":"RUBY_LOCALIZED"},
    {"file_id":"BRIEFING_FILES_BLOCK_036310","unique_index":5,"cn_text":"当时尼加拉瓜党争激烈，自由党为对抗保守党，请来了美国雇佣兵。","review_flag":"SEGMENTATION_REBUILT"},
    {"file_id":"BRIEFING_FILES_BLOCK_036310","unique_index":12,"cn_text":"美国永远如此，打着方便自己的旗号，旁若无人地践踏他国。","review_flag":"SEGMENTATION_REBUILT"},
    {"file_id":"BRIEFING_FILES_BLOCK_036310","unique_index":13,"cn_text":"还叫什么<R=和平行走计划,PEACE WALKER>。","review_flag":"RUBY_LOCALIZED"},
    {"file_id":"BRIEFING_FILES_BLOCK_036310","unique_index":16,"cn_text":"那我们就如法炮制。我们也绝不会任由Coldman为所欲为。","review_flag":"SEGMENTATION_REBUILT"},
    {"file_id":"BRIEFING_FILES_BLOCK_036C20","unique_index":0,"cn_text":"你什么时候加入<R=桑地诺民族解放阵线,FSLN>的？","review_flag":"RUBY_LOCALIZED"},
    {"file_id":"BRIEFING_FILES_BLOCK_036C20","unique_index":1,"cn_text":"大约一年前，和<R=父亲,MI VIEJO>他们一起进了山。","review_flag":"RUBY_LOCALIZED"},
    {"file_id":"BRIEFING_FILES_BLOCK_036C20","unique_index":2,"cn_text":"你父亲不是一开始就在<R=桑地诺民族解放阵线,FSLN>吗？","review_flag":"RUBY_LOCALIZED"},
    {"file_id":"BRIEFING_FILES_BLOCK_036C20","unique_index":3,"cn_text":"不是。<R=父亲,MI VIEJO>确实和Sandino将军并肩作战过，但后来一度退隐。","review_flag":"RUBY_LOCALIZED"},
    {"file_id":"BRIEFING_FILES_BLOCK_036C20","unique_index":4,"cn_text":"他找了工作、组建家庭，我们也出生了。但某天，几名<R=桑地诺民族解放阵线,FSLN>的学生找上门来……","review_flag":"SEGMENTATION_REBUILT_RUBY_LOCALIZED"},
    {"file_id":"BRIEFING_FILES_BLOCK_036C20","unique_index":6,"cn_text":"差不多。不过他也只是帮助受<R=国民警卫队,GUARDIA>追捕的那些人逃走。","review_flag":"RUBY_LOCALIZED"},
    {"file_id":"BRIEFING_FILES_BLOCK_036C20","unique_index":7,"cn_text":"可<R=警卫队,GUARDIA>随后找上门，突然闯进家里，傲慢地审问<R=父亲,MI VIEJO>。","review_flag":"AUX_REFERENCE_INCOMPLETE_RUBY_LOCALIZED"},
    {"file_id":"BRIEFING_FILES_BLOCK_036C20","unique_index":9,"cn_text":"他被狠狠打了一顿，家里也被砸得一团糟。从此他们盯上父亲，动不动就来骚扰。","review_flag":"SEGMENTATION_REBUILT"},
    {"file_id":"BRIEFING_FILES_BLOCK_036C20","unique_index":10,"cn_text":"从那以后，<R=父亲,MI VIEJO>才投身<R=桑地诺民族解放阵线,FSLN>。","review_flag":"RUBY_LOCALIZED"},
    {"file_id":"BRIEFING_FILES_BLOCK_036C20","unique_index":13,"cn_text":"嗯……可母亲先撑不住了，离开了家。也不能怪她。","review_flag":"JPN_DIRECT_TRANSLATION"},
    {"file_id":"BRIEFING_FILES_BLOCK_036C20","unique_index":15,"cn_text":"当然犹豫过。但我敬重<R=父亲,MI VIEJO>，也无法容忍Somoza的做法。而且……","review_flag":"AUX_REFERENCE_INCOMPLETE_RUBY_LOCALIZED"},
    {"file_id":"BRIEFING_FILES_BLOCK_036C20","unique_index":17,"cn_text":"……那孩子特别依恋<R=父亲,MI VIEJO>，怎么也不肯离开家，我又不能丢下他。","review_flag":"SEGMENTATION_REBUILT_RUBY_LOCALIZED"},
    {"file_id":"BRIEFING_FILES_BLOCK_036C20","unique_index":18,"cn_text":"后来被<R=国民警卫队,GUARDIA>追赶，只好进山……差不多有一半是形势所迫。","review_flag":"AUX_REFERENCE_INCOMPLETE_RUBY_LOCALIZED"},
    {"file_id":"BRIEFING_FILES_BLOCK_036C20","unique_index":20,"cn_text":"山会把人锻炼成战士，严酷训练使人成为<R=新人,HOMBRE NUEVO>。","review_flag":"AUX_REFERENCE_INCOMPLETE_RUBY_LOCALIZED"},
    {"file_id":"BRIEFING_FILES_BLOCK_036C20","unique_index":21,"cn_text":"你果然是个了不起的姐姐，难怪会被推荐为<R=指挥官,COMANDANTE>。","review_flag":"SEGMENTATION_REBUILT_RUBY_LOCALIZED"},
    {"file_id":"BRIEFING_FILES_BLOCK_0377F0","unique_index":1,"cn_text":"偏偏患上了严重的那种疟疾，意识也变得模糊，听说一度被认为没救了。","review_flag":"SEGMENTATION_REBUILT"},
    {"file_id":"BRIEFING_FILES_BLOCK_0377F0","unique_index":6,"cn_text":"是啊，希望多少能驱赶蚊子，也许只是心理安慰。你不也一样？","review_flag":"SEGMENTATION_REBUILT"},
    {"file_id":"BRIEFING_FILES_BLOCK_0377F0","unique_index":9,"cn_text":"不过你很了不起，竟能不顾那份恐惧，以游击队员身份驰骋山野。","review_flag":"SEGMENTATION_REBUILT"}
  ]
}
