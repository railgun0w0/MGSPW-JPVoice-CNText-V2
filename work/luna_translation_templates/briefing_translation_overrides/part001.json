    {"file_id":"BRIEFING_FILES_BLOCK_003FD0","unique_index":9,"cn_text":"这是核威慑的终极形态。既然知道发射后会遭到反击并自取灭亡，就没人会动用核武器。","review_flag":"JPN_DIRECT_TRANSLATION;SEGMENTATION_REBUILT"},
