{
  "packet": 7,
  "translations": [
    {"file_id":"BRIEFING_FILES_BLOCK_01DFB0","unique_index":0,"cn_text":"只要击落富尔顿回收气球就行，对吧？","review_flag":"CONTEXT_ALIGNMENT_REVIEWED"},
    {"file_id":"BRIEFING_FILES_BLOCK_01DFB0","unique_index":1,"cn_text":"对。可别误射吊在下面的士兵。","review_flag":"CONTEXT_ALIGNMENT_REVIEWED"},
    {"file_id":"BRIEFING_FILES_BLOCK_01DFB0","unique_index":2,"cn_text":"用枪射击吗？","review_flag":"CONTEXT_ALIGNMENT_REVIEWED_AUX_REFERENCE_REJECTED"},
    {"file_id":"BRIEFING_FILES_BLOCK_01DFB0","unique_index":3,"cn_text":"狙击步枪也好，其他武器也行，一定要瞄准后再开枪。","review_flag":"CONTEXT_ALIGNMENT_REVIEWED"},
    {"file_id":"BRIEFING_FILES_BLOCK_01DFB0","unique_index":4,"cn_text":"打气球啊……","review_flag":"CONTEXT_ALIGNMENT_REVIEWED"},
    {"file_id":"BRIEFING_FILES_BLOCK_01DFB0","unique_index":5,"cn_text":"天空广阔，要打下更多气球，或许可以尝试CO-OPS。","review_flag":"CONTEXT_ALIGNMENT_REVIEWED_SEGMENTATION_REBUILT"},
    {"file_id":"BRIEFING_FILES_BLOCK_01DFB0","unique_index":6,"cn_text":"总是执行杀气腾腾的任务也会让人消沉，偶尔来点这样悠闲的任务也不错吧？","review_flag":"CONTEXT_ALIGNMENT_REVIEWED_AUX_REFERENCE_INCOMPLETE"},
    {"file_id":"BRIEFING_FILES_BLOCK_01DFB0","unique_index":7,"cn_text":"富尔顿气球像猪一样，看着就很好吃……","review_flag":"CONTEXT_ALIGNMENT_REVIEWED_AUX_REFERENCE_REJECTED"},
    {"file_id":"BRIEFING_FILES_BLOCK_01DFB0","unique_index":8,"cn_text":"……先不说这个，你刚才提到的“Pooyan任务”是什么意思？","review_flag":"CONTEXT_ALIGNMENT_REVIEWED_AUX_REFERENCE_REJECTED"},
    {"file_id":"BRIEFING_FILES_BLOCK_01DFB0","unique_index":9,"cn_text":"我小时候邻居家养过一头猪，名字就叫“Pooyan”。","review_flag":"CONTEXT_ALIGNMENT_REVIEWED_AUX_REFERENCE_REJECTED"},
    {"file_id":"BRIEFING_FILES_BLOCK_01DFB0","unique_index":10,"cn_text":"每次看到富尔顿气球，我都会想起它。","review_flag":"CONTEXT_ALIGNMENT_REVIEWED_AUX_REFERENCE_REJECTED"},
    {"file_id":"BRIEFING_FILES_BLOCK_01DFB0","unique_index":11,"cn_text":"不过我们的目标是击落气球，不能对气球产生感情。","review_flag":"CONTEXT_ALIGNMENT_REVIEWED_SEGMENTATION_REBUILT"},
    {"file_id":"BRIEFING_FILES_BLOCK_01DFB0","unique_index":12,"cn_text":"是啊，要是气球下面吊着的真是猪就好了……","review_flag":"CONTEXT_ALIGNMENT_REVIEWED_AUX_REFERENCE_REJECTED"},
    {"file_id":"BRIEFING_FILES_BLOCK_01DFB0","unique_index":13,"cn_text":"……喂。","review_flag":"CONTEXT_ALIGNMENT_REVIEWED_AUX_REFERENCE_REJECTED"},
    {"file_id":"BRIEFING_FILES_BLOCK_01DFB0","unique_index":14,"cn_text":"嗯？","review_flag":"CONTEXT_ALIGNMENT_REVIEWED_AUX_REFERENCE_REJECTED"},
    {"file_id":"BRIEFING_FILES_BLOCK_01DFB0","unique_index":15,"cn_text":"没什么……","review_flag":"CONTEXT_ALIGNMENT_REVIEWED_AUX_REFERENCE_REJECTED"},
    {"file_id":"BRIEFING_FILES_BLOCK_01E6E0","unique_index":0,"cn_text":"偷走<R=装备,ITEM>的敌人会试图逃出区域。","review_flag":"RUBY_LOCALIZED"},
    {"file_id":"BRIEFING_FILES_BLOCK_01E6E0","unique_index":2,"cn_text":"已确认有多名敌兵，独自应付可能很困难。","review_flag":"SEGMENTATION_REBUILT"},
    {"file_id":"BRIEFING_FILES_BLOCK_01E6E0","unique_index":3,"cn_text":"建议在CO-OPS中组成<R=两人小组,TWO-MAN CELL>执行任务。","review_flag":"RUBY_LOCALIZED"},
    {"file_id":"BRIEFING_FILES_BLOCK_01E940","unique_index":0,"cn_text":"也可以在敌人必经之路设置阔剑地雷。","review_flag":"CONTEXT_ALIGNMENT_REVIEWED"},
    {"file_id":"BRIEFING_FILES_BLOCK_01E940","unique_index":1,"cn_text":"为了阻止核弹发射，无论如何都要保护好Boss！","review_flag":"CONTEXT_ALIGNMENT_REVIEWED_AUX_REFERENCE_INCOMPLETE"},
    {"file_id":"BRIEFING_FILES_BLOCK_01EA90","unique_index":1,"cn_text":"不过若能用狙击步枪引爆某种东西，或许也能奏效。","review_flag":"SEGMENTATION_REBUILT"},
    {"file_id":"BRIEFING_FILES_BLOCK_01ECA0","unique_index":0,"cn_text":"一枚导弹不至于击沉母基地，但一旦命中，修复自然需要时间、人手和物资。","review_flag":"CONTEXT_ALIGNMENT_REVIEWED_AUX_REFERENCE_INCOMPLETE"},
    {"file_id":"BRIEFING_FILES_BLOCK_01ECA0","unique_index":1,"cn_text":"无论如何都要守住我们的母基地。","review_flag":"CONTEXT_ALIGNMENT_REVIEWED"},
    {"file_id":"BRIEFING_FILES_BLOCK_01ECA0","unique_index":2,"cn_text":"顺带一提，要是你自己被导弹击中，基本必死无疑。务必小心。","review_flag":"CONTEXT_ALIGNMENT_REVIEWED_SEGMENTATION_REBUILT"},
    {"file_id":"BRIEFING_FILES_BLOCK_01EEB0","unique_index":0,"cn_text":"爆破要使用C4，起爆时自然会发出巨响。","review_flag":"SEGMENTATION_REBUILT"},
    {"file_id":"BRIEFING_FILES_BLOCK_01EEB0","unique_index":1,"cn_text":"设置后到起爆前，要拉开足够距离，确保自身安全。","review_flag":"SEGMENTATION_REBUILT"},
    {"file_id":"BRIEFING_FILES_BLOCK_01F030","unique_index":0,"cn_text":"目前还不清楚Boss的装备藏在哪里。","review_flag":"CONTEXT_ALIGNMENT_REVIEWED"},
    {"file_id":"BRIEFING_FILES_BLOCK_01F030","unique_index":1,"cn_text":"也可能就在敌兵身上。","review_flag":"JPN_DIRECT_TRANSLATION"},
    {"file_id":"BRIEFING_FILES_BLOCK_01F030","unique_index":2,"cn_text":"不妨利用举手投降，以及无力化后的搜身。","review_flag":"JPN_DIRECT_TRANSLATION"},
    {"file_id":"BRIEFING_FILES_BLOCK_01F030","unique_index":3,"cn_text":"要搜身，就在倒地士兵附近按<I=ACT>。","review_flag":"JPN_DIRECT_TRANSLATION_CONTROL_PRESERVED"},
    {"file_id":"BRIEFING_FILES_BLOCK_01F030","unique_index":4,"cn_text":"如果无法操作，就靠近到图标出现为止。","review_flag":"JPN_DIRECT_TRANSLATION"},
    {"file_id":"BRIEFING_FILES_BLOCK_01F440","unique_index":2,"cn_text":"他们看似悠闲地走动，但千万别被外表骗了。他们的五感都极其敏锐。","review_flag":"SEGMENTATION_REBUILT"},
    {"file_id":"BRIEFING_FILES_BLOCK_01F440","unique_index":4,"cn_text":"他们在战斗中也很难对付，穿着<R=防弹衣,BODY ARMOR>的更是难以击倒。","review_flag":"SEGMENTATION_REBUILT_RUBY_LOCALIZED"},
    {"file_id":"BRIEFING_FILES_BLOCK_01F440","unique_index":5,"cn_text":"如果还戴着防弹头盔，就无法做到<R=一击毙命,ONE SHOT ONE KILL>。务必小心。","review_flag":"AUX_REFERENCE_INCOMPLETE_RUBY_LOCALIZED"},
    {"file_id":"BRIEFING_FILES_BLOCK_01F440","unique_index":6,"cn_text":"要在伪装和路线选择上多动脑筋，首要任务是避开他们的侦测。","review_flag":"SEGMENTATION_REBUILT"},
    {"file_id":"BRIEFING_FILES_BLOCK_01F9B0","unique_index":1,"cn_text":"他们装备沉重却行动敏捷，是群危险人物。Amanda等人称其为“突击兵”。","review_flag":"SEGMENTATION_REBUILT"},
    {"file_id":"BRIEFING_FILES_BLOCK_01F9B0","unique_index":2,"cn_text":"不同于巡逻兵，他们会主动追踪并猎杀我们，如同凶猛的<R=猎犬,HOUND>。","review_flag":"RUBY_LOCALIZED"},
    {"file_id":"BRIEFING_FILES_BLOCK_01F9B0","unique_index":4,"cn_text":"即使跟丢目标也不会轻易放弃，而会对可能的藏身处展开<R=清剿,CLEARING>。","review_flag":"SEGMENTATION_REBUILT_RUBY_LOCALIZED"},
    {"file_id":"BRIEFING_FILES_BLOCK_01F9B0","unique_index":5,"cn_text":"即便以为藏好了，一旦大意也可能再次被发现。不要把视线从他们身上移开。","review_flag":"SEGMENTATION_REBUILT"},
    {"file_id":"BRIEFING_FILES_BLOCK_01FF10","unique_index":0,"cn_text":"突击兵中尤其棘手的，是那些携带霰弹枪的家伙。","review_flag":"CONTEXT_ALIGNMENT_REVIEWED_SEGMENTATION_REBUILT"},
    {"file_id":"BRIEFING_FILES_BLOCK_01FF10","unique_index":1,"cn_text":"他们挨上几枪也毫不在意，仍会继续冲锋。","review_flag":"CONTEXT_ALIGNMENT_REVIEWED"},
    {"file_id":"BRIEFING_FILES_BLOCK_01FF10","unique_index":2,"cn_text":"一旦让他们进入霰弹枪射程，我们也会吃不了兜着走。","review_flag":"CONTEXT_ALIGNMENT_REVIEWED"},
    {"file_id":"BRIEFING_FILES_BLOCK_01FF10","unique_index":3,"cn_text":"必须尽早用高威力武器阻止他们冲锋。","review_flag":"CONTEXT_ALIGNMENT_REVIEWED_SEGMENTATION_REBUILT"},
    {"file_id":"BRIEFING_FILES_BLOCK_020160","unique_index":1,"cn_text":"据说他们被称作“<R=侦察兵,SCOUT>”。","review_flag":"RUBY_LOCALIZED"},
    {"file_id":"BRIEFING_FILES_BLOCK_020160","unique_index":3,"cn_text":"战斗方式接近突击兵，会对藏身处展开<R=清剿,CLEARING>。","review_flag":"AUX_REFERENCE_INCOMPLETE_RUBY_LOCALIZED"},
    {"file_id":"BRIEFING_FILES_BLOCK_0205A0","unique_index":0,"cn_text":"<R=侦察兵,SCOUT>会用伪装隐蔽，其中最奇怪的是看起来全身长满海草的家伙。","review_flag":"SEGMENTATION_REBUILT_RUBY_LOCALIZED"},
    {"file_id":"BRIEFING_FILES_BLOCK_0205A0","unique_index":2,"cn_text":"战斗能力与其他<R=侦察兵,SCOUT>似乎相差不大，但极难发现。","review_flag":"AUX_REFERENCE_INCOMPLETE_RUBY_LOCALIZED"},
    {"file_id":"BRIEFING_FILES_BLOCK_0205A0","unique_index":5,"cn_text":"在苏联。第一次花了整整一小时才将其击倒……Kaz，那些家伙会发光吗？","review_flag":"SEGMENTATION_REBUILT"},
    {"file_id":"BRIEFING_FILES_BLOCK_0205A0","unique_index":12,"cn_text":"鹦鹉？喂，你问错人了，鸟类应该问Cecile……不对，你从刚才起到底在说什么？","review_flag":"SEGMENTATION_REBUILT"},
    {"file_id":"BRIEFING_FILES_BLOCK_0205A0","unique_index":14,"cn_text":"……？算了。总之已经有不少同伴倒在他们的伏击下。","review_flag":"SEGMENTATION_REBUILT"},
    {"file_id":"BRIEFING_FILES_BLOCK_020C50","unique_index":0,"cn_text":"视地点而定，敌人会进行多层兵力部署。","review_flag":"SEGMENTATION_REBUILT"},
    {"file_id":"BRIEFING_FILES_BLOCK_020C50","unique_index":1,"cn_text":"不少敌人会从屋顶或远处地形发动远程攻击。","review_flag":"SEGMENTATION_REBUILT"},
    {"file_id":"BRIEFING_FILES_BLOCK_020C50","unique_index":2,"cn_text":"别只顾附近的敌人，反而毫无防备地暴露在远程攻击下。","review_flag":"SEGMENTATION_REBUILT"},
    {"file_id":"BRIEFING_FILES_BLOCK_020E90","unique_index":0,"cn_text":"敌军坦克、装甲车和攻击直升机，始终会有一个战斗班伴随。","review_flag":"SEGMENTATION_REBUILT"},
    {"file_id":"BRIEFING_FILES_BLOCK_020E90","unique_index":3,"cn_text":"真打起来，你可就没法说得这么轻松了。","review_flag":"AUX_REFERENCE_REJECTED_SEGMENTATION_REBUILT"},
    {"file_id":"BRIEFING_FILES_BLOCK_020E90","unique_index":4,"cn_text":"听好，别让他们包围你。被赶进敌方机器的杀伤区可就惨了。","review_flag":"AUX_REFERENCE_INCOMPLETE_SEGMENTATION_REBUILT"},
    {"file_id":"BRIEFING_FILES_BLOCK_020E90","unique_index":6,"cn_text":"只会正面硬碰硬不算本事，别忘了游击队的战法。","review_flag":"AUX_REFERENCE_REJECTED_SEGMENTATION_REBUILT"},
    {"file_id":"BRIEFING_FILES_BLOCK_021330","unique_index":1,"cn_text":"对付那些躲在盾牌后用手枪攻击的家伙，按Amanda的话说就是“非常！让人火大”。","review_flag":"SEGMENTATION_REBUILT"},
    {"file_id":"BRIEFING_FILES_BLOCK_021620","unique_index":2,"cn_text":"他们大概是战斗技巧很高的士兵，所以才能身负重装仍保持高水平表现。","review_flag":"SEGMENTATION_REBUILT"},
    {"file_id":"BRIEFING_FILES_BLOCK_021AE0","unique_index":0,"cn_text":"携带手枪和霰弹枪的敌人会逼得相当近。虽说危险，但反过来我们也更容易瞄准。","review_flag":"JPN_DIRECT_TRANSLATION"},
    {"file_id":"BRIEFING_FILES_BLOCK_021AE0","unique_index":1,"cn_text":"随机应变，把劣势变成优势。","review_flag":"JPN_DIRECT_TRANSLATION"},
    {"file_id":"BRIEFING_FILES_BLOCK_021C70","unique_index":0,"cn_text":"装备突击步枪或机枪的敌人，大多会保持一定距离射击。","review_flag":"JPN_DIRECT_TRANSLATION"},
    {"file_id":"BRIEFING_FILES_BLOCK_021C70","unique_index":1,"cn_text":"善用掩体挡住敌弹，同时确保射出的子弹准确命中。","review_flag":"JPN_DIRECT_TRANSLATION"},
    {"file_id":"BRIEFING_FILES_BLOCK_021E00","unique_index":0,"cn_text":"携带狙击步枪或火箭弹类大型发射器的敌人，基本不会主动靠近。","review_flag":"JPN_DIRECT_TRANSLATION"},
    {"file_id":"BRIEFING_FILES_BLOCK_021E00","unique_index":1,"cn_text":"他们会不断转移位置，趁我们露出破绽时狙击。","review_flag":"JPN_DIRECT_TRANSLATION"},
    {"file_id":"BRIEFING_FILES_BLOCK_021E00","unique_index":2,"cn_text":"以眼还眼，以牙还牙。用狙击步枪对付他们，注意别随便暴露自己，反过来打他们一个措手不及。","review_flag":"JPN_DIRECT_TRANSLATION"},
    {"file_id":"BRIEFING_FILES_BLOCK_022090","unique_index":3,"cn_text":"他的日记写道，当时从<R=原住民,INDÍGENA>那里收到了许多黄金工艺品，或许名字就由此而来。","review_flag":"AUX_REFERENCE_INCOMPLETE_RUBY_LOCALIZED"},
    {"file_id":"BRIEFING_FILES_BLOCK_022090","unique_index":4,"cn_text":"真奇怪，哥斯达黎加明明产不了那么多黄金。","review_flag":"SEGMENTATION_REBUILT"},
    {"file_id":"BRIEFING_FILES_BLOCK_022090","unique_index":5,"cn_text":"他们本就是为寻找<R=黄金之国,ZIPANG>而出海，对黄金自然格外执着。","review_flag":"AUX_REFERENCE_INCOMPLETE_RUBY_LOCALIZED"},
    {"file_id":"BRIEFING_FILES_BLOCK_0224E0","unique_index":8,"cn_text":"即使过去四分之一个世纪，对<R=哥斯达黎加人,TICO>来说仍无法忘记……不，是绝不能忘记。","review_flag":"RUBY_LOCALIZED"},
    {"file_id":"BRIEFING_FILES_BLOCK_022D50","unique_index":1,"cn_text":"不，我还是高中生。不过经常去打扰Gálvez教授，在他的研究室学习。","review_flag":"SEGMENTATION_REBUILT"},
    {"file_id":"BRIEFING_FILES_BLOCK_023240","unique_index":4,"cn_text":"他们会编造完美的掩护身份潜伏下来，身份、工作，有时甚至连家人都会准备好。","review_flag":"SEGMENTATION_REBUILT"},
    {"file_id":"BRIEFING_FILES_BLOCK_023240","unique_index":9,"cn_text":"对不起。我不知道该不该告诉你，也不想把你卷进无关的事情。","review_flag":"JPN_DIRECT_TRANSLATION"},
    {"file_id":"BRIEFING_FILES_BLOCK_023F00","unique_index":1,"cn_text":"Cartago以东有座Guayabo遗址，不过规模不算大。","review_flag":"SEGMENTATION_REBUILT"},
    {"file_id":"BRIEFING_FILES_BLOCK_023F00","unique_index":3,"cn_text":"越过边境进入尼加拉瓜不远，有座康塞普西翁要塞，出名的大概只有那里。","review_flag":"SEGMENTATION_REBUILT"},
    {"file_id":"BRIEFING_FILES_BLOCK_024290","unique_index":4,"cn_text":"可以这么说。不过自这部宪法制定以来，哥斯达黎加从未组建过军队。","review_flag":"SEGMENTATION_REBUILT"}
  ]
}
