{
  "packet": 6,
  "translations": [
    {"file_id":"BRIEFING_FILES_BLOCK_019D90","unique_index":0,"cn_text":"Snake，我们研发班又开发出了一款新碳酸饮料。","review_flag":"JPN_DIRECT_TRANSLATION"},
    {"file_id":"BRIEFING_FILES_BLOCK_019D90","unique_index":1,"cn_text":"不了不了，已经够了。马黛茶和Mountain Dew我都喝得很满足。","review_flag":"JPN_DIRECT_TRANSLATION"},
    {"file_id":"BRIEFING_FILES_BLOCK_019D90","unique_index":2,"cn_text":"是吗？可这款也相当不错，一喝就再也放不下。实话告诉你，我到现在还没放下。","review_flag":"JPN_DIRECT_TRANSLATION"},
    {"file_id":"BRIEFING_FILES_BLOCK_019D90","unique_index":3,"cn_text":"喂，认真点……","review_flag":"JPN_DIRECT_TRANSLATION"},
    {"file_id":"BRIEFING_FILES_BLOCK_019D90","unique_index":4,"cn_text":"Kaz！","review_flag":"JPN_DIRECT_TRANSLATION"},
    {"file_id":"BRIEFING_FILES_BLOCK_019D90","unique_index":5,"cn_text":"口感醇厚却又利落清爽……太好喝了。","review_flag":"JPN_DIRECT_TRANSLATION"},
    {"file_id":"BRIEFING_FILES_BLOCK_019D90","unique_index":6,"cn_text":"……再好喝，喝多了热量也会……","review_flag":"JPN_DIRECT_TRANSLATION"},
    {"file_id":"BRIEFING_FILES_BLOCK_019D90","unique_index":7,"cn_text":"而且零卡路里。","review_flag":"JPN_DIRECT_TRANSLATION"},
    {"file_id":"BRIEFING_FILES_BLOCK_019D90","unique_index":8,"cn_text":"零……？简直不敢相信！","review_flag":"JPN_DIRECT_TRANSLATION"},
    {"file_id":"BRIEFING_FILES_BLOCK_019D90","unique_index":9,"cn_text":"这么带劲，竟然零卡路里！","review_flag":"JPN_DIRECT_TRANSLATION"},
    {"file_id":"BRIEFING_FILES_BLOCK_019D90","unique_index":10,"cn_text":"等喝过再怀疑自己的耳朵吧，到时候其他饮料都替代不了它。","review_flag":"JPN_DIRECT_TRANSLATION"},
    {"file_id":"BRIEFING_FILES_BLOCK_019D90","unique_index":11,"cn_text":"没错。迟早有一天，全世界的时尚男女都会对它爱不释手。","review_flag":"JPN_DIRECT_TRANSLATION"},
    {"file_id":"BRIEFING_FILES_BLOCK_019D90","unique_index":12,"cn_text":"向往会催生更多向往，最终化为席卷全人类的巨大旋涡。","review_flag":"JPN_DIRECT_TRANSLATION"},
    {"file_id":"BRIEFING_FILES_BLOCK_019D90","unique_index":13,"cn_text":"Snake，不，Boss，你将成为旋涡的中心。带我们抢先进入那个时代吧！","review_flag":"JPN_DIRECT_TRANSLATION"},
    {"file_id":"BRIEFING_FILES_BLOCK_019D90","unique_index":14,"cn_text":"明明不是你做的，口气倒挺大……它……叫什么？","review_flag":"JPN_DIRECT_TRANSLATION"},
    {"file_id":"BRIEFING_FILES_BLOCK_019D90","unique_index":15,"cn_text":"嗯？","review_flag":"JPN_DIRECT_TRANSLATION"},
    {"file_id":"BRIEFING_FILES_BLOCK_019D90","unique_index":16,"cn_text":"那款碳酸饮料的名字。","review_flag":"JPN_DIRECT_TRANSLATION"},
    {"file_id":"BRIEFING_FILES_BLOCK_019D90","unique_index":17,"cn_text":"它叫……","review_flag":"JPN_DIRECT_TRANSLATION"},
    {"file_id":"BRIEFING_FILES_BLOCK_019D90","unique_index":18,"cn_text":"Pepsi NEX。","review_flag":"JPN_DIRECT_TRANSLATION"},
    {"file_id":"BRIEFING_FILES_BLOCK_019D90","unique_index":19,"cn_text":"Pepsi……NEX……","review_flag":"JPN_DIRECT_TRANSLATION"},
    {"file_id":"BRIEFING_FILES_BLOCK_019D90","unique_index":20,"cn_text":"Pepsi NEX！！","review_flag":"JPN_DIRECT_TRANSLATION"},
    {"file_id":"BRIEFING_FILES_BLOCK_01A5B0","unique_index":0,"cn_text":"从地图来看，通往关押<R=桑地诺民族解放阵线,FSLN>指挥官的小屋，沿途地形相当多变。","review_flag":"RUBY_LOCALIZED"},
    {"file_id":"BRIEFING_FILES_BLOCK_01A5B0","unique_index":2,"cn_text":"这里适合避开敌人视线前进，但我们也同样不容易发现敌人，务必小心。","review_flag":"SEGMENTATION_REBUILT"},
    {"file_id":"BRIEFING_FILES_BLOCK_01A5B0","unique_index":3,"cn_text":"接下来是河边沼泽。先仔细判断警戒部署有多严密，再继续前进。","review_flag":"SEGMENTATION_REBUILT"},
    {"file_id":"BRIEFING_FILES_BLOCK_01A5B0","unique_index":6,"cn_text":"前路还很长，务必谨慎，别弄出太大动静。","review_flag":"SEGMENTATION_REBUILT"},
    {"file_id":"BRIEFING_FILES_BLOCK_01A9F0","unique_index":0,"cn_text":"前往下一个目的地，途中有一段需要沿原路折返。","review_flag":"SEGMENTATION_REBUILT"},
    {"file_id":"BRIEFING_FILES_BLOCK_01A9F0","unique_index":1,"cn_text":"别因为熟悉地形就大意。敌人已经知道你的存在，警戒一定比之前更严。","review_flag":"SEGMENTATION_REBUILT"},
    {"file_id":"BRIEFING_FILES_BLOCK_01A9F0","unique_index":4,"cn_text":"对，有座吊桥。这里仅此一条路，要避开敌人视线得想点办法。","review_flag":"SEGMENTATION_REBUILT"},
    {"file_id":"BRIEFING_FILES_BLOCK_01A9F0","unique_index":5,"cn_text":"穿过吊桥和沼泽以后……就是香蕉园吗？","review_flag":"SEGMENTATION_REBUILT"},
    {"file_id":"BRIEFING_FILES_BLOCK_01A9F0","unique_index":9,"cn_text":"另外，途中可能会发现<R=桑地诺民族解放阵线,FSLN>的俘虏，尽量用富尔顿系统把他们回收回来。","review_flag":"AUX_REFERENCE_INCOMPLETE_RUBY_LOCALIZED"},
    {"file_id":"BRIEFING_FILES_BLOCK_01AF20","unique_index":0,"cn_text":"要摧毁村庄北面的路障，需要<R=C4,COMPOSITION 4>炸药。Snake，你应该很熟悉它的用法吧？","review_flag":"AUX_REFERENCE_INCOMPLETE_RUBY_LOCALIZED"},
    {"file_id":"BRIEFING_FILES_BLOCK_01AF20","unique_index":2,"cn_text":"C3啊。记得它在寒冷地区会变脆，所以才换成了C4。","review_flag":"SEGMENTATION_REBUILT"},
    {"file_id":"BRIEFING_FILES_BLOCK_01AF20","unique_index":3,"cn_text":"可以任意塑形的塑胶炸药，稳定性很高，没有起爆装置就不会爆炸，就算点火也只会正常燃烧……","review_flag":"SEGMENTATION_REBUILT"},
    {"file_id":"BRIEFING_FILES_BLOCK_01B330","unique_index":0,"cn_text":"C4炸弹已经开发完成。在ENTRY GATE装备后，就能带去执行任务。","review_flag":"JPN_DIRECT_TRANSLATION"},
    {"file_id":"BRIEFING_FILES_BLOCK_01B330","unique_index":1,"cn_text":"帮大忙了。","review_flag":"JPN_DIRECT_TRANSLATION"},
    {"file_id":"BRIEFING_FILES_BLOCK_01B330","unique_index":2,"cn_text":"要设置C4炸弹，首先得装备它。请从武器选择菜单中选择C4。","review_flag":"CONTEXT_ALIGNMENT_REVIEWED_AUX_REFERENCE_REJECTED"},
    {"file_id":"BRIEFING_FILES_BLOCK_01B330","unique_index":3,"cn_text":"装备后按住<I=AIM>，再按<I=ATK>，即可设置C4。","review_flag":"JPN_DIRECT_TRANSLATION_CONTROL_PRESERVED"},
    {"file_id":"BRIEFING_FILES_BLOCK_01B330","unique_index":4,"cn_text":"怎么起爆？","review_flag":"JPN_DIRECT_TRANSLATION"},
    {"file_id":"BRIEFING_FILES_BLOCK_01B330","unique_index":5,"cn_text":"不要按<I=AIM>，直接按<I=ATK>。听好，是不按<I=AIM>，当然仍要装备着C4。","review_flag":"JPN_DIRECT_TRANSLATION_CONTROL_PRESERVED"},
    {"file_id":"BRIEFING_FILES_BLOCK_01B330","unique_index":6,"cn_text":"因为按住<I=AIM>的话，只会在原地再设置一枚C4。","review_flag":"JPN_DIRECT_TRANSLATION_CONTROL_PRESERVED"},
    {"file_id":"BRIEFING_FILES_BLOCK_01B330","unique_index":7,"cn_text":"我会注意。","review_flag":"JPN_DIRECT_TRANSLATION"},
    {"file_id":"BRIEFING_FILES_BLOCK_01B330","unique_index":8,"cn_text":"换言之，可以设置多枚C4，并按设置顺序依次起爆。好好利用这一点。","review_flag":"JPN_DIRECT_TRANSLATION"},
    {"file_id":"BRIEFING_FILES_BLOCK_01B330","unique_index":9,"cn_text":"明白。","review_flag":"JPN_DIRECT_TRANSLATION"},
    {"file_id":"BRIEFING_FILES_BLOCK_01B7E0","unique_index":0,"cn_text":"<R=列车车库,TERMINAL>附近的巨大脚印……Kaz，你觉得是什么？","review_flag":"RUBY_LOCALIZED"},
    {"file_id":"BRIEFING_FILES_BLOCK_01B7E0","unique_index":1,"cn_text":"不知道……连大象也没那么大。让我想起了Chico提过的<R=蛇怪,BASILISCO>。","review_flag":"SEGMENTATION_REBUILT_RUBY_LOCALIZED"},
    {"file_id":"BRIEFING_FILES_BLOCK_01B7E0","unique_index":3,"cn_text":"我也不愿相信。可如果他们真有那种武器……像<R=蛇怪,BASILISCO>的或许不只是外形。","review_flag":"SEGMENTATION_REBUILT_RUBY_LOCALIZED"},
    {"file_id":"BRIEFING_FILES_BLOCK_01BF70","unique_index":0,"cn_text":"那座基地的警备，比Amanda同志提供的情报还要严密……","review_flag":"CONTEXT_ALIGNMENT_REVIEWED"},
    {"file_id":"BRIEFING_FILES_BLOCK_01BF70","unique_index":1,"cn_text":"确实。轻装恐怕很难突破。","review_flag":"CONTEXT_ALIGNMENT_REVIEWED"},
    {"file_id":"BRIEFING_FILES_BLOCK_01BF70","unique_index":2,"cn_text":"最好也做好凭借火力强行突破的准备。","review_flag":"CONTEXT_ALIGNMENT_REVIEWED"},
    {"file_id":"BRIEFING_FILES_BLOCK_01BF70","unique_index":3,"cn_text":"武器装备应该尽量多带，防御力也越高越好。","review_flag":"CONTEXT_ALIGNMENT_REVIEWED"},
    {"file_id":"BRIEFING_FILES_BLOCK_01BF70","unique_index":4,"cn_text":"明白，选择作战服时我会注意。","review_flag":"CONTEXT_ALIGNMENT_REVIEWED"},
    {"file_id":"BRIEFING_FILES_BLOCK_01BF70","unique_index":5,"cn_text":"Snake，我很快也会与你会合，再坚持一会儿。","review_flag":"CONTEXT_ALIGNMENT_REVIEWED"},
    {"file_id":"BRIEFING_FILES_BLOCK_01BF70","unique_index":6,"cn_text":"好。","review_flag":"CONTEXT_ALIGNMENT_REVIEWED"},
    {"file_id":"BRIEFING_FILES_BLOCK_01C530","unique_index":0,"cn_text":"那里的敌兵已经清除，现在应该空无一人。","review_flag":"CONTEXT_ALIGNMENT_REVIEWED"},
    {"file_id":"BRIEFING_FILES_BLOCK_01C530","unique_index":1,"cn_text":"你只需集中精力射击标靶。","review_flag":"CONTEXT_ALIGNMENT_REVIEWED"},
    {"file_id":"BRIEFING_FILES_BLOCK_01C530","unique_index":2,"cn_text":"那里适合练习远距离射击，可以考虑带一把狙击步枪。","review_flag":"CONTEXT_ALIGNMENT_REVIEWED"},
    {"file_id":"BRIEFING_FILES_BLOCK_01C530","unique_index":3,"cn_text":"当然，特意用手枪磨炼枪法也未尝不可。","review_flag":"CONTEXT_ALIGNMENT_REVIEWED_SEGMENTATION_REBUILT"},
    {"file_id":"BRIEFING_FILES_BLOCK_01C7A0","unique_index":0,"cn_text":"战俘营已经由我们控制，里面没有敌人了。","review_flag":"SEGMENTATION_REBUILT"},
    {"file_id":"BRIEFING_FILES_BLOCK_01C940","unique_index":0,"cn_text":"那里没有发现敌兵，你应该能专心训练。","review_flag":"CONTEXT_ALIGNMENT_REVIEWED"},
    {"file_id":"BRIEFING_FILES_BLOCK_01C940","unique_index":1,"cn_text":"有些标靶可能藏在不易发现的位置，仔细寻找。","review_flag":"CONTEXT_ALIGNMENT_REVIEWED_SEGMENTATION_REBUILT"},
    {"file_id":"BRIEFING_FILES_BLOCK_01C940","unique_index":2,"cn_text":"距离属于中程，使用你喜欢的武器即可。","review_flag":"CONTEXT_ALIGNMENT_REVIEWED"},
    {"file_id":"BRIEFING_FILES_BLOCK_01C940","unique_index":3,"cn_text":"要迅速而准确地瞄准标靶。","review_flag":"CONTEXT_ALIGNMENT_REVIEWED_AUX_REFERENCE_REJECTED"},
    {"file_id":"BRIEFING_FILES_BLOCK_01CB60","unique_index":0,"cn_text":"营房里的敌兵已经清除，尽情射击标靶吧。","review_flag":"SEGMENTATION_REBUILT"},
    {"file_id":"BRIEFING_FILES_BLOCK_01CDB0","unique_index":3,"cn_text":"为免误杀俘虏，最好也带上麻醉枪。","review_flag":"SEGMENTATION_REBUILT"},
    {"file_id":"BRIEFING_FILES_BLOCK_01CFF0","unique_index":0,"cn_text":"这是歼灭任务，不是潜入任务。","review_flag":"CONTEXT_ALIGNMENT_REVIEWED"},
    {"file_id":"BRIEFING_FILES_BLOCK_01CFF0","unique_index":1,"cn_text":"战斗无法避免，想靠躲藏蒙混过关也没用。","review_flag":"CONTEXT_ALIGNMENT_REVIEWED_SEGMENTATION_REBUILT"},
    {"file_id":"BRIEFING_FILES_BLOCK_01CFF0","unique_index":2,"cn_text":"比起迷彩率高的装备，应当优先考虑防御力。","review_flag":"CONTEXT_ALIGNMENT_REVIEWED"},
    {"file_id":"BRIEFING_FILES_BLOCK_01CFF0","unique_index":3,"cn_text":"当然，也需要携带足够的武器。","review_flag":"CONTEXT_ALIGNMENT_REVIEWED"},
    {"file_id":"BRIEFING_FILES_BLOCK_01CFF0","unique_index":4,"cn_text":"也别忘了恢复道具！","review_flag":"CONTEXT_ALIGNMENT_REVIEWED"},
    {"file_id":"BRIEFING_FILES_BLOCK_01D250","unique_index":0,"cn_text":"要让敌兵<R=投降,HOLD UP>，就从后方缓慢接近。","review_flag":"SEGMENTATION_REBUILT_RUBY_LOCALIZED"},
    {"file_id":"BRIEFING_FILES_BLOCK_01D250","unique_index":2,"cn_text":"不过就算成功让敌人<R=投降,HOLD UP>，自己若被其他敌人攻击也毫无意义。","review_flag":"RUBY_LOCALIZED"},
    {"file_id":"BRIEFING_FILES_BLOCK_01D250","unique_index":3,"cn_text":"找准士兵落单的时机。","review_flag":"SEGMENTATION_REBUILT"},
    {"file_id":"BRIEFING_FILES_BLOCK_01D580","unique_index":0,"cn_text":"真正的<R=老兵,VETERAN>，能用一颗子弹消灭多个敌人。","review_flag":"RUBY_LOCALIZED"},
    {"file_id":"BRIEFING_FILES_BLOCK_01D580","unique_index":2,"cn_text":"装着汽油的油桶、载有燃料的无人武器……","review_flag":"SEGMENTATION_REBUILT"},
    {"file_id":"BRIEFING_FILES_BLOCK_01D7E0","unique_index":0,"cn_text":"这是<R=狙击,SNIPING>任务，别忘了带狙击步枪。","review_flag":"RUBY_LOCALIZED"},
    {"file_id":"BRIEFING_FILES_BLOCK_01D7E0","unique_index":2,"cn_text":"可用<I=ZOOMIN>和<I=ZOOMOUT>调整瞄准镜倍率。","review_flag":"CONTROL_PRESERVED"},
    {"file_id":"BRIEFING_FILES_BLOCK_01D7E0","unique_index":5,"cn_text":"瞄准远距离目标时，轻微手抖都会让准星产生很大偏移。","review_flag":"SEGMENTATION_REBUILT"},
    {"file_id":"BRIEFING_FILES_BLOCK_01DC10","unique_index":4,"cn_text":"藏在掩体后用<I=ESEARCH>探查对方动静也很有效。","review_flag":"AUX_REFERENCE_INCOMPLETE_CONTROL_PRESERVED"}
  ]
}
