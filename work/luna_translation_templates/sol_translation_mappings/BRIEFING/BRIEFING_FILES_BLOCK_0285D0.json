{"file_id":"BRIEFING_FILES_BLOCK_0285D0","resource_class":"BRIEFING_NBE","status":"TRANSLATED_PENDING_CSV_MERGE","translations":[{"unique_index":0,"cn_text":"Snake，有件事想拜托你。","cn_control_tokens":"","cn_utf8_bytes":32,"review_flag":""},{"unique_index":1,"cn_text":"什么事。","cn_control_tokens":"","cn_utf8_bytes":12,"review_flag":""},{"unique_index":2,"cn_text":"我也想帮忙做些母基地的工作。我想帮上大家的忙。","cn_control_tokens":"","cn_utf8_bytes":69,"review_flag":"JPN_MOTHER_BASE_DETAIL_RESTORED"},{"unique_index":3,"cn_text":"可以吗？刚发生了那种事。你还是先休息，等心情平复下来再说吧。","cn_control_tokens":"","cn_utf8_bytes":90,"review_flag":"JPN_TONE_PRIMARY"},{"unique_index":4,"cn_text":"谢谢。不过我想按自己的方式，做些力所能及的事。","cn_control_tokens":"","cn_utf8_bytes":69,"review_flag":"AUX_GUN_CONTENT_MOVED_TO_NEXT_ROW_PER_JPN"},{"unique_index":5,"cn_text":"我可能没法拿枪，但做饭我很拿手。","cn_control_tokens":"","cn_utf8_bytes":48,"review_flag":"JPN_GUN_AND_COOKING_STRUCTURE_RESTORED"},{"unique_index":6,"cn_text":"那可真让人放心。","cn_control_tokens":"","cn_utf8_bytes":24,"review_flag":"JPN_REASSURING_TONE_PRIMARY"},{"unique_index":7,"cn_text":"如果把我分到伙食班，我想我会努力的。等习惯以后，我还想把哥斯达黎加料理加进食谱里。","cn_control_tokens":"","cn_utf8_bytes":123,"review_flag":"AUX_SPLIT_REJOINED_PER_JPN"},{"unique_index":8,"cn_text":"那就拜托你了。","cn_control_tokens":"","cn_utf8_bytes":21,"review_flag":"JPN_REQUEST_PRIMARY"}]}