{"file_id":"BRIEFING_FILES_BLOCK_014600","resource_class":"BRIEFING_NBE","status":"TRANSLATED_PENDING_CSV_MERGE","translations":[{"unique_index":0,"cn_text":"说起来，作战行动中排成一列前进，叫作Snake Formation吧。","cn_control_tokens":"","cn_utf8_bytes":75,"review_flag":""},{"unique_index":1,"cn_text":"虽然和你的代号一样，但对擅长单独潜入的你来说，以前应该不怎么熟悉。","cn_control_tokens":"","cn_utf8_bytes":99,"review_flag":"AUX_EXPANSION_IGNORED"},{"unique_index":2,"cn_text":"是啊。Snake一个就够了。","cn_control_tokens":"","cn_utf8_bytes":32,"review_flag":"AUX_FORMATION_EXPANSION_IGNORED"},{"unique_index":3,"cn_text":"不过在CO-OPS里，这也是有效的队形。把手搭在对方肩上，就是进入Snake Formation的信号。","cn_control_tokens":"","cn_utf8_bytes":114,"review_flag":""},{"unique_index":4,"cn_text":"首先得靠近到手能碰到对方的距离，不然也谈不上排成一列。","cn_control_tokens":"","cn_utf8_bytes":81,"review_flag":""},{"unique_index":5,"cn_text":"就把进入Snake Formation叫作Snake In吧。","cn_control_tokens":"","cn_utf8_bytes":47,"review_flag":""},{"unique_index":6,"cn_text":"Snake In期间，移动就交给前面的士兵。","cn_control_tokens":"","cn_utf8_bytes":50,"review_flag":""},{"unique_index":7,"cn_text":"这样一来，后面的士兵应该就能专心搜索敌人和攻击。","cn_control_tokens":"","cn_utf8_bytes":72,"review_flag":""}]}