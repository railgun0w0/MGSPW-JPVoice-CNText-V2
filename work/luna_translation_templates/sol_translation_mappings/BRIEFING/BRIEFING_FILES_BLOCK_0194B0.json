{"file_id":"BRIEFING_FILES_BLOCK_0194B0","resource_class":"BRIEFING_NBE","status":"TRANSLATED_PENDING_CSV_MERGE","translations":[{"unique_index":0,"cn_text":"Snake，你喜欢玉米饼吗？","cn_control_tokens":"","cn_utf8_bytes":32,"review_flag":"NO_RELIABLE_AUX_REFERENCE; JPN_ONLY"},{"unique_index":1,"cn_text":"怎么突然说这个？","cn_control_tokens":"","cn_utf8_bytes":24,"review_flag":"NO_RELIABLE_AUX_REFERENCE; JPN_ONLY"},{"unique_index":2,"cn_text":"这是中美洲代表性的料理之一，用玉米粉做成。我在美国时就很喜欢吃。","cn_control_tokens":"","cn_utf8_bytes":96,"review_flag":"NO_RELIABLE_AUX_REFERENCE; JPN_ONLY"},{"unique_index":3,"cn_text":"这个我知道。","cn_control_tokens":"","cn_utf8_bytes":18,"review_flag":"NO_RELIABLE_AUX_REFERENCE; JPN_ONLY"},{"unique_index":4,"cn_text":"要是什么时候都能享受到那股焦香味……你不这么想吗，Snake？","cn_control_tokens":"","cn_utf8_bytes":83,"review_flag":"NO_RELIABLE_AUX_REFERENCE; JPN_ONLY"},{"unique_index":5,"cn_text":"任务中不可能吧。也不耐保存。","cn_control_tokens":"","cn_utf8_bytes":42,"review_flag":"NO_RELIABLE_AUX_REFERENCE; JPN_ONLY"},{"unique_index":6,"cn_text":"别这么快放弃。研发班开发出了可以长期保存的玉米片。把玉米饼切成三角形，再用油炸制而成。","cn_control_tokens":"","cn_utf8_bytes":129,"review_flag":"NO_RELIABLE_AUX_REFERENCE; JPN_ONLY"},{"unique_index":7,"cn_text":"我们决定把它叫作『Doritos』。","cn_control_tokens":"","cn_utf8_bytes":40,"review_flag":"NO_RELIABLE_AUX_REFERENCE; JPN_ONLY; PROPER_NAME_PRESERVED"},{"unique_index":8,"cn_text":"Doritos？","cn_control_tokens":"","cn_utf8_bytes":10,"review_flag":"NO_RELIABLE_AUX_REFERENCE; JPN_ONLY; PROPER_NAME_PRESERVED"},{"unique_index":9,"cn_text":"在西班牙语里是“小金块”的意思。因为炸出来是漂亮的金黄色。","cn_control_tokens":"","cn_utf8_bytes":87,"review_flag":"NO_RELIABLE_AUX_REFERENCE; JPN_ONLY"}]}