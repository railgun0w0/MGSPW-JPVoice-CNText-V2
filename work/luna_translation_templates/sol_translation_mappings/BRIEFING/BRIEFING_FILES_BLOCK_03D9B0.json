{"file_id":"BRIEFING_FILES_BLOCK_03D9B0","resource_class":"BRIEFING_NBE","status":"TRANSLATED_PENDING_CSV_MERGE","translations":[{"unique_index":0,"cn_text":"那家伙叫El Escarabajo。在这边的话里就是“甲虫”的意思。","cn_control_tokens":"","cn_utf8_bytes":76,"review_flag":""},{"unique_index":1,"cn_text":"不过，就连我们也不太清楚El Escarabajo的弱点。","cn_control_tokens":"","cn_utf8_bytes":61,"review_flag":""},{"unique_index":2,"cn_text":"那可麻烦了。","cn_control_tokens":"","cn_utf8_bytes":18,"review_flag":""},{"unique_index":3,"cn_text":"要不要去问问那个科学家……叫Huey来着？","cn_control_tokens":"","cn_utf8_bytes":55,"review_flag":""},{"unique_index":4,"cn_text":"只是一般来说……导弹类武器发射一次后，应该需要时间重新装填……。","cn_control_tokens":"","cn_utf8_bytes":96,"review_flag":""},{"unique_index":5,"cn_text":"另外，我想要驱动那么庞大的机体，就必须进行相应的散热。","cn_control_tokens":"","cn_utf8_bytes":81,"review_flag":""},{"unique_index":6,"cn_text":"也许先封住对方的武器也是个办法……。","cn_control_tokens":"","cn_utf8_bytes":54,"review_flag":""},{"unique_index":7,"cn_text":"抱歉，我可能没帮上什么忙。","cn_control_tokens":"","cn_utf8_bytes":39,"review_flag":""},{"unique_index":8,"cn_text":"不，这些已经算是线索了。","cn_control_tokens":"","cn_utf8_bytes":36,"review_flag":""}]}