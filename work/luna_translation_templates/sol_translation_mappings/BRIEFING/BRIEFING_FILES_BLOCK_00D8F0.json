  "translations": [
    {
      "unique_index": 0,
      "cn_text": "Kaz，你以前所在的自卫队，和军队有什么不同？",
      "cn_control_tokens": "",
      "cn_utf8_bytes": 63,
      "review_flag": ""
    },
    {
      "unique_index": 1,
      "cn_text": "自卫队是保卫本国的组织，并不以侵略他国为前提。也就是所谓的专守防卫。",
      "cn_control_tokens": "",
      "cn_utf8_bytes": 102,
      "review_flag": ""
    },
    {
      "unique_index": 2,
      "cn_text": "专守防卫？",
      "cn_control_tokens": "",
      "cn_utf8_bytes": 15,
      "review_flag": ""
    },
    {
      "unique_index": 3,
      "cn_text": "这是自卫队基本的军事战略。不进行先发制人，只有在遭到对方攻击后，才采取最低限度的防卫行动。",
      "cn_control_tokens": "",
      "cn_utf8_bytes": 135,
      "review_flag": ""
    },
    {
      "unique_index": 4,
      "cn_text": "那样的话，就属于自卫权的范畴了。",
      "cn_control_tokens": "",
      "cn_utf8_bytes": 48,
      "review_flag": ""
    },
    {
      "unique_index": 5,
      "cn_text": "自卫队最初是从「警察预备队」开始的。",
      "cn_control_tokens": "",
      "cn_utf8_bytes": 54,
      "review_flag": ""
    },
    {
      "unique_index": 6,
      "cn_text": "当时因为朝鲜战争，驻日美军几乎全被调走了。设立它大概也有填补这一空缺的意思。",
      "cn_control_tokens": "",
      "cn_utf8_bytes": 114,
      "review_flag": ""
    },
    {
      "unique_index": 7,
      "cn_text": "警察吗……让我想起哥斯达黎加的市民警备队。",
      "cn_control_tokens": "",
      "cn_utf8_bytes": 63,
      "review_flag": ""
    },
    {
      "unique_index": 8,
      "cn_text": "对了，他们有时也会被派去救灾。我入队前一年，听说为了救援一辆坠落的巴士，可是忙得够呛。",
      "cn_control_tokens": "",
      "cn_utf8_bytes": 129,
      "review_flag": "AUX_TRUNCATED_JPN_DETAIL_RESTORED"
    }
  ]
}
