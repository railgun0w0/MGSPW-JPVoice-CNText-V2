{"file_id":"BRIEFING_FILES_BLOCK_046440","resource_class":"BRIEFING_NBE","status":"TRANSLATED_PENDING_CSV_MERGE","translations":[{"unique_index":0,"cn_text":"听说幸存下来的翼龙就在非洲的喀麦隆和刚果一带。","cn_control_tokens":"","cn_utf8_bytes":69,"review_flag":""},{"unique_index":1,"cn_text":"当地居民似乎各个部族都有不同叫法，像Kongamato、Olitiau之类的。","cn_control_tokens":"","cn_utf8_bytes":85,"review_flag":""},{"unique_index":2,"cn_text":"刚果的恐龙幸存者还真多啊。","cn_control_tokens":"","cn_utf8_bytes":39,"review_flag":""},{"unique_index":3,"cn_text":"那一带有很多未开发地区，所以它们才能不为人知地活到现在。","cn_control_tokens":"","cn_utf8_bytes":84,"review_flag":""},{"unique_index":4,"cn_text":"不过，美国也发现过翼龙化石。","cn_control_tokens":"","cn_utf8_bytes":42,"review_flag":""},{"unique_index":5,"cn_text":"三年前在德克萨斯发现的翼龙化石，据说展开翅膀足有<R=14瓦拉,12m>。","cn_control_tokens":"[\"<R=14瓦拉,12m>\"]","cn_utf8_bytes":91,"review_flag":""},{"unique_index":6,"cn_text":"那么巨大的翼龙，被当成神也不奇怪。","cn_control_tokens":"","cn_utf8_bytes":51,"review_flag":""},{"unique_index":7,"cn_text":"我看，那恐怕就是羽蛇神的真面目。","cn_control_tokens":"","cn_utf8_bytes":48,"review_flag":""}]}