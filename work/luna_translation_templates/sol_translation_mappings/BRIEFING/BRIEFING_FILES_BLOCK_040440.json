{"file_id":"BRIEFING_FILES_BLOCK_040440","resource_class":"BRIEFING_NBE","status":"TRANSLATED_PENDING_CSV_MERGE","translations":[{"unique_index":0,"cn_text":"Amanda真烦人。老是叫我跟紧她，不准离开她身边。","cn_control_tokens":"","cn_utf8_bytes":66,"review_flag":""},{"unique_index":1,"cn_text":"前阵子我赶着吃饭，她居然还说“<R= 饭 ,GALLO PINTO>要好好嚼了再吃”，你敢信？","cn_control_tokens":"[\"<R= 饭 ,GALLO PINTO>\"]","cn_utf8_bytes":105,"review_flag":"RUBY_READING_ROMANIZED; SOURCE_RUBY_SPACING_PRESERVED"},{"unique_index":2,"cn_text":"这话确实像Amanda会说的。","cn_control_tokens":"","cn_utf8_bytes":33,"review_flag":""},{"unique_index":3,"cn_text":"谁知道敌人什么时候会来，哪有时间慢吞吞地吃饭！","cn_control_tokens":"","cn_utf8_bytes":69,"review_flag":""},{"unique_index":4,"cn_text":"我也是独当一面的<R=FSLN,SANDINISTA>了。我可不想被女人这么说！！","cn_control_tokens":"[\"<R=FSLN,SANDINISTA>\"]","cn_utf8_bytes":85,"review_flag":"RUBY_READING_ROMANIZED"},{"unique_index":5,"cn_text":"这跟她是女人没关系吧。你姐姐已经很努力了。她继承了你过世父亲的事业。","cn_control_tokens":"","cn_utf8_bytes":102,"review_flag":""},{"unique_index":6,"cn_text":"我知道啦……Amanda最近确实没什么精神。","cn_control_tokens":"","cn_utf8_bytes":54,"review_flag":""},{"unique_index":7,"cn_text":"虽然也没办法……但我得振作起来才行。","cn_control_tokens":"","cn_utf8_bytes":54,"review_flag":""},{"unique_index":8,"cn_text":"就是这股劲。","cn_control_tokens":"","cn_utf8_bytes":18,"review_flag":""}]}