  "translations": [
    {
      "unique_index": 0,
      "cn_text": "古巴革命成功那年，格瓦拉以经济使节团代表身份访问日本。期间，他去了广岛。",
      "cn_control_tokens": "",
      "cn_utf8_bytes": 108,
      "review_flag": "JPN_DIRECT_TRANSLATION;AUX_REFERENCE_CLIPPED"
    },
    {
      "unique_index": 1,
      "cn_text": "广岛啊……",
      "cn_control_tokens": "",
      "cn_utf8_bytes": 15,
      "review_flag": "JPN_DIRECT_TRANSLATION"
    },
    {
      "unique_index": 2,
      "cn_text": "因为是经济使节，广岛原本不在行程之中。",
      "cn_control_tokens": "",
      "cn_utf8_bytes": 57,
      "review_flag": "JPN_DIRECT_TRANSLATION"
    },
    {
      "unique_index": 3,
      "cn_text": "也有说法称外务省不愿让他去。但他还是去了广岛。据说是一次突然造访。",
      "cn_control_tokens": "",
      "cn_utf8_bytes": 99,
      "review_flag": "JPN_DIRECT_TRANSLATION;AUX_OMITS_SUDDEN_VISIT"
    },
    {
      "unique_index": 4,
      "cn_text": "简直就是一次游击式访问。很像格瓦拉的作风。",
      "cn_control_tokens": "",
      "cn_utf8_bytes": 63,
      "review_flag": "JPN_DIRECT_TRANSLATION;AUX_REFERENCE_MISALIGNED"
    },
    {
      "unique_index": 5,
      "cn_text": "参观原爆资料馆和原爆医院后，格瓦拉似乎受到了相当大的冲击。",
      "cn_control_tokens": "",
      "cn_utf8_bytes": 87,
      "review_flag": "JPN_DIRECT_TRANSLATION;AUX_OMITS_SHOCK"
    },
    {
      "unique_index": 6,
      "cn_text": "他是医生。核爆受害者的痛苦，他一定感同身受。",
      "cn_control_tokens": "",
      "cn_utf8_bytes": 66,
      "review_flag": "JPN_DIRECT_TRANSLATION"
    },
    {
      "unique_index": 7,
      "cn_text": "核会毁掉一切……",
      "cn_control_tokens": "",
      "cn_utf8_bytes": 24,
      "review_flag": "JPN_DIRECT_TRANSLATION"
    },
    {
      "unique_index": 8,
      "cn_text": "据说格瓦拉当时说：「都被这样对待了，你们还要对美国言听计从吗？」",
      "cn_control_tokens": "",
      "cn_utf8_bytes": 96,
      "review_flag": "JPN_DIRECT_TRANSLATION"
    },
    {
      "unique_index": 9,
      "cn_text": "……这话对我来说也很沉重。尤其想到我母亲的时候。",
      "cn_control_tokens": "",
      "cn_utf8_bytes": 72,
      "review_flag": "JPN_DIRECT_TRANSLATION"
    },
    {
      "unique_index": 10,
      "cn_text": "他还说过：「从今往后，让我们爱广岛，也爱广岛的人们。」",
      "cn_control_tokens": "",
      "cn_utf8_bytes": 81,
      "review_flag": "JPN_DIRECT_TRANSLATION"
    },
    {
      "unique_index": 11,
      "cn_text": "很像他会说的话。格瓦拉是个无法对他人的痛苦麻木的人。也正因如此，他受到爱戴，也因此而死。",
      "cn_control_tokens": "",
      "cn_utf8_bytes": 132,
      "review_flag": "JPN_DIRECT_TRANSLATION"
    }
  ]
}
