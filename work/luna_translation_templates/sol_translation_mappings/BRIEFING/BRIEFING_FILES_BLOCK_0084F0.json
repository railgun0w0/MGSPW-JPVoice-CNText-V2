      "unique_index": 0,
      "cn_text": "Boss，你读过格瓦拉写的《游击战》吗？",
      "cn_control_tokens": "",
      "cn_utf8_bytes": 52,
      "review_flag": "JPN_DIRECT_TRANSLATION"
