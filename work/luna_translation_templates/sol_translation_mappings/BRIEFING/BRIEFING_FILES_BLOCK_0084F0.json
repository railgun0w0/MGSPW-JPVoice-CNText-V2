      "cn_control_tokens": "",
      "cn_utf8_bytes": 6,
      "review_flag": "JPN_DIRECT_TRANSLATION"
    },
    {
      "unique_index": 10,
      "cn_text": "楠木正成。中世纪的武士。他善用奇袭，为推翻镰仓幕府出过一份力。",
      "cn_control_tokens": "",
      "cn_utf8_bytes": 93,
