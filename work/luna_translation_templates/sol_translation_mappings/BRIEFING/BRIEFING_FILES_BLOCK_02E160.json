{"file_id":"BRIEFING_FILES_BLOCK_02E160","resource_class":"BRIEFING_NBE","status":"TRANSLATED_PENDING_CSV_MERGE","translations":[{"unique_index":0,"cn_text":"那附近应该有“Ruinas de Xochiquetzal”，也就是索奇克察尔遗迹。","cn_control_tokens":"","cn_utf8_bytes":82,"review_flag":"JPN_SPANISH_SITE_NAME_RESTORED"},{"unique_index":1,"cn_text":"那里没有经过修复，也许已经被一片绿色淹没了。","cn_control_tokens":"","cn_utf8_bytes":66,"review_flag":"JPN_GREENERY_IMAGERY_PRIMARY"},{"unique_index":2,"cn_text":"索奇克察尔？","cn_control_tokens":"","cn_utf8_bytes":18,"review_flag":""},{"unique_index":3,"cn_text":"古代阿兹特克诸神之一，以花与美之女神闻名。听说她身边还有蝴蝶和鸟相伴。","cn_control_tokens":"","cn_utf8_bytes":105,"review_flag":"AUX_FERTILITY_REPLACED_BY_JPN_FLOWERS"},{"unique_index":4,"cn_text":"似乎还有一种说法认为，她是羽蛇神的母亲。","cn_control_tokens":"","cn_utf8_bytes":60,"review_flag":""},{"unique_index":5,"cn_text":"羽蛇神……","cn_control_tokens":"","cn_utf8_bytes":15,"review_flag":""},{"unique_index":6,"cn_text":"据说格查尔鸟就是羽蛇神的化身。","cn_control_tokens":"","cn_utf8_bytes":45,"review_flag":"AUX_HENCE_ITS_NAME_ADDITION_REMOVED"},{"unique_index":7,"cn_text":"原来如此，很适合云雾林。","cn_control_tokens":"","cn_utf8_bytes":36,"review_flag":"AUX_ATMOSPHERE_PARAPHRASE_REPLACED_BY_JPN"},{"unique_index":8,"cn_text":"就算已经残破，那也是神殿。进去时别忘了保持敬意。","cn_control_tokens":"","cn_utf8_bytes":72,"review_flag":"AUX_DECAYED_TEMPLE_DETAIL_RESTORED"},{"unique_index":9,"cn_text":"看我心情吧。","cn_control_tokens":"","cn_utf8_bytes":18,"review_flag":"JPN_CASUAL_TONE_PRIMARY"},{"unique_index":10,"cn_text":"真是的！要是遭报应了，我可不管你。","cn_control_tokens":"","cn_utf8_bytes":51,"review_flag":"AUX_XOCHIQUETZAL_EXPLICIT_ADDITION_REMOVED_PER_JPN"}]}