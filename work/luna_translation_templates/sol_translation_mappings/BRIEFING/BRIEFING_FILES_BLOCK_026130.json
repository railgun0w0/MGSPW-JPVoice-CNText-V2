{"file_id":"BRIEFING_FILES_BLOCK_026130","resource_class":"BRIEFING_NBE","status":"TRANSLATED_PENDING_CSV_MERGE","translations":[{"unique_index":0,"cn_text":"像太平洋一侧的山地那样，有明显旱季的地方，会形成热带干旱林。","cn_control_tokens":"","cn_utf8_bytes":90,"review_flag":""},{"unique_index":1,"cn_text":"旱季里树木会落叶。视野虽然更开阔，但能藏身的地方反而更少，要小心。","cn_control_tokens":"","cn_utf8_bytes":99,"review_flag":""},{"unique_index":2,"cn_text":"真荒凉啊。","cn_control_tokens":"","cn_utf8_bytes":15,"review_flag":"AUX_DULL_REPLACED_BY_JPN_BARREN"},{"unique_index":3,"cn_text":"也不尽然。因为很多树会在旱季开花。","cn_control_tokens":"","cn_utf8_bytes":51,"review_flag":""},{"unique_index":4,"cn_text":"我喜欢的风铃木也是其中之一。黄色的花非常鲜艳。","cn_control_tokens":"","cn_utf8_bytes":69,"review_flag":"AUX_TABEBUIA_NAME_RESTORED"}]}