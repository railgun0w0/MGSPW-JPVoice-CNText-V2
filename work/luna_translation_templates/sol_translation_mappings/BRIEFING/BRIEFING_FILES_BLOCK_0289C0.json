{"file_id":"BRIEFING_FILES_BLOCK_0289C0","resource_class":"BRIEFING_NBE","status":"TRANSLATED_PENDING_CSV_MERGE","translations":[{"unique_index":0,"cn_text":"“Playa del Alba”在西班牙语里是“曙光海岸”的意思。从加勒比海升起的朝阳非常漂亮。","cn_control_tokens":"","cn_utf8_bytes":116,"review_flag":"JPN_SHORE_MEANING_PRIMARY"},{"unique_index":1,"cn_text":"“曙光海岸”啊。很适合作为作战的起点。","cn_control_tokens":"","cn_utf8_bytes":57,"review_flag":""},{"unique_index":2,"cn_text":"蓝色的大海、白色的沙滩、绿色的椰子树……南国风情十足吧。简直是人间天堂。","cn_control_tokens":"","cn_utf8_bytes":108,"review_flag":"AUX_SOUTH_AMERICA_DRIFT_CORRECTED"},{"unique_index":3,"cn_text":"确实。真想穿件夏威夷衫去。","cn_control_tokens":"","cn_utf8_bytes":39,"review_flag":""},{"unique_index":4,"cn_text":"珊瑚礁和红树林会保护小鱼。海龟也会成群来到沙滩上产卵。","cn_control_tokens":"","cn_utf8_bytes":81,"review_flag":"AUX_TURTLE_DETAIL_RESTORED"},{"unique_index":5,"cn_text":"这里对动物们来说也是天堂。","cn_control_tokens":"","cn_utf8_bytes":39,"review_flag":"JPN_ANIMAL_PARADISE_PRIMARY"}]}