{"file_id":"BRIEFING_FILES_BLOCK_02A4F0","resource_class":"BRIEFING_NBE","status":"TRANSLATED_PENDING_CSV_MERGE","translations":[{"unique_index":0,"cn_text":"大约20年前，巴拿马病曾大规模流行。听说有些香蕉园也因此倒闭了。","cn_control_tokens":"","cn_utf8_bytes":92,"review_flag":"AUX_BANANA_FARM_FAILURE_RESTORED"},{"unique_index":1,"cn_text":"巴拿马病？","cn_control_tokens":"","cn_utf8_bytes":15,"review_flag":""},{"unique_index":2,"cn_text":"是一种霉菌。听说因为巴拿马病，此前种植的香蕉品种几乎全灭了。","cn_control_tokens":"","cn_utf8_bytes":90,"review_flag":"AUX_MISALIGNED_REFERENCE_IGNORED"},{"unique_index":3,"cn_text":"竟然会全灭吗？","cn_control_tokens":"","cn_utf8_bytes":21,"review_flag":"AUX_MISALIGNED_REFERENCE_IGNORED"},{"unique_index":4,"cn_text":"食用香蕉不会结籽，所以是分株育苗，再把这些苗一株株种到田里……","cn_control_tokens":"","cn_utf8_bytes":93,"review_flag":"NO_RELIABLE_AUX_REFERENCE;JPN_DIRECT_TRANSLATION"},{"unique_index":5,"cn_text":"就像田里排着大量复制品一样吗？","cn_control_tokens":"","cn_utf8_bytes":45,"review_flag":"JPN_CLONE_ANALOGY_PRIMARY"},{"unique_index":6,"cn_text":"嗯。一株得病，很快就会蔓延。没有遗传多样性的品种很脆弱。","cn_control_tokens":"","cn_utf8_bytes":84,"review_flag":"AUX_FIRST_SENTENCE_AND_GENETIC_DIVERSITY_REJOINED"},{"unique_index":7,"cn_text":"现在种的是另一种香蕉。听说它能抵抗巴拿马病。","cn_control_tokens":"","cn_utf8_bytes":66,"review_flag":""}]}