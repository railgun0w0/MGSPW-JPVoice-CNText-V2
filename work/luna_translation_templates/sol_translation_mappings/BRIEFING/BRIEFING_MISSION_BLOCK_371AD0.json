{"file_id":"BRIEFING_MISSION_BLOCK_371AD0","resource_class":"BRIEFING_NBE","status":"TRANSLATED_PENDING_CSV_MERGE","translations":[{"unique_index":0,"cn_text":"Snake，那辆卡车沿着隧道另一边的山路开走了。","cn_control_tokens":"","cn_utf8_bytes":62,"review_flag":""},{"unique_index":1,"cn_text":"果然，货物就是核弹头。","cn_control_tokens":"","cn_utf8_bytes":33,"review_flag":""},{"unique_index":2,"cn_text":"……怎么办？再往前就是他们的大本营。","cn_control_tokens":"","cn_utf8_bytes":54,"review_flag":""},{"unique_index":3,"cn_text":"得赶快追上去。","cn_control_tokens":"","cn_utf8_bytes":21,"review_flag":""},{"unique_index":4,"cn_text":"可是……。","cn_control_tokens":"","cn_utf8_bytes":15,"review_flag":""},{"unique_index":5,"cn_text":"Kaz！再不快点就来不及了。","cn_control_tokens":"","cn_utf8_bytes":36,"review_flag":""},{"unique_index":6,"cn_text":"知道了。对你来说，<R=工作,BUSINESS>也好，<R=危险,RISK>也好，根本都不重要，对吧。","cn_control_tokens":"[\"<R=工作,BUSINESS>\",\"<R=危险,RISK>\"]","cn_utf8_bytes":109,"review_flag":"RUBY_READING_ROMANIZED"},{"unique_index":7,"cn_text":"要怎么进山？隧道现在就是你看到的样子。","cn_control_tokens":"","cn_utf8_bytes":57,"review_flag":""},{"unique_index":8,"cn_text":"是啊。被坦克炮击后，隧道已经完全堵死了……。","cn_control_tokens":"","cn_utf8_bytes":66,"review_flag":""},{"unique_index":9,"cn_text":"没有别的路线吗？","cn_control_tokens":"","cn_utf8_bytes":24,"review_flag":""},{"unique_index":10,"cn_text":"好吧，换个熟悉这一带地形的人来。","cn_control_tokens":"","cn_utf8_bytes":48,"review_flag":""},{"unique_index":11,"cn_text":"Snake。你是要找进山的路线吧。","cn_control_tokens":"","cn_utf8_bytes":41,"review_flag":""},{"unique_index":12,"cn_text":"你知道吗？","cn_control_tokens":"","cn_utf8_bytes":15,"review_flag":""},{"unique_index":13,"cn_text":"让我想想……。还记得我被关过的那个收容所吗？","cn_control_tokens":"","cn_utf8_bytes":66,"review_flag":""},{"unique_index":14,"cn_text":"就是那个村子吧。","cn_control_tokens":"","cn_utf8_bytes":24,"review_flag":""},{"unique_index":15,"cn_text":"对，先回到村子，再从北边出去，那里有一座桥能接上山路。","cn_control_tokens":"","cn_utf8_bytes":81,"review_flag":""},{"unique_index":16,"cn_text":"那座桥横跨峡谷。走那座桥的话，应该……。","cn_control_tokens":"","cn_utf8_bytes":60,"review_flag":""},{"unique_index":17,"cn_text":"……不过，有个小问题。","cn_control_tokens":"","cn_utf8_bytes":33,"review_flag":""},{"unique_index":18,"cn_text":"村子北边被路障封住了。可能只能把它炸掉……。","cn_control_tokens":"","cn_utf8_bytes":66,"review_flag":""},{"unique_index":19,"cn_text":"知道了。","cn_control_tokens":"","cn_utf8_bytes":12,"review_flag":""},{"unique_index":20,"cn_text":"Snake。","cn_control_tokens":"","cn_utf8_bytes":8,"review_flag":""},{"unique_index":21,"cn_text":"Irazú山腰肯定就是他们的大本营。说不定，我看到的那个……。","cn_control_tokens":"","cn_utf8_bytes":84,"review_flag":""},{"unique_index":22,"cn_text":"“basilisco”吗？","cn_control_tokens":"","cn_utf8_bytes":21,"review_flag":""},{"unique_index":23,"cn_text":"……你果然还是不相信吧。","cn_control_tokens":"","cn_utf8_bytes":36,"review_flag":""},{"unique_index":24,"cn_text":"不，等过去看看就知道了。","cn_control_tokens":"","cn_utf8_bytes":36,"review_flag":""},{"unique_index":25,"cn_text":"Snake，Irazú有好几个火口湖。","cn_control_tokens":"","cn_utf8_bytes":38,"review_flag":""},{"unique_index":26,"cn_text":"以前似乎曾作为Oduber国家企业体制的一环，计划利用这些火口湖修建抽水蓄能电站。","cn_control_tokens":"","cn_utf8_bytes":111,"review_flag":""},{"unique_index":27,"cn_text":"计划虽然取消了，但湖底还留着一个不小的开口。","cn_control_tokens":"","cn_utf8_bytes":66,"review_flag":""},{"unique_index":28,"cn_text":"也就是说？","cn_control_tokens":"","cn_utf8_bytes":15,"review_flag":""},{"unique_index":29,"cn_text":"我看过卫星照片，外面看不到任何人工建筑。","cn_control_tokens":"","cn_utf8_bytes":60,"review_flag":""},{"unique_index":30,"cn_text":"这样看来，他们很可能把山体内部当成设施在用。可能只是<R=爆药保管库,IGLOO>，也可能是什么研究设施。","cn_control_tokens":"[\"<R=爆药保管库,IGLOO>\"]","cn_utf8_bytes":139,"review_flag":"RUBY_READING_ROMANIZED"},{"unique_index":31,"cn_text":"把核弹头运进那种地方，他们到底想干什么？","cn_control_tokens":"","cn_utf8_bytes":60,"review_flag":""},{"unique_index":32,"cn_text":"Snake，先处理村子北面的路障。虽然粗暴了点，看来只能炸开。","cn_control_tokens":"","cn_utf8_bytes":83,"review_flag":""}]}