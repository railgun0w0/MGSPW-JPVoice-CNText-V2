{"file_id":"BRIEFING_FILES_BLOCK_0296E0","resource_class":"BRIEFING_NBE","status":"TRANSLATED_PENDING_CSV_MERGE","translations":[{"unique_index":0,"cn_text":"那附近应该有一座吊桥。","cn_control_tokens":"","cn_utf8_bytes":33,"review_flag":""},{"unique_index":1,"cn_text":"在这么低的地方？","cn_control_tokens":"","cn_utf8_bytes":24,"review_flag":""},{"unique_index":2,"cn_text":"这附近的地面少见地很坚硬，形成了一处高地。河流侵蚀那里，才形成了山谷。","cn_control_tokens":"","cn_utf8_bytes":105,"review_flag":"AUX_VALLEY_CAUSE_RESTORED"},{"unique_index":3,"cn_text":"这一带恐怕没有别的地方能过河了。","cn_control_tokens":"","cn_utf8_bytes":48,"review_flag":"ENG_POLARITY_CONTRADICTION_CORRECTED"},{"unique_index":4,"cn_text":"要是桥上有敌兵，就麻烦了。","cn_control_tokens":"","cn_utf8_bytes":39,"review_flag":"AUX_ENEMY_DETAIL_RESTORED"},{"unique_index":5,"cn_text":"山谷里有雾，可能连水面都看不见。但掉下去肯定不会安然无恙。","cn_control_tokens":"","cn_utf8_bytes":87,"review_flag":"AUX_FALL_DANGER_RESTORED"},{"unique_index":6,"cn_text":"那就多加小心吧。","cn_control_tokens":"","cn_utf8_bytes":24,"review_flag":""}]}