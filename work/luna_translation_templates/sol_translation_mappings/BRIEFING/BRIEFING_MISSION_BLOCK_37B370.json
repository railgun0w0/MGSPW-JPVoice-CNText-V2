{"file_id":"BRIEFING_MISSION_BLOCK_37B370","resource_class":"BRIEFING_NBE","status":"TRANSLATED_PENDING_CSV_MERGE","translations":[{"unique_index":0,"cn_text":"Snake！\n被拘留的Zadornov又不见了。\n","cn_control_tokens":"","cn_utf8_bytes":45,"review_flag":""},{"unique_index":1,"cn_text":"嗯。\n","cn_control_tokens":"","cn_utf8_bytes":7,"review_flag":""},{"unique_index":2,"cn_text":"……Snake！？\n被拘留的Zadornov又不见了！\n","cn_control_tokens":"","cn_utf8_bytes":54,"review_flag":""},{"unique_index":3,"cn_text":"嗯。\n","cn_control_tokens":"","cn_utf8_bytes":7,"review_flag":""},{"unique_index":4,"cn_text":"拜托，听我说。\n被拘留的Zadornov又不见了。\n","cn_control_tokens":"","cn_utf8_bytes":58,"review_flag":""},{"unique_index":5,"cn_text":"所以呢？\n","cn_control_tokens":"","cn_utf8_bytes":13,"review_flag":""},{"unique_index":6,"cn_text":"虽然不愿这么想……\n但也许有内应。\n","cn_control_tokens":"","cn_utf8_bytes":50,"review_flag":""},{"unique_index":7,"cn_text":"唉……。\n话说回来，那家伙的目的到底是什么？\n","cn_control_tokens":"","cn_utf8_bytes":65,"review_flag":""},{"unique_index":8,"cn_text":"不知道。不过不像只是单纯在反抗。\n","cn_control_tokens":"","cn_utf8_bytes":49,"review_flag":""},{"unique_index":9,"cn_text":"继续把那家伙拘留在这里也……。\n如果他不愿成为我们的伙伴……！\n","cn_control_tokens":"","cn_utf8_bytes":92,"review_flag":""},{"unique_index":10,"cn_text":"嗯，本来是考虑到俄裔成员的士气才把他拘留在这里，\n……明白了，我会再考虑一下。\n","cn_control_tokens":"","cn_utf8_bytes":116,"review_flag":""},{"unique_index":11,"cn_text":"如果他只是在享受捉迷藏，那倒还好……。\n","cn_control_tokens":"","cn_utf8_bytes":58,"review_flag":""},{"unique_index":12,"cn_text":"我准备了一个新任务。\n找到KGB特工Zadornov！\n","cn_control_tokens":"","cn_utf8_bytes":58,"review_flag":""}]}