{"file_id":"BRIEFING_FILES_BLOCK_024290","resource_class":"BRIEFING_NBE","status":"TRANSLATED_PENDING_CSV_MERGE","translations":[{"unique_index":0,"cn_text":"Paz，你说过哥斯达黎加在宪法中废除了军队，对吧？","cn_control_tokens":"","cn_utf8_bytes":69,"review_flag":"AUX_CONSTITUTION_DETAIL_RESTORED"},{"unique_index":1,"cn_text":"嗯。宪法第12条宣布废除常备军。","cn_control_tokens":"","cn_utf8_bytes":44,"review_flag":"AUX_STANDING_ARMY_CLAUSE_RESTORED"},{"unique_index":2,"cn_text":"不过，为了国防，或根据美洲地区的协定，还是允许组织军队的。","cn_control_tokens":"","cn_utf8_bytes":87,"review_flag":"AUX_INTER_AMERICAN_AGREEMENT_RESTORED"},{"unique_index":3,"cn_text":"也就是说，临时组建是允许的。","cn_control_tokens":"","cn_utf8_bytes":42,"review_flag":""},{"unique_index":4,"cn_text":"可以这么说。不过自这部宪法制定以来，哥斯达黎加从未组建过军队。","cn_control_tokens":"","cn_utf8_bytes":93,"review_flag":""}]}