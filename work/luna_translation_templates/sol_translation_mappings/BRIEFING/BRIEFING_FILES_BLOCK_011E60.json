{"file_id":"BRIEFING_FILES_BLOCK_011E60","resource_class":"BRIEFING_NBE","status":"TRANSLATED_PENDING_CSV_MERGE","translations":[{"unique_index":0,"cn_text":"Snake，有件事想拜托你。","cn_control_tokens":"","cn_utf8_bytes":32,"review_flag":""},{"unique_index":1,"cn_text":"怎么了，突然这么郑重其事。","cn_control_tokens":"","cn_utf8_bytes":39,"review_flag":"AUX_MEANING_DRIFT_IGNORED"},{"unique_index":2,"cn_text":"要扩大MSF，首先得招人。","cn_control_tokens":"","cn_utf8_bytes":33,"review_flag":""},{"unique_index":3,"cn_text":"是啊。然后呢？","cn_control_tokens":"","cn_utf8_bytes":21,"review_flag":""},{"unique_index":4,"cn_text":"我希望你尽量别杀敌兵，把他们用富尔顿回收带回来。","cn_control_tokens":"","cn_utf8_bytes":72,"review_flag":""},{"unique_index":5,"cn_text":"就算把尸体回收回来，我们最多也只能替他们收尸。","cn_control_tokens":"","cn_utf8_bytes":69,"review_flag":""},{"unique_index":6,"cn_text":"确实。","cn_control_tokens":"","cn_utf8_bytes":9,"review_flag":""},{"unique_index":7,"cn_text":"让他们睡着、打晕……或者举枪投降也行。就算迫不得已要交战，也尽量只打到濒死，别直接杀掉。","cn_control_tokens":"","cn_utf8_bytes":132,"review_flag":""},{"unique_index":8,"cn_text":"然后再富尔顿回收吗……试试看吧。","cn_control_tokens":"","cn_utf8_bytes":48,"review_flag":"AUX_EXPANSION_IGNORED"},{"unique_index":9,"cn_text":"说真的，要是有种装置能不由分说地把盯上的目标直接富尔顿回收，那就省事多了……","cn_control_tokens":"","cn_utf8_bytes":114,"review_flag":""}]}