{"file_id":"BRIEFING_FILES_BLOCK_070050","resource_class":"BRIEFING_NBE","status":"TRANSLATED_PENDING_CSV_MERGE","translations":[{"unique_index":0,"cn_text":"Peace Walker由两个AI Pod组装而成。","cn_control_tokens":"","cn_utf8_bytes":42,"review_flag":""},{"unique_index":1,"cn_text":"一个是我制造的Reptile Pod，另一个是Strangelove开发的Mammal Pod。","cn_control_tokens":"","cn_utf8_bytes":80,"review_flag":""},{"unique_index":2,"cn_text":"有什么区别？","cn_control_tokens":"","cn_utf8_bytes":18,"review_flag":""},{"unique_index":3,"cn_text":"Reptile Pod是用于姿态控制的AI。只要破坏它，至少应该能让Peace Walker停止行动。","cn_control_tokens":"","cn_utf8_bytes":103,"review_flag":""},{"unique_index":4,"cn_text":"Mammal Pod负责核报复的决策。","cn_control_tokens":"","cn_utf8_bytes":37,"review_flag":""},{"unique_index":5,"cn_text":"反射运动与思考……就像脑干、小脑和大脑之间的关系。","cn_control_tokens":"","cn_utf8_bytes":75,"review_flag":""},{"unique_index":6,"cn_text":"这么说，寄宿着The Boss意志的是……。","cn_control_tokens":"","cn_utf8_bytes":50,"review_flag":""},{"unique_index":7,"cn_text":"就是Mammal Pod。","cn_control_tokens":"","cn_utf8_bytes":19,"review_flag":""}]}