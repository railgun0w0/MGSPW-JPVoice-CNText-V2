{
  "file_id": "BRIEFING_FILES_BLOCK_00C420",
  "resource_class": "BRIEFING_NBE",
  "status": "TRANSLATED_PENDING_CSV_MERGE",
  "translations": [
    {
      "unique_index": 0,
      "cn_text": "日本有美国军队驻扎吧。",
      "cn_control_tokens": "",
      "cn_utf8_bytes": 33,
      "review_flag": "JPN_DIRECT_TRANSLATION"
    },
    {
      "unique_index": 1,
      "cn_text": "对。盟军占领结束后，美军仍根据《日美安全保障条约》继续驻扎。",
      "cn_control_tokens": "",
      "cn_utf8_bytes": 90,
      "review_flag": "JPN_DIRECT_TRANSLATION"
    },
    {
      "unique_index": 2,
      "cn_text": "这点和哥斯达黎加不同。",
      "cn_control_tokens": "",
      "cn_utf8_bytes": 33,
      "review_flag": "JPN_DIRECT_TRANSLATION;AUX_REFERENCE_MISALIGNED"
    },
    {
      "unique_index": 3,
      "cn_text": "虽然也有占领这段历史，但从根本上说，对美国而言，日本在战略上处于非常重要的位置。",
      "cn_control_tokens": "",
      "cn_utf8_bytes": 120,
      "review_flag": "JPN_DIRECT_TRANSLATION"
    },
    {
      "unique_index": 4,
      "cn_text": "苏联近在咫尺，又靠近中国和北朝鲜。对太平洋地区的安全保障也不可或缺。",
      "cn_control_tokens": "",
      "cn_utf8_bytes": 102,
      "review_flag": "JPN_DIRECT_TRANSLATION"
    },
    {
      "unique_index": 5,
      "cn_text": "对美国来说，日本就是「抵御共产主义的防波堤」。",
      "cn_control_tokens": "",
      "cn_utf8_bytes": 69,
      "review_flag": "JPN_DIRECT_TRANSLATION"
    },
    {
      "unique_index": 6,
      "cn_text": "那对日本来说呢？",
      "cn_control_tokens": "",
      "cn_utf8_bytes": 24,
      "review_flag": "JPN_DIRECT_TRANSLATION"
    },
    {
      "unique_index": 7,
      "cn_text": "当然，反对日美安保的声音一直根深蒂固。",
      "cn_control_tokens": "",
      "cn_utf8_bytes": 57,
      "review_flag": "JPN_DIRECT_TRANSLATION"
    },
    {
      "unique_index": 8,
      "cn_text": "1960年和1970年条约修订时，都爆发了大规模反对运动。",
      "cn_control_tokens": "",
      "cn_utf8_bytes": 71,
      "review_flag": "JPN_DIRECT_TRANSLATION;AUX_REFERENCE_CLIPPED"
    },
    {
      "unique_index": 9,
      "cn_text": "尤其是冲绳，两年前才刚由美国归还，基地又高度集中。当地居民承受的负担也很重。",
      "cn_control_tokens": "",
      "cn_utf8_bytes": 114,
      "review_flag": "JPN_DIRECT_TRANSLATION"
    },
    {
      "unique_index": 10,
      "cn_text": "那为什么不废除条约？",
      "cn_control_tokens": "",
      "cn_utf8_bytes": 30,
      "review_flag": "JPN_DIRECT_TRANSLATION"
    },
    {
      "unique_index": 11,
      "cn_text": "原因很多。当然也有与美国之间的力量关系。而且一旦废除条约，也意味着脱离美国的核保护伞。",
      "cn_control_tokens": "",
      "cn_utf8_bytes": 129,
      "review_flag": "JPN_DIRECT_TRANSLATION"
    },
    {
      "unique_index": 12,
      "cn_text": "美军撤走后，只靠自卫队能不能守住国家……这个我也说不好。",
      "cn_control_tokens": "",
      "cn_utf8_bytes": 84,
      "review_flag": "JPN_DIRECT_TRANSLATION;AUX_REFERENCE_CLIPPED"
    },
    {
      "unique_index": 13,
      "cn_text": "这和哥斯达黎加依靠《美洲国家间互助条约》，也就是所谓的《里约条约》一样。",
      "cn_control_tokens": "",
      "cn_utf8_bytes": 108,
      "review_flag": "JPN_DIRECT_TRANSLATION"
    },
    {
      "unique_index": 14,
      "cn_text": "一个拥有和平宪法的国家，却不得不接受外国军队驻扎……真是讽刺。",
      "cn_control_tokens": "",
      "cn_utf8_bytes": 93,
      "review_flag": "JPN_DIRECT_TRANSLATION;AUX_PLURALIZATION_IGNORED"
    },
    {
      "unique_index": 15,
      "cn_text": "另一方面，美国似乎也有不满。认为日本是在搭美军安全保障的便车。",
      "cn_control_tokens": "",
      "cn_utf8_bytes": 93,
      "review_flag": "JPN_DIRECT_TRANSLATION"
    },
    {
      "unique_index": 16,
      "cn_text": "最近日本的工业产品不是正在进军美国市场吗？",
      "cn_control_tokens": "",
      "cn_utf8_bytes": 63,
      "review_flag": "JPN_DIRECT_TRANSLATION"
    },
    {
      "unique_index": 17,
      "cn_text": "对。",
      "cn_control_tokens": "",
      "cn_utf8_bytes": 6,
      "review_flag": "JPN_DIRECT_TRANSLATION;AUX_INVENTED_CAMERA_IGNORED"
    },
    {
      "unique_index": 18,
      "cn_text": "日本把军备开支转用于经济复兴，如今又在美国市场不断扩大份额。美国人心里恐怕不会痛快。",
      "cn_control_tokens": "",
      "cn_utf8_bytes": 126,
      "review_flag": "JPN_DIRECT_TRANSLATION;AUX_OMITS_US_DISPLEASURE"
    }
  ]
}
