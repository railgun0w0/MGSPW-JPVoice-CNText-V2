{"file_id":"BRIEFING_FILES_BLOCK_055B40","resource_class":"BRIEFING_NBE","status":"TRANSLATED_PENDING_CSV_MERGE","translations":[{"unique_index":0,"cn_text":"你为什么会决定来Mother Base？","cn_control_tokens":"","cn_utf8_bytes":38,"review_flag":""},{"unique_index":1,"cn_text":"因为我对你产生了兴趣。","cn_control_tokens":"","cn_utf8_bytes":33,"review_flag":""},{"unique_index":2,"cn_text":"我？……难道你这次想以我为模型制造AI……。","cn_control_tokens":"","cn_utf8_bytes":62,"review_flag":""},{"unique_index":3,"cn_text":"哈，那也不坏。不过，我已经不打算再把人的思维本身移植进去。","cn_control_tokens":"","cn_utf8_bytes":87,"review_flag":""},{"unique_index":4,"cn_text":"……那我就放心了。","cn_control_tokens":"","cn_utf8_bytes":27,"review_flag":""},{"unique_index":5,"cn_text":"你是继承The Boss遗志的男人。","cn_control_tokens":"","cn_utf8_bytes":38,"review_flag":""},{"unique_index":6,"cn_text":"而你正在召集人、培养他们，试图建立一个组织。我想看看它最后会走向哪里。","cn_control_tokens":"","cn_utf8_bytes":105,"review_flag":""},{"unique_index":7,"cn_text":"你不打算回去继续AI研究吗？","cn_control_tokens":"","cn_utf8_bytes":38,"review_flag":""},{"unique_index":8,"cn_text":"谁说我要停了。我会继续。","cn_control_tokens":"","cn_utf8_bytes":36,"review_flag":""},{"unique_index":9,"cn_text":"在这里？","cn_control_tokens":"","cn_utf8_bytes":12,"review_flag":""},{"unique_index":10,"cn_text":"对我来说，MSF这个组织的成长过程本身，就像神经网络的发育。","cn_control_tokens":"","cn_utf8_bytes":84,"review_flag":""},{"unique_index":11,"cn_text":"彼此交织、互相刺激，再不断伸展枝叶……会给我很好的灵感。","cn_control_tokens":"","cn_utf8_bytes":84,"review_flag":""},{"unique_index":12,"cn_text":"这说法挺有意思。","cn_control_tokens":"","cn_utf8_bytes":24,"review_flag":""},{"unique_index":13,"cn_text":"当然，我也不是要你白白让我做研究。成果会回馈给你们。","cn_control_tokens":"","cn_utf8_bytes":78,"review_flag":""},{"unique_index":14,"cn_text":"要不要把我分到研发班？我保证不会让你失望。","cn_control_tokens":"","cn_utf8_bytes":63,"review_flag":""}]}