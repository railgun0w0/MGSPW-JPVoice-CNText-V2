{"file_id":"BRIEFING_FILES_BLOCK_035660","resource_class":"BRIEFING_NBE","status":"TRANSLATED_PENDING_CSV_MERGE","translations":[{"unique_index":0,"cn_text":"<R=祖国,NICARAGUA>的土地属于我们，却又不属于我们。","cn_control_tokens":"[\"<R=祖国,NICARAGUA>\"]","cn_utf8_bytes":68,"review_flag":"RUBY_READING_ROMANIZED"},{"unique_index":1,"cn_text":"什么意思？","cn_control_tokens":"","cn_utf8_bytes":15,"review_flag":""},{"unique_index":2,"cn_text":"沿海全是香蕉园，山里尽是咖啡田。不过，<R=这一带,COSTA RICA>也差不多。","cn_control_tokens":"[\"<R=这一带,COSTA RICA>\"]","cn_utf8_bytes":96,"review_flag":"RUBY_READING_ROMANIZED"},{"unique_index":3,"cn_text":"种植园啊。","cn_control_tokens":"","cn_utf8_bytes":15,"review_flag":""},{"unique_index":4,"cn_text":"收获的香蕉和咖啡几乎都拿去出口。钱全被地主独吞，农民最后只剩一点点。","cn_control_tokens":"","cn_utf8_bytes":102,"review_flag":""},{"unique_index":5,"cn_text":"而且最大的地主，偏偏还是<R=蛤蟆,SOMOZA>一家。","cn_control_tokens":"[\"<R=蛤蟆,SOMOZA>\"]","cn_utf8_bytes":62,"review_flag":"RUBY_READING_ROMANIZED"},{"unique_index":6,"cn_text":"但至少能赚外汇。","cn_control_tokens":"","cn_utf8_bytes":24,"review_flag":""},{"unique_index":7,"cn_text":"香蕉的话，连这点都很可疑。因为香蕉园本来就是美国公司的。","cn_control_tokens":"","cn_utf8_bytes":84,"review_flag":""},{"unique_index":8,"cn_text":"香蕉在园内工厂加工，再从专用港口直接出口到美国……。","cn_control_tokens":"","cn_utf8_bytes":78,"review_flag":""},{"unique_index":9,"cn_text":"简直就像美国在沿海划出了一块飞地。","cn_control_tokens":"","cn_utf8_bytes":51,"review_flag":""},{"unique_index":10,"cn_text":"可农民又只能去那里干活……。","cn_control_tokens":"","cn_utf8_bytes":42,"review_flag":""},{"unique_index":11,"cn_text":"荒唐。我们必须夺回自己的土地。这也是我们的目标之一。","cn_control_tokens":"","cn_utf8_bytes":78,"review_flag":""}]}