{"file_id":"BRIEFING_FILES_BLOCK_025060","resource_class":"BRIEFING_NBE","status":"TRANSLATED_PENDING_CSV_MERGE","translations":[{"unique_index":0,"cn_text":"Kaz说过，日本也有和平宪法。","cn_control_tokens":"","cn_utf8_bytes":39,"review_flag":""},{"unique_index":1,"cn_text":"嗯。听说哥斯达黎加制定现行宪法时，也参考了日本宪法。","cn_control_tokens":"","cn_utf8_bytes":78,"review_flag":""},{"unique_index":2,"cn_text":"不过，日本的和平宪法放弃的是战争本身。","cn_control_tokens":"","cn_utf8_bytes":57,"review_flag":""},{"unique_index":3,"cn_text":"这一点和哥斯达黎加不同。","cn_control_tokens":"","cn_utf8_bytes":36,"review_flag":""},{"unique_index":4,"cn_text":"可是……日本有自卫队吧？这一点我不明白。","cn_control_tokens":"","cn_utf8_bytes":60,"review_flag":""},{"unique_index":5,"cn_text":"下次我想问问Miller先生。听说他以前待过自卫队。","cn_control_tokens":"","cn_utf8_bytes":66,"review_flag":""},{"unique_index":6,"cn_text":"你还真好学啊。不过，也别太折腾他了。","cn_control_tokens":"","cn_utf8_bytes":54,"review_flag":"JPN_TONE_OVER_AUX_STUDY_HARD"}]}