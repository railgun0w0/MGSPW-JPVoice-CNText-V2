  "translations": [
    {"unique_index":0,"cn_text":"为什么离开自卫队？","cn_control_tokens":"","cn_utf8_bytes":27,"review_flag":""},
    {"unique_index":1,"cn_text":"因为我已经没有继续留在日本的理由了。","cn_control_tokens":"","cn_utf8_bytes":54,"review_flag":""},
    {"unique_index":2,"cn_text":"理由？","cn_control_tokens":"","cn_utf8_bytes":9,"review_flag":""},
    {"unique_index":3,"cn_text":"我母亲三年前去世了，也就不需要再照顾她。既然这样，我也没必要继续窝在日本。","cn_control_tokens":"","cn_utf8_bytes":111,"review_flag":""},
    {"unique_index":4,"cn_text":"不过以你的本事，上级应该对你寄予厚望吧。","cn_control_tokens":"","cn_utf8_bytes":60,"review_flag":""},
    {"unique_index":5,"cn_text":"我不知道他们怎么评价我。说不定反倒把我当成刺头，挺不待见我的。","cn_control_tokens":"","cn_utf8_bytes":93,"review_flag":"AUX_REBEL_NUANCE_RESTORED"},
    {"unique_index":6,"cn_text":"而且我自己也一直不适应专守防卫。","cn_control_tokens":"","cn_utf8_bytes":48,"review_flag":""},
    {"unique_index":7,"cn_text":"怎么说？","cn_control_tokens":"","cn_utf8_bytes":12,"review_flag":""},
    {"unique_index":8,"cn_text":"自卫队的专守防卫，作为国家战略的一种形式，也许是可行的。我也无意贬低遵从它的同僚。","cn_control_tokens":"","cn_utf8_bytes":123,"review_flag":"AUX_PARTIAL_JPN_DETAIL_RESTORED"},
    {"unique_index":9,"cn_text":"但从战术层面来看，这套东西实在不合我的性子。","cn_control_tokens":"","cn_utf8_bytes":66,"review_flag":""},
    {"unique_index":10,"cn_text":"说白了，我就是想好好狠狠干上一架。","cn_control_tokens":"","cn_utf8_bytes":51,"review_flag":""},
    {"unique_index":11,"cn_text":"很像你。","cn_control_tokens":"","cn_utf8_bytes":12,"review_flag":"AUX_ROW_MISALIGNMENT_IGNORED"},
    {"unique_index":12,"cn_text":"我也觉得，只要还待在自卫队，就永远没法和父亲待过的美军并肩而立。","cn_control_tokens":"","cn_utf8_bytes":96,"review_flag":"AUX_US_ARMY_NARROWING_IGNORED"},
    {"unique_index":13,"cn_text":"而且，还有三岛由纪夫的自决。我亲眼看到了那一幕。","cn_control_tokens":"","cn_utf8_bytes":72,"review_flag":"AUX_CAUSAL_EXPANSION_IGNORED"},
    {"unique_index":14,"cn_text":"三岛由纪夫……写《金阁寺》的那个？","cn_control_tokens":"","cn_utf8_bytes":51,"review_flag":""},
    {"unique_index":15,"cn_text":"三岛提出的那个问题，对我来说也很沉重。","cn_control_tokens":"","cn_utf8_bytes":57,"review_flag":""},
    {"unique_index":16,"cn_text":"我并不是他的思想追随者。不过，那件事确实成了促使我思考的契机。","cn_control_tokens":"","cn_utf8_bytes":93,"review_flag":""}
  ]
}
