{"file_id":"BRIEFING_FILES_BLOCK_051320","resource_class":"BRIEFING_NBE","status":"TRANSLATED_PENDING_CSV_MERGE","translations":[{"unique_index":0,"cn_text":"以现在的技术，AI无论如何都会非常巨大。","cn_control_tokens":"","cn_utf8_bytes":56,"review_flag":""},{"unique_index":1,"cn_text":"不过，今后随着电路集成度不断提高，AI也会越来越小。甚至能缩到和人脑一样大，或者更小。","cn_control_tokens":"","cn_utf8_bytes":125,"review_flag":""},{"unique_index":2,"cn_text":"另一方面，机器人技术也会不断进步，最终应该能制造出外形与人类相似的仿生人。到了那时……。","cn_control_tokens":"","cn_utf8_bytes":132,"review_flag":""},{"unique_index":3,"cn_text":"到了那时又怎样？","cn_control_tokens":"","cn_utf8_bytes":24,"review_flag":""},{"unique_index":4,"cn_text":"不用我说你也明白吧？","cn_control_tokens":"","cn_utf8_bytes":30,"review_flag":""},{"unique_index":5,"cn_text":"难道你想制造一个和The Boss一模一样的机器偶人……。","cn_control_tokens":"","cn_utf8_bytes":71,"review_flag":""},{"unique_index":6,"cn_text":"你难道从没想过吗？想过有一天，她会再次出现在我们面前？","cn_control_tokens":"","cn_utf8_bytes":81,"review_flag":""},{"unique_index":7,"cn_text":"住手！那种东西只是赝品！！","cn_control_tokens":"","cn_utf8_bytes":39,"review_flag":""},{"unique_index":8,"cn_text":"还真是洁癖得很。","cn_control_tokens":"","cn_utf8_bytes":24,"review_flag":""},{"unique_index":9,"cn_text":"不过现实中，AI更有可能朝相反的方向进化吧。","cn_control_tokens":"","cn_utf8_bytes":62,"review_flag":""}]}