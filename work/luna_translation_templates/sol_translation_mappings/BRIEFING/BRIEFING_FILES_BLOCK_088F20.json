{"file_id":"BRIEFING_FILES_BLOCK_088F20","resource_class":"BRIEFING_NBE","status":"TRANSLATED_PENDING_CSV_MERGE","translations":[{"unique_index":0,"cn_text":"她把一切都告诉了我。","cn_control_tokens":"","cn_utf8_bytes":30,"review_flag":""},{"unique_index":1,"cn_text":"为什么要向我坦白？","cn_control_tokens":"","cn_utf8_bytes":27,"review_flag":""},{"unique_index":2,"cn_text":"当时，我并不明白。","cn_control_tokens":"","cn_utf8_bytes":27,"review_flag":""},{"unique_index":3,"cn_text":"但现在，我明白了。","cn_control_tokens":"","cn_utf8_bytes":27,"review_flag":""},{"unique_index":4,"cn_text":"Snake，她是想把这一切告诉你。","cn_control_tokens":"","cn_utf8_bytes":41,"review_flag":""},{"unique_index":5,"cn_text":"为了把真相传达给你，她选择了我。","cn_control_tokens":"","cn_utf8_bytes":48,"review_flag":""},{"unique_index":6,"cn_text":"所以，她才救了我。","cn_control_tokens":"","cn_utf8_bytes":27,"review_flag":""},{"unique_index":7,"cn_text":"我对你撒过很多谎。但这一次不是。","cn_control_tokens":"","cn_utf8_bytes":48,"review_flag":""},{"unique_index":8,"cn_text":"政府交给我的任务，是取得“遗产”……。","cn_control_tokens":"","cn_utf8_bytes":57,"review_flag":""},{"unique_index":9,"cn_text":"以及除掉所有知道真相的人。","cn_control_tokens":"","cn_utf8_bytes":39,"review_flag":""},{"unique_index":10,"cn_text":"也就是说，我连你也必须杀掉。","cn_control_tokens":"","cn_utf8_bytes":42,"review_flag":""},{"unique_index":11,"cn_text":"可是，我做不到。","cn_control_tokens":"","cn_utf8_bytes":24,"review_flag":""},{"unique_index":12,"cn_text":"不是因为我曾与你相爱。","cn_control_tokens":"","cn_utf8_bytes":33,"review_flag":""},{"unique_index":13,"cn_text":"也不是因为你救过我的命。","cn_control_tokens":"","cn_utf8_bytes":36,"review_flag":""},{"unique_index":14,"cn_text":"而是为了履行我和她的约定。","cn_control_tokens":"","cn_utf8_bytes":39,"review_flag":""},{"unique_index":15,"cn_text":"和The Boss的约定。","cn_control_tokens":"","cn_utf8_bytes":23,"review_flag":""},{"unique_index":16,"cn_text":"唯独这件事，我必须告诉你。","cn_control_tokens":"","cn_utf8_bytes":39,"review_flag":""},{"unique_index":17,"cn_text":"而你……必须活下去。","cn_control_tokens":"","cn_utf8_bytes":30,"review_flag":""},{"unique_index":18,"cn_text":"Snake，听好了。","cn_control_tokens":"","cn_utf8_bytes":20,"review_flag":""},{"unique_index":19,"cn_text":"她并不是美国的叛徒。","cn_control_tokens":"","cn_utf8_bytes":30,"review_flag":""},{"unique_index":20,"cn_text":"不，恰恰相反。她是为国家而死的英雄。","cn_control_tokens":"","cn_utf8_bytes":54,"review_flag":""},{"unique_index":21,"cn_text":"她早已做好一切觉悟，依然完成了任务。","cn_control_tokens":"","cn_utf8_bytes":54,"review_flag":""},{"unique_index":22,"cn_text":"自我牺牲……那就是她的职责。","cn_control_tokens":"","cn_utf8_bytes":42,"review_flag":""},{"unique_index":23,"cn_text":"The Boss的叛逃，是美国政府安排的一场假叛逃。","cn_control_tokens":"","cn_utf8_bytes":62,"review_flag":""},{"unique_index":24,"cn_text":"美国政府为了得到“贤者的遗产”，上演了一出大戏。","cn_control_tokens":"","cn_utf8_bytes":72,"review_flag":""},{"unique_index":25,"cn_text":"而这出戏的主角，就是The Boss。","cn_control_tokens":"","cn_utf8_bytes":41,"review_flag":""},{"unique_index":26,"cn_text":"为了取得Volgin上校继承的“遗产”……。","cn_control_tokens":"","cn_utf8_bytes":54,"review_flag":""},{"unique_index":27,"cn_text":"同时也是为了摧毁Shagohod。","cn_control_tokens":"","cn_utf8_bytes":35,"review_flag":""},{"unique_index":28,"cn_text":"就连Volgin上校，也只会对身为传奇英雄的The Boss放下戒心。","cn_control_tokens":"","cn_utf8_bytes":77,"review_flag":""},{"unique_index":29,"cn_text":"查明“贤者的遗产”所在之处，是她最重要的任务。","cn_control_tokens":"","cn_utf8_bytes":69,"review_flag":""},{"unique_index":30,"cn_text":"假叛逃进行得很顺利。","cn_control_tokens":"","cn_utf8_bytes":30,"review_flag":""},{"unique_index":31,"cn_text":"然而，却发生了谁也没有料到的事。","cn_control_tokens":"","cn_utf8_bytes":48,"review_flag":""},{"unique_index":32,"cn_text":"Volgin上校向Sokolov设计局发射了一枚美国的核弹头。","cn_control_tokens":"","cn_utf8_bytes":67,"review_flag":""},{"unique_index":33,"cn_text":"赫鲁晓夫要求美国政府证明自己的清白。","cn_control_tokens":"","cn_utf8_bytes":54,"review_flag":""},{"unique_index":34,"cn_text":"可美国政府也不能中止夺取“遗产”的原定计划。","cn_control_tokens":"","cn_utf8_bytes":66,"review_flag":""},{"unique_index":35,"cn_text":"于是，整个作战剧本被大幅增补、修改。","cn_control_tokens":"","cn_utf8_bytes":54,"review_flag":""},{"unique_index":36,"cn_text":"为了证明美国政府的清白，The Boss必须被消灭……。","cn_control_tokens":"","cn_utf8_bytes":68,"review_flag":""},{"unique_index":37,"cn_text":"而且必须由她自己的政府动手。","cn_control_tokens":"","cn_utf8_bytes":42,"review_flag":""},{"unique_index":38,"cn_text":"必须公开处决，并让这一事实作为记录流传后世。","cn_control_tokens":"","cn_utf8_bytes":66,"review_flag":""},{"unique_index":39,"cn_text":"他们认定，这是让事态平稳收场的最佳办法。","cn_control_tokens":"","cn_utf8_bytes":60,"review_flag":""},{"unique_index":40,"cn_text":"她不被允许活着回来。","cn_control_tokens":"","cn_utf8_bytes":30,"review_flag":""},{"unique_index":41,"cn_text":"也不被允许自尽。","cn_control_tokens":"","cn_utf8_bytes":24,"review_flag":""},{"unique_index":42,"cn_text":"她必须死在你——她深爱的<R=弟子,SON>——手中……。","cn_control_tokens":"[\"<R=弟子,SON>\"]","cn_utf8_bytes":71,"review_flag":"RUBY_READING_ROMANIZED"},{"unique_index":43,"cn_text":"那正是政府所期望、也必须执行的……。","cn_control_tokens":"","cn_utf8_bytes":54,"review_flag":""},{"unique_index":44,"cn_text":"赋予她的任务……。","cn_control_tokens":"","cn_utf8_bytes":27,"review_flag":""},{"unique_index":45,"cn_text":"被你杀死……。","cn_control_tokens":"","cn_utf8_bytes":21,"review_flag":""},{"unique_index":46,"cn_text":"就是她被赋予的职责。","cn_control_tokens":"","cn_utf8_bytes":30,"review_flag":""},{"unique_index":47,"cn_text":"为了军务，她必须<R=背叛,SOMU>自己的战友。","cn_control_tokens":"[\"<R=背叛,SOMU>\"]","cn_utf8_bytes":57,"review_flag":"RUBY_READING_ROMANIZED"},{"unique_index":48,"cn_text":"这是常人根本无法承受的重担。","cn_control_tokens":"","cn_utf8_bytes":42,"review_flag":""},{"unique_index":49,"cn_text":"她将背负着污名被埋葬。","cn_control_tokens":"","cn_utf8_bytes":33,"review_flag":""},{"unique_index":50,"cn_text":"直到后世，人们仍会不断讲述她。","cn_control_tokens":"","cn_utf8_bytes":45,"review_flag":""},{"unique_index":51,"cn_text":"在美国，她会被当作恬不知耻的卖国贼……。","cn_control_tokens":"","cn_utf8_bytes":60,"review_flag":""},{"unique_index":52,"cn_text":"在苏联，她会被当作发射核武器的疯子……。","cn_control_tokens":"","cn_utf8_bytes":60,"review_flag":""},{"unique_index":53,"cn_text":"她将作为罪犯，永远被记录在公开的世界史中。","cn_control_tokens":"","cn_utf8_bytes":63,"review_flag":""},{"unique_index":54,"cn_text":"却永远不会得到任何人的理解……。","cn_control_tokens":"","cn_utf8_bytes":48,"review_flag":""},{"unique_index":55,"cn_text":"那就是The Boss最后的<R=任务,MISSION>。","cn_control_tokens":"[\"<R=任务,MISSION>\"]","cn_utf8_bytes":47,"review_flag":"RUBY_READING_ROMANIZED"},{"unique_index":56,"cn_text":"她出色地完成了自己的<R=任务,MISSION>。","cn_control_tokens":"[\"<R=任务,MISSION>\"]","cn_utf8_bytes":51,"review_flag":"RUBY_READING_ROMANIZED"},{"unique_index":57,"cn_text":"但我想，她唯独希望把真相告诉你。","cn_control_tokens":"","cn_utf8_bytes":48,"review_flag":""},{"unique_index":58,"cn_text":"她希望至少能留在你的记忆里。","cn_control_tokens":"","cn_utf8_bytes":42,"review_flag":""},{"unique_index":59,"cn_text":"不是作为军人，而是作为一个女人。","cn_control_tokens":"","cn_utf8_bytes":48,"review_flag":""},{"unique_index":60,"cn_text":"可是，她被禁止亲口告诉你这一切。","cn_control_tokens":"","cn_utf8_bytes":48,"review_flag":""},{"unique_index":61,"cn_text":"所以，她才把真相告诉了我……。","cn_control_tokens":"","cn_utf8_bytes":45,"review_flag":""},{"unique_index":62,"cn_text":"Snake，这一切不会被记入历史。","cn_control_tokens":"","cn_utf8_bytes":41,"review_flag":""},{"unique_index":63,"cn_text":"也不会被传达给任何人。","cn_control_tokens":"","cn_utf8_bytes":33,"review_flag":""},{"unique_index":64,"cn_text":"只会留在你的心里……。","cn_control_tokens":"","cn_utf8_bytes":33,"review_flag":""},{"unique_index":65,"cn_text":"她的<R=任务报告,DEBRIEFING>。","cn_control_tokens":"[\"<R=任务报告,DEBRIEFING>\"]","cn_utf8_bytes":36,"review_flag":"RUBY_READING_ROMANIZED"},{"unique_index":66,"cn_text":"一切都是为了国家。","cn_control_tokens":"","cn_utf8_bytes":27,"review_flag":""},{"unique_index":67,"cn_text":"为了祖国，她献出了<R=名誉,HONOR>，也献出了生命。","cn_control_tokens":"[\"<R=名誉,HONOR>\"]","cn_utf8_bytes":67,"review_flag":"RUBY_READING_ROMANIZED"},{"unique_index":68,"cn_text":"她才是真正的<R=英雄,HERO>。","cn_control_tokens":"[\"<R=英雄,HERO>\"]","cn_utf8_bytes":36,"review_flag":"RUBY_READING_ROMANIZED"},{"unique_index":69,"cn_text":"她才是真正的<R=爱国者,PATRIOT>。","cn_control_tokens":"[\"<R=爱国者,PATRIOT>\"]","cn_utf8_bytes":42,"review_flag":"RUBY_READING_ROMANIZED"}]}