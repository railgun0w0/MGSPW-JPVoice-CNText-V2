{"file_id":"BRIEFING_FILES_BLOCK_01BCE0","resource_class":"BRIEFING_NBE","status":"TRANSLATED_PENDING_CSV_MERGE","translations":[{"unique_index":0,"cn_text":"听说AI兵器的各个部位，都和AI舱内对应的记忆板联动。","cn_control_tokens":"","cn_utf8_bytes":73,"review_flag":""},{"unique_index":1,"cn_text":"只要破坏部件，对应记忆板的锁就会解除。","cn_control_tokens":"","cn_utf8_bytes":57,"review_flag":""},{"unique_index":2,"cn_text":"这样进入AI舱后，就能拔出对应的记忆板。","cn_control_tokens":"","cn_utf8_bytes":56,"review_flag":""},{"unique_index":3,"cn_text":"不过，被破坏的部件就无法回收再利用了。到底要哪一边，就由你自己决定。","cn_control_tokens":"","cn_utf8_bytes":102,"review_flag":"AUX_TRUNCATED_JPN_DETAIL_RESTORED"}]}