{"file_id":"BRIEFING_FILES_BLOCK_01C2C0","resource_class":"BRIEFING_NBE","status":"TRANSLATED_PENDING_CSV_MERGE","translations":[{"unique_index":0,"cn_text":"目前没有确认到那一带有敌兵。放心专心进行射击训练吧。","cn_control_tokens":"","cn_utf8_bytes":78,"review_flag":"AUX_PARTIAL_JPN_DETAIL_RESTORED"},{"unique_index":1,"cn_text":"别漏掉藏在集装箱和叉车后面的标靶。","cn_control_tokens":"","cn_utf8_bytes":51,"review_flag":""},{"unique_index":2,"cn_text":"标靶都是中距离的，带把突击步枪之类的也许不错。","cn_control_tokens":"","cn_utf8_bytes":69,"review_flag":"AUX_PARTIAL_JPN_DETAIL_RESTORED"},{"unique_index":3,"cn_text":"不过，用什么武器都随你。选你想练习的武器就行。","cn_control_tokens":"","cn_utf8_bytes":69,"review_flag":""}]}