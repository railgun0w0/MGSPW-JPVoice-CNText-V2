{"file_id":"BRIEFING_FILES_BLOCK_02D350","resource_class":"BRIEFING_NBE","status":"TRANSLATED_PENDING_CSV_MERGE","translations":[{"unique_index":0,"cn_text":"Snake，小心这一带的青蛙。","cn_control_tokens":"","cn_utf8_bytes":35,"review_flag":""},{"unique_index":1,"cn_text":"很凶猛吗？放心，蛇不可能被青蛙吃掉。反过来倒有可能……","cn_control_tokens":"","cn_utf8_bytes":81,"review_flag":"AUX_FROG_LEGS_ADDITION_REMOVED;JPN_SNAKE_FROG_PUN_PRIMARY"},{"unique_index":2,"cn_text":"所以才危险啊！它们有毒。","cn_control_tokens":"","cn_utf8_bytes":36,"review_flag":""},{"unique_index":3,"cn_text":"毒？","cn_control_tokens":"","cn_utf8_bytes":6,"review_flag":""},{"unique_index":4,"cn_text":"箭毒蛙一类正如名字所示，身上带毒。毒性强到原住民会用来制作毒箭。","cn_control_tokens":"","cn_utf8_bytes":96,"review_flag":""},{"unique_index":5,"cn_text":"听说有些还会从皮肤分泌毒素，光是碰到就很危险。别因为可爱就把它放到手上。","cn_control_tokens":"","cn_utf8_bytes":108,"review_flag":"AUX_CUTE_HAND_WARNING_RESTORED"},{"unique_index":6,"cn_text":"不能吃吗……","cn_control_tokens":"","cn_utf8_bytes":18,"review_flag":""},{"unique_index":7,"cn_text":"别一副遗憾的样子！","cn_control_tokens":"","cn_utf8_bytes":27,"review_flag":"AUX_WARNING_PARAPHRASE_REPLACED_BY_JPN"}]}