{"file_id":"BRIEFING_FILES_BLOCK_023F00","resource_class":"BRIEFING_NBE","status":"TRANSLATED_PENDING_CSV_MERGE","translations":[{"unique_index":0,"cn_text":"Paz，哥斯达黎加有大型遗迹吗？","cn_control_tokens":"","cn_utf8_bytes":42,"review_flag":""},{"unique_index":1,"cn_text":"卡塔戈东边有个叫瓜亚博的遗迹。虽然规模不算大。","cn_control_tokens":"","cn_utf8_bytes":69,"review_flag":""},{"unique_index":2,"cn_text":"地点不对……还有别的吗？","cn_control_tokens":"","cn_utf8_bytes":36,"review_flag":""},{"unique_index":3,"cn_text":"越过国境，进入尼加拉瓜不远的地方，有一座叫康塞普西翁的要塞。出名的大概就这些。","cn_control_tokens":"","cn_utf8_bytes":117,"review_flag":"PROPER_NOUN_JPN_FORM"},{"unique_index":4,"cn_text":"那我从伊拉苏看到的遗迹到底是……","cn_control_tokens":"","cn_utf8_bytes":48,"review_flag":""},{"unique_index":5,"cn_text":"关于哥斯达黎加的古代文明，还有很多事情尚不清楚。","cn_control_tokens":"","cn_utf8_bytes":72,"review_flag":""},{"unique_index":6,"cn_text":"各地还留有不知道是做什么用的巨大石球。","cn_control_tokens":"","cn_utf8_bytes":57,"review_flag":"AUX_FUNCTION_DETAIL_RESTORED"}]}