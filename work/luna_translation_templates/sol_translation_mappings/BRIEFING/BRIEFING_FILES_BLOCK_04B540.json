{"file_id":"BRIEFING_FILES_BLOCK_04B540","resource_class":"BRIEFING_NBE","status":"TRANSLATED_PENDING_CSV_MERGE","translations":[{"unique_index":0,"cn_text":"轰龙和雄火龙一样，也属于飞龙种。","cn_control_tokens":"","cn_utf8_bytes":48,"review_flag":""},{"unique_index":1,"cn_text":"不过，它也很擅长在地面行动。据说会把岩石撞飞，从远处发动攻击，冲锋的速度也快得惊人。","cn_control_tokens":"","cn_utf8_bytes":126,"review_flag":""},{"unique_index":2,"cn_text":"还有在陆地上的目击记录吗？","cn_control_tokens":"","cn_utf8_bytes":39,"review_flag":""},{"unique_index":3,"cn_text":"据说著名的女海盗Anne和Mary曾经登上过怪物岛。","cn_control_tokens":"","cn_utf8_bytes":62,"review_flag":""},{"unique_index":4,"cn_text":"听说她们就在那里和轰龙打了一场。","cn_control_tokens":"","cn_utf8_bytes":48,"review_flag":""},{"unique_index":5,"cn_text":"Anne好像是个用枪高手。","cn_control_tokens":"","cn_utf8_bytes":31,"review_flag":""},{"unique_index":6,"cn_text":"那一定是场惊人的战斗吧。真想亲眼看看。","cn_control_tokens":"","cn_utf8_bytes":57,"review_flag":""},{"unique_index":7,"cn_text":"我也很擅长用枪，不过……。","cn_control_tokens":"","cn_utf8_bytes":39,"review_flag":""},{"unique_index":8,"cn_text":"知道啦，我知道你有多强！","cn_control_tokens":"","cn_utf8_bytes":36,"review_flag":""}]}