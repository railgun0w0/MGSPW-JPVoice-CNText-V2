{"file_id":"BRIEFING_FILES_BLOCK_01D7E0","resource_class":"BRIEFING_NBE","status":"TRANSLATED_PENDING_CSV_MERGE","translations":[{"unique_index":0,"cn_text":"这是<R= 狙击 ,sniping>任务。别忘了带上狙击步枪。","cn_control_tokens":"<R= 狙击 ,sniping>","cn_utf8_bytes":65,"review_flag":"RUBY_LOCALIZED"},{"unique_index":1,"cn_text":"举起狙击步枪后，就能通过瞄准镜观察。","cn_control_tokens":"","cn_utf8_bytes":54,"review_flag":""},{"unique_index":2,"cn_text":"瞄准镜倍率可以用<I=ZOOMIN>、<I=ZOOMOUT>调整。","cn_control_tokens":"<I=ZOOMIN> <I=ZOOMOUT>","cn_utf8_bytes":57,"review_flag":"CONTROL_TOKENS_PRESERVED"},{"unique_index":3,"cn_text":"不过，使用瞄准镜会让视野变窄。","cn_control_tokens":"","cn_utf8_bytes":45,"review_flag":""},{"unique_index":4,"cn_text":"最好先大致对准方向，再举枪瞄准。","cn_control_tokens":"","cn_utf8_bytes":48,"review_flag":""},{"unique_index":5,"cn_text":"瞄准远距离目标时，哪怕轻微的手抖也会让准星大幅偏移。","cn_control_tokens":"","cn_utf8_bytes":78,"review_flag":""},{"unique_index":6,"cn_text":"不过，只要暂时保持不动、让自己冷静下来，手抖自然就会减轻。","cn_control_tokens":"","cn_utf8_bytes":87,"review_flag":"AUX_PARTIAL_JPN_DETAIL_RESTORED"},{"unique_index":7,"cn_text":"另外，降低姿势也很有效。记住这点。","cn_control_tokens":"","cn_utf8_bytes":51,"review_flag":"AUX_FINAL_REMINDER_RESTORED"}]}