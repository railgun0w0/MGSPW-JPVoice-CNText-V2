{"file_id":"BRIEFING_FILES_BLOCK_020C50","resource_class":"BRIEFING_NBE","status":"TRANSLATED_PENDING_CSV_MERGE","translations":[{"unique_index":0,"cn_text":"视地点而定，敌人会进行多层次的兵力部署。","cn_control_tokens":"","cn_utf8_bytes":60,"review_flag":""},{"unique_index":1,"cn_text":"也有不少敌人会从屋顶或远处地形发动远距离攻击。","cn_control_tokens":"","cn_utf8_bytes":69,"review_flag":""},{"unique_index":2,"cn_text":"别只顾着附近的敌人，免得对远处袭来的攻击毫无防备。","cn_control_tokens":"","cn_utf8_bytes":75,"review_flag":""},{"unique_index":3,"cn_text":"我会小心。","cn_control_tokens":"","cn_utf8_bytes":15,"review_flag":""}]}