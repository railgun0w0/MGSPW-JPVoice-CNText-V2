{"file_id":"BRIEFING_FILES_BLOCK_01D580","resource_class":"BRIEFING_NBE","status":"TRANSLATED_PENDING_CSV_MERGE","translations":[{"unique_index":0,"cn_text":"真正的<R=老兵,veteran>，甚至能用一发子弹干掉多个敌人。","cn_control_tokens":"<R=老兵,veteran>","cn_utf8_bytes":75,"review_flag":"RUBY_LOCALIZED"},{"unique_index":1,"cn_text":"要做到这点，直接射击敌兵是没用的。要利用诱爆。","cn_control_tokens":"","cn_utf8_bytes":69,"review_flag":""},{"unique_index":2,"cn_text":"装着汽油的油桶，或载有燃料的无人兵器……","cn_control_tokens":"","cn_utf8_bytes":60,"review_flag":"AUX_UNMANNED_WEAPON_TERM_JPN_USED"},{"unique_index":3,"cn_text":"射击这种易燃物应该就能引爆。把敌人也卷进爆炸里！","cn_control_tokens":"","cn_utf8_bytes":72,"review_flag":""}]}