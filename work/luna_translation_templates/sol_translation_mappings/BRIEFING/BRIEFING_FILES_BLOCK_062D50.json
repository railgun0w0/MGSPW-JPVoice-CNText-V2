{"file_id":"BRIEFING_FILES_BLOCK_062D50","resource_class":"BRIEFING_NBE","status":"TRANSLATED_PENDING_CSV_MERGE","translations":[{"unique_index":0,"cn_text":"Snake。","cn_control_tokens":"","cn_utf8_bytes":8,"review_flag":""},{"unique_index":1,"cn_text":"怎么了。你喝醉了吗？","cn_control_tokens":"","cn_utf8_bytes":30,"review_flag":""},{"unique_index":2,"cn_text":"想想办法管管那个人。","cn_control_tokens":"","cn_utf8_bytes":30,"review_flag":""},{"unique_index":3,"cn_text":"谁？","cn_control_tokens":"","cn_utf8_bytes":6,"review_flag":""},{"unique_index":4,"cn_text":"Miller先生。","cn_control_tokens":"","cn_utf8_bytes":15,"review_flag":""},{"unique_index":5,"cn_text":"Kaz怎么了？","cn_control_tokens":"","cn_utf8_bytes":15,"review_flag":""},{"unique_index":6,"cn_text":"葡萄酒。","cn_control_tokens":"","cn_utf8_bytes":12,"review_flag":""},{"unique_index":7,"cn_text":"葡萄酒？","cn_control_tokens":"","cn_utf8_bytes":12,"review_flag":""},{"unique_index":8,"cn_text":"他说队员们一直喝啤酒会腻，我就问他要不要换成葡萄酒。","cn_control_tokens":"","cn_utf8_bytes":78,"review_flag":""},{"unique_index":9,"cn_text":"哦，不错啊。","cn_control_tokens":"","cn_utf8_bytes":18,"review_flag":""},{"unique_index":10,"cn_text":"可是啊，法国葡萄酒这两年都歉收。","cn_control_tokens":"","cn_utf8_bytes":48,"review_flag":""},{"unique_index":11,"cn_text":"喂，口水，口水！","cn_control_tokens":"","cn_utf8_bytes":24,"review_flag":""},{"unique_index":12,"cn_text":"谢谢。","cn_control_tokens":"","cn_utf8_bytes":9,"review_flag":""},{"unique_index":13,"cn_text":"然后呢？","cn_control_tokens":"","cn_utf8_bytes":12,"review_flag":""},{"unique_index":14,"cn_text":"大概是天气反常的缘故吧。总之我就劝他，这阵子要买葡萄酒，最好别买法国产的。","cn_control_tokens":"","cn_utf8_bytes":111,"review_flag":""},{"unique_index":15,"cn_text":"哦，原来如此。加州和智利也有好酒嘛。","cn_control_tokens":"","cn_utf8_bytes":54,"review_flag":""},{"unique_index":16,"cn_text":"结果那家伙偏偏去买法国产的，还专挑歉收的72年份，买得整间仓库都是。","cn_control_tokens":"","cn_utf8_bytes":98,"review_flag":""},{"unique_index":17,"cn_text":"啊……原来如此……。","cn_control_tokens":"","cn_utf8_bytes":30,"review_flag":""},{"unique_index":18,"cn_text":"他还说：“怎么样，Cécile，要不要尝尝故乡的味道？”","cn_control_tokens":"","cn_utf8_bytes":73,"review_flag":""},{"unique_index":19,"cn_text":"哦……然后呢？","cn_control_tokens":"","cn_utf8_bytes":21,"review_flag":""},{"unique_index":20,"cn_text":"我有种不祥的预感，所以为了确认味道，就试喝了一下。喝了一次又一次，一次又一次。","cn_control_tokens":"","cn_utf8_bytes":117,"review_flag":""},{"unique_index":21,"cn_text":"哦，那还真辛苦你了。……不过一般品酒不是不该咽下去吗……。","cn_control_tokens":"","cn_utf8_bytes":87,"review_flag":""},{"unique_index":22,"cn_text":"可是无论开多少瓶，不管拿哪一瓶，全都、全部都难喝。","cn_control_tokens":"","cn_utf8_bytes":75,"review_flag":""},{"unique_index":23,"cn_text":"连一瓶好喝的都没有！还说什么故乡的味道……。","cn_control_tokens":"","cn_utf8_bytes":66,"review_flag":""},{"unique_index":24,"cn_text":"……那还真遗憾。","cn_control_tokens":"","cn_utf8_bytes":24,"review_flag":""},{"unique_index":25,"cn_text":"真不敢相信！这么多酒到底怎么办啊！","cn_control_tokens":"","cn_utf8_bytes":51,"review_flag":""},{"unique_index":26,"cn_text":"这里的人根本不在乎味道。","cn_control_tokens":"","cn_utf8_bytes":36,"review_flag":""},{"unique_index":27,"cn_text":"我说啊……Snake先生哟。","cn_control_tokens":"","cn_utf8_bytes":32,"review_flag":""},{"unique_index":28,"cn_text":"干嘛。","cn_control_tokens":"","cn_utf8_bytes":9,"review_flag":""},{"unique_index":29,"cn_text":"你也要说跟Miller先生一样的话吗？","cn_control_tokens":"","cn_utf8_bytes":45,"review_flag":""},{"unique_index":30,"cn_text":"呃。","cn_control_tokens":"","cn_utf8_bytes":6,"review_flag":""},{"unique_index":31,"cn_text":"我一抱怨，那家伙居然若无其事地说：“喝醉不就行了。”","cn_control_tokens":"","cn_utf8_bytes":78,"review_flag":""},{"unique_index":32,"cn_text":"这里的人到底怎么回事，全是一群味觉上的野蛮人！","cn_control_tokens":"","cn_utf8_bytes":69,"review_flag":""},{"unique_index":33,"cn_text":"好好好，乖，乖。","cn_control_tokens":"","cn_utf8_bytes":24,"review_flag":""},{"unique_index":34,"cn_text":"谢谢。你人真好。","cn_control_tokens":"","cn_utf8_bytes":24,"review_flag":""},{"unique_index":35,"cn_text":"啊……是吗。","cn_control_tokens":"","cn_utf8_bytes":18,"review_flag":""},{"unique_index":36,"cn_text":"……我想回巴黎！","cn_control_tokens":"","cn_utf8_bytes":24,"review_flag":""},{"unique_index":37,"cn_text":"……你是不是喝得太多了。","cn_control_tokens":"","cn_utf8_bytes":36,"review_flag":""}]}