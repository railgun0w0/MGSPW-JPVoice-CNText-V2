{"file_id":"BRIEFING_FILES_BLOCK_03D710","resource_class":"BRIEFING_NBE","status":"TRANSLATED_PENDING_CSV_MERGE","translations":[{"unique_index":0,"cn_text":"Snake，你也看到了。","cn_control_tokens":"","cn_utf8_bytes":26,"review_flag":""},{"unique_index":1,"cn_text":"这里一直开阔到远处，简直像足球场一样。","cn_control_tokens":"","cn_utf8_bytes":57,"review_flag":""},{"unique_index":2,"cn_text":"最好用能从远距离狙击的武器。","cn_control_tokens":"","cn_utf8_bytes":42,"review_flag":""},{"unique_index":3,"cn_text":"看来出口不止一个。","cn_control_tokens":"","cn_utf8_bytes":27,"review_flag":""},{"unique_index":4,"cn_text":"是啊。小心别只顾着其中一个地方。","cn_control_tokens":"","cn_utf8_bytes":48,"review_flag":""},{"unique_index":5,"cn_text":"了解。","cn_control_tokens":"","cn_utf8_bytes":9,"review_flag":""},{"unique_index":6,"cn_text":"干掉他们，Snake！","cn_control_tokens":"","cn_utf8_bytes":23,"review_flag":""}]}