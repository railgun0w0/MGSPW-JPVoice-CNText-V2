{"file_id":"BRIEFING_FILES_BLOCK_06E930","resource_class":"BRIEFING_NBE","status":"TRANSLATED_PENDING_CSV_MERGE","translations":[{"unique_index":0,"cn_text":"“Metal Gear”吗……。","cn_control_tokens":"","cn_utf8_bytes":28,"review_flag":""},{"unique_index":1,"cn_text":"怎么突然说这个？","cn_control_tokens":"","cn_utf8_bytes":24,"review_flag":""},{"unique_index":2,"cn_text":"我给你介绍Peace Walker时，你小声念过这个词。我一直在想它是什么意思。","cn_control_tokens":"","cn_utf8_bytes":96,"review_flag":""},{"unique_index":3,"cn_text":"就是字面意思。“金属齿轮”……Granin这么说过。","cn_control_tokens":"","cn_utf8_bytes":66,"review_flag":""},{"unique_index":4,"cn_text":"Granin？","cn_control_tokens":"","cn_utf8_bytes":9,"review_flag":""},{"unique_index":5,"cn_text":"他似乎认为，自己的技术会成为连接步兵与兵器的“金属齿轮”……。","cn_control_tokens":"","cn_utf8_bytes":93,"review_flag":""},{"unique_index":6,"cn_text":"这说法不错。","cn_control_tokens":"","cn_utf8_bytes":18,"review_flag":""},{"unique_index":7,"cn_text":"“Metal Gear”……听起来不错。比“Peace Walker”这种充满欺骗意味的名字好多了。","cn_control_tokens":"","cn_utf8_bytes":106,"review_flag":""}]}