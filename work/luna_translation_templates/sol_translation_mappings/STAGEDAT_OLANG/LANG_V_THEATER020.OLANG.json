{"file_id":"LANG_V_THEATER020.OLANG","resource_class":"STAGEDAT_OLANG","status":"TRANSLATED_PENDING_CSV_MERGE","translations":[{"unique_index":0,"cn_text":"但我们终究会被金钱买下。","cn_control_tokens":"","cn_utf8_bytes":33,"review_flag":"AUXILIARY_SEQUENCE_SHIFTED; JPN_TRANSLATED_DIRECTLY"},{"unique_index":1,"cn_text":"时代决定我们的目的。","cn_control_tokens":"","cn_utf8_bytes":27,"review_flag":"AUXILIARY_SEQUENCE_SHIFTED; JPN_TRANSLATED_DIRECTLY"},{"unique_index":2,"cn_text":"我们是『无国界军队』……","cn_control_tokens":"","cn_utf8_bytes":31,"review_flag":""},{"unique_index":3,"cn_text":"并成为一无所有者的“威慑力”。","cn_control_tokens":"","cn_utf8_bytes":39,"review_flag":""},{"unique_index":4,"cn_text":"正因为有人需要我们，我们才战斗。","cn_control_tokens":"","cn_utf8_bytes":42,"review_flag":"AUXILIARY_ADDS_NO_REASON_TO_FIGHT; JPN_WINS"},{"unique_index":5,"cn_text":"不是为了国家，也不是为了政府。","cn_control_tokens":"","cn_utf8_bytes":36,"review_flag":""},{"unique_index":6,"cn_text":"我们前往需要我们的地方，为我们自己而战。","cn_control_tokens":"","cn_utf8_bytes":51,"review_flag":"AUXILIARY_OMITS_SECOND_CLAUSE; JPN_RESTORED"},{"unique_index":7,"cn_text":"那里没有国家，没有思想，也没有意识形态。","cn_control_tokens":"","cn_utf8_bytes":51,"review_flag":""},{"unique_index":8,"cn_text":"那就是我们的<R=『世外天国』,OUTER HEAVEN>。","cn_control_tokens":"<R=『世外天国』,OUTER HEAVEN>","cn_utf8_bytes":56,"review_flag":"RUBY_DISPLAY_LOCALIZED; CONFIRMED_LATIN_READING_USED"},{"unique_index":9,"cn_text":"既是<R=天国,HEAVEN>，也是<R=地狱,HELL>。","cn_control_tokens":"<R=天国,HEAVEN> | <R=地狱,HELL>","cn_utf8_bytes":48,"review_flag":"RUBY_STRUCTURE_PRESERVED; LATIN_READINGS_USED"},{"unique_index":10,"cn_text":"这里对我们而言，是独一无二的家。","cn_control_tokens":"","cn_utf8_bytes":42,"review_flag":""},{"unique_index":11,"cn_text":"但对我们来说，还有比这里更好的容身之处吗？","cn_control_tokens":"","cn_utf8_bytes":54,"review_flag":""},{"unique_index":12,"cn_text":"没错，我们会堕入地狱。","cn_control_tokens":"","cn_utf8_bytes":30,"review_flag":""},{"unique_index":13,"cn_text":"如果时代需要，我们或许会协助各种革命、犯罪，\n甚至恐怖活动。","cn_control_tokens":"","cn_utf8_bytes":67,"review_flag":"AUXILIARY_SEQUENCE_SHIFTED; JPN_TRANSLATED_DIRECTLY"},{"unique_index":14,"cn_text":"彼此舍弃祖国，与这颗星球融为一体。","cn_control_tokens":"","cn_utf8_bytes":45,"review_flag":"JPN_SAYS_PLANET; AUXILIARY_EARTH/LAND_NUANCE_NOT_FORCED"},{"unique_index":15,"cn_text":"我们舍弃国家。","cn_control_tokens":"","cn_utf8_bytes":21,"review_flag":""}]}