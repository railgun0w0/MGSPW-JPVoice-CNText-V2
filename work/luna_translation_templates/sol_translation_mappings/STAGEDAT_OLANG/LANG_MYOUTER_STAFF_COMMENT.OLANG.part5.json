{"file_id":"LANG_MYOUTER_STAFF_COMMENT.OLANG","resource_class":"STAGEDAT_OLANG","part":5,"range":"200-249","status":"TRANSLATED_PENDING_CSV_MERGE","translations":[{"unique_index":200,"cn_text":"“Boss，我一直有件事想对你说……不，没什么。”","cn_control_tokens":"","cn_utf8_bytes":67,"review_flag":""},{"unique_index":201,"cn_text":"“只要我认真起来，那种任务……”","cn_control_tokens":"","cn_utf8_bytes":48,"review_flag":"AUX_EYES_CLOSED_EXPANSION_REJECTED"},{"unique_index":202,"cn_text":"“你就待在这里。下一个任务由我来解决。”","cn_control_tokens":"","cn_utf8_bytes":60,"review_flag":""},{"unique_index":203,"cn_text":"（不能大声说，不过MSF差不多就是靠我撑着的……）","cn_control_tokens":"","cn_utf8_bytes":69,"review_flag":"JPN_MSFSUPPORT_BOAST_PRESERVED"},{"unique_index":204,"cn_text":"“能见到Boss，真、真是我的荣幸！”","cn_control_tokens":"","cn_utf8_bytes":49,"review_flag":""},{"unique_index":205,"cn_text":"“能得到Boss的认可并留在这里，我感到很自豪！”","cn_control_tokens":"","cn_utf8_bytes":67,"review_flag":"JPN_BOSS_RECOGNITION_PRESERVED"},{"unique_index":206,"cn_text":"“我是前<R=ＳＡＳ,Special Air Service>队员……你觉得我是在吹牛吗？”","cn_control_tokens":"<R=ＳＡＳ,Special Air Service>","cn_utf8_bytes":86,"review_flag":"JPN_RUBY_PRESERVED"},{"unique_index":207,"cn_text":"“你真是太利落了！”","cn_control_tokens":"","cn_utf8_bytes":30,"review_flag":"SMART_NUANCE_LOCALIZED_WITHOUT_LITERAL_INTELLIGENCE_EXPANSION"},{"unique_index":208,"cn_text":"“辛苦了。我做了道新菜，要不要尝尝？”","cn_control_tokens":"","cn_utf8_bytes":51,"review_flag":"AUX_WELCOME_BACK_DINNER_EXPANSION_REJECTED"},{"unique_index":209,"cn_text":"“有时候我甚至会觉得，伟大的研究比人的生命更重要。”","cn_control_tokens":"","cn_utf8_bytes":75,"review_flag":"JPN_RESEARCH_OUTWEIGHS_LIFE_SEMANTICS_PRESERVED"},{"unique_index":210,"cn_text":"“能和你一起战斗，真是太好了……”","cn_control_tokens":"","cn_utf8_bytes":51,"review_flag":""},{"unique_index":211,"cn_text":"“提高士兵士气的方法？\n那很简单！‘家人的来信’和‘热乎乎的饭菜’，吃饭可是很重要的！”","cn_control_tokens":"","cn_utf8_bytes":120,"review_flag":"JPN_FAMILY_LETTERS_AND_HOT_MEALS_PRESERVED"},{"unique_index":212,"cn_text":"“今天的饭也很好吃！”","cn_control_tokens":"","cn_utf8_bytes":33,"review_flag":""},{"unique_index":213,"cn_text":"“Boss，希望我们的技术哪怕能帮上你一点忙……”","cn_control_tokens":"","cn_utf8_bytes":61,"review_flag":"AUX_SUBJECT_OBJECT_REVERSAL_REJECTED; JPN_OUR_TECH_HELPS_BOSS_PRESERVED"},{"unique_index":214,"cn_text":"“你的背后就交给我吧！”","cn_control_tokens":"","cn_utf8_bytes":36,"review_flag":""},{"unique_index":215,"cn_text":"“‘战友’这种东西……真不错啊。”","cn_control_tokens":"","cn_utf8_bytes":42,"review_flag":"AUX_BATTLEFIELD_EXPANSION_REJECTED"},{"unique_index":216,"cn_text":"“Boss，来到这里真是太好了……”","cn_control_tokens":"","cn_utf8_bytes":43,"review_flag":""},{"unique_index":217,"cn_text":"“Boss！我抓到了一只据说是世界最重昆虫的雄性Elephas象甲！”","cn_control_tokens":"","cn_utf8_bytes":77,"review_flag":"ELEPHAS_BEETLE_TERM_PRESERVED_FOR_REVIEW"},{"unique_index":218,"cn_text":"“我要在这里闯出名堂！”","cn_control_tokens":"","cn_utf8_bytes":36,"review_flag":""},{"unique_index":219,"cn_text":"（我不太擅长说话……很期待你的表现，Boss……）","cn_control_tokens":"","cn_utf8_bytes":68,"review_flag":"AUX_SHY_AND_BELIEVE_EXPANSION_REJECTED; JPN_EXPECTATION_PRESERVED"},{"unique_index":220,"cn_text":"“肌肉，绝不会，背叛我。”","cn_control_tokens":"","cn_utf8_bytes":39,"review_flag":""},{"unique_index":221,"cn_text":"“你就像一把出鞘的刀啊。”","cn_control_tokens":"","cn_utf8_bytes":39,"review_flag":""},{"unique_index":222,"cn_text":"“Boss，你是先吃喜欢的东西，还是把喜欢的东西留到最后吃？”","cn_control_tokens":"","cn_utf8_bytes":82,"review_flag":""},{"unique_index":223,"cn_text":"“我……其实不想战斗。我想当厨师。”","cn_control_tokens":"","cn_utf8_bytes":51,"review_flag":""},{"unique_index":224,"cn_text":"“凡事还是普通最好。”","cn_control_tokens":"","cn_utf8_bytes":30,"review_flag":""},{"unique_index":225,"cn_text":"“快点给我任务吧！我的爱枪都要生锈了。”","cn_control_tokens":"","cn_utf8_bytes":60,"review_flag":"JPN_BELOVED_GUN_PRESERVED"},{"unique_index":226,"cn_text":"“按我的星座运势，今天的运气是……还算不错吧。”","cn_control_tokens":"","cn_utf8_bytes":69,"review_flag":""},{"unique_index":227,"cn_text":"“来，打起精神上吧！”","cn_control_tokens":"","cn_utf8_bytes":33,"review_flag":"JPN_SLING_TONE_LOCALIZED; AUX_BALLS_TO_THE_WALL_NOT_LITERAL"},{"unique_index":228,"cn_text":"“你能驾驭得了我吗……？”","cn_control_tokens":"","cn_utf8_bytes":39,"review_flag":""},{"unique_index":229,"cn_text":"“今晚喝一杯怎么样？我请客。”","cn_control_tokens":"","cn_utf8_bytes":42,"review_flag":""},{"unique_index":230,"cn_text":"“先说一声，我是那种越被夸越能进步的人。”","cn_control_tokens":"","cn_utf8_bytes":60,"review_flag":""},{"unique_index":231,"cn_text":"“我看得出来。\n你也不是因为喜欢才去射那些铅弹的吧？”","cn_control_tokens":"","cn_utf8_bytes":78,"review_flag":"AUX_HOT_LEAD_IDIOM_NOT_FORCED"},{"unique_index":232,"cn_text":"“我还没有真正认可你呢。”","cn_control_tokens":"","cn_utf8_bytes":39,"review_flag":"JPN_NOT_YET_RECOGNIZED_PRESERVED"},{"unique_index":233,"cn_text":"“我……等这场战斗结束，就回故乡结婚……”","cn_control_tokens":"","cn_utf8_bytes":63,"review_flag":"AUX_FIND_A_WIFE_EXPANSION_REJECTED; JPN_RETURN_AND_MARRY_PRESERVED"},{"unique_index":234,"cn_text":"“我以前是参加过世界大赛的体操选手。\n不过一旦到了战争里，荣誉和自尊也就都没关系了。”","cn_control_tokens":"","cn_utf8_bytes":123,"review_flag":""},{"unique_index":235,"cn_text":"“枪会杀人？可也有些生命，没有枪就保护不了。”","cn_control_tokens":"","cn_utf8_bytes":66,"review_flag":"JPN_LIVES_ONLY_GUNS_CAN_PROTECT_PRESERVED"},{"unique_index":236,"cn_text":"“该干的活我也干够工资那份了，睡个午觉吧……”","cn_control_tokens":"","cn_utf8_bytes":66,"review_flag":""},{"unique_index":237,"cn_text":"“随时都能出发，Boss。”","cn_control_tokens":"","cn_utf8_bytes":31,"review_flag":""},{"unique_index":238,"cn_text":"“这味道……是血的味道吗……而且是大量鲜血的味道……”","cn_control_tokens":"","cn_utf8_bytes":81,"review_flag":""},{"unique_index":239,"cn_text":"“你真的会潜行吗？\n火药味也太重了！”","cn_control_tokens":"","cn_utf8_bytes":51,"review_flag":"AUX_MILE_AWAY_EXPANSION_REJECTED"},{"unique_index":240,"cn_text":"“我们应该不止这点本事。”","cn_control_tokens":"","cn_utf8_bytes":39,"review_flag":""},{"unique_index":241,"cn_text":"“光说漂亮话可打不了战争……\n你也是这样吧？”","cn_control_tokens":"","cn_utf8_bytes":63,"review_flag":"AUX_GET_HANDS_DIRTY_IDIOM_NOT_FORCED"},{"unique_index":242,"cn_text":"“你还挺有用的嘛。以后我也继续帮你。”","cn_control_tokens":"","cn_utf8_bytes":54,"review_flag":""},{"unique_index":243,"cn_text":"“嘿嘿，要是像你这样的人当上国家最高领导……\n我的村子也许就不会被烧掉了。”","cn_control_tokens":"","cn_utf8_bytes":102,"review_flag":"JPN_VILLAGE_BURNING_CAUSE_PRESERVED"},{"unique_index":244,"cn_text":"“我不觉得力量只来自武器，不过还是给我们配点好装备吧。”","cn_control_tokens":"","cn_utf8_bytes":78,"review_flag":""},{"unique_index":245,"cn_text":"“遗憾的是，对科学技术发展贡献最大的，正是‘战争’。”","cn_control_tokens":"","cn_utf8_bytes":72,"review_flag":""},{"unique_index":246,"cn_text":"“你还挺能干的嘛。我对你刮目相看了。”","cn_control_tokens":"","cn_utf8_bytes":54,"review_flag":""},{"unique_index":247,"cn_text":"“哥斯达黎加湿地很多……袜子请多发一些。\n脚气会拖慢行军速度。”","cn_control_tokens":"","cn_utf8_bytes":87,"review_flag":"JPN_ATHLETES_FOOT_AND_MARCH_SPEED_PRESERVED"},{"unique_index":248,"cn_text":"“有牙医吗？\n听说我父亲那一代的军队里，总会有牙医随军。”","cn_control_tokens":"","cn_utf8_bytes":81,"review_flag":"AUX_EVERY_BATTALION_EXPANSION_REJECTED"},{"unique_index":249,"cn_text":"“我以前是军官候补生。虽然经验尚浅，但会说七种语言。\n有什么能让我帮上忙的吗？”","cn_control_tokens":"","cn_utf8_bytes":108,"review_flag":"JPN_OFFICER_CANDIDATE_AND_SEVEN_LANGUAGES_PRESERVED"}]}