ue_index":21,"cn_text":"/DESCEND","review_flag":"FIXED_ASCII_UI_LABEL_PRESERVED"},{"unique_index":22,"cn_text":"/ASCEND","review_flag":"FIXED_ASCII_UI_LABEL_PRESERVED"},{"unique_index":23,"cn_text":"LV.","review_flag":"FIXED_ASCII_UI_LABEL_PRESERVED"},{"unique_index":24,"cn_text":"LV.%d","review_flag":"PRINTF_%d_PRESERVED"},{"unique_index":25,"cn_text":"NUMBER OF STAFF","review_flag":"FIXED_ASCII_UI_LABEL_PRESERVED"},{"unique_index":26,"cn_text":"LIST-MODE","review_flag":"FIXED_ASCII_UI_LABEL_PRESERVED"},{"unique_index":27,"cn_text":"  (INSERT)","review_flag":"SOURCE_LEADING_SPACES_PRESERVED"},{"unique_index":28,"cn_text":"LEVEL","review_flag":"FIXED_ASCII_UI_LABEL_PRESERVED"},{"unique_index":29,"cn_text":"  (AUTO ASSIGN)","review_flag":"SOURCE_LEADING_SPACES_PRESERVED"},{"unique_index":30,"cn_text":"要进行《METAL GEAR ZEKE开发》的教程吗？"},{"unique_index":31,"cn_text":"要进行《纸箱收发》的教程吗？","review_flag":"JPN_ダンボール送受信_PRESERVED; AUX_DELIVERY_SERVICE_PARAPHRASE_NOT_FORCED"},{"unique_index":32,"cn_text":"要进行《佣兵派遣》的教程吗？","review_flag":"JPN_傭兵派遣_PRESERVED; AUX_OUTER_OPS_PARAPHRASE_NOT_FORCED"},{"unique_index":33,"cn_text":"要进行《武器与道具开发》的教程吗？"},{"unique_index":34,"cn_text":"要进行《情报班》的教程吗？"},{"unique_index":35,"cn_text":"要进行《医疗班与医务室》的教程吗？","review_flag":"JPN_診療所_CLAUSE_PRESERVED; AUX_MEDICAL_TEAM_ONLY_TRUNCATION_REJECTED"},{"unique_index":36,"cn_text":"要进行《粮食班》的教程吗？"},{"unique_index":37,"cn_text":"要进行《人员分配》的教程吗？"},{"unique_index":38,"cn_text":"教程到此结束。"},{"unique_index":39,"cn_text":"另外，如果士气降得太低，人员还会叛逃。请注意。"},{"unique_index":40,"cn_text":"士气低落的人员将无法发挥原本的能力。"},{"unique_index":41,"cn_text":"反之，当“FOOD”低于100%时，人员士气会逐渐下降。"},{"unique_index":42,"cn_text":"士气高昂的人员将能发挥超越原本水平的能力。"},{"unique_index":43,"cn_text":"当“FOOD”达到100%以上时，表示所有人员都能获得充足食物，人员士气会上升。"},{"unique_index":44,"cn_text":"此外，当前食物是否足以供应所有人员，会以“FOOD（粮食供给率）”显示。","review_flag":"JPN_FOOD_SUPPLY_MEANING_PRESERVED; AUX_HOT_MEALS_PARAPHRASE_NOT_FORCED"},{"unique_index":45,"cn_text":"“粮食班”等级越高，就能开发等级更高的恢复道具。"},{"unique_index":46,"cn_text":"“粮食班”负责管理整个Mother Base的粮食。"},{"unique_index":47,"cn_text":"#关于“医疗班”","review_flag":"SOURCE_HASH_HEADING_PRESERVED"},{"unique_index":48,"cn_text":"使用确认按钮指定要分配到的班组。"},{"unique_index":49,"cn_text":"按□按钮选择要分配的士兵。"},{"unique_index":50,"cn_text":"招募更优秀的士兵并合理分配，让Mother Base不断发展吧。"},{"unique_index":51,"cn_text":"也可以逐个指定士兵进行分配。"},{"unique_index":52,"cn_text":"由于人员分配使“研发班”等级提升，现在可以开发新的武器和道具了。"},{"unique_index":53,"cn_text":"执行“AUTO ASSIGN”后，会根据各自能力，将“等待室”的士兵自动分配到合适的班组。"},{"unique_index":54,"cn_text":"可进行分配的士兵都属于“等待室”。"},{"unique_index":55,"cn_text":"那么，实际试着分配士兵吧。"},{"unique_index":56,"cn_text":"将士兵分配到各班组并提升班组等级后，就能开发新的武器和道具。"},{"unique_index":57,"cn_text":"Mother Base由战斗班、研发班、等待室等多个班组构成。","review_flag":"JPN_WAITING_ROOM_PRESERVED; AUX_MEDICAL_TEAM_SUBSTITUTION_REJECTED"},{"unique_index":58,"cn_text":"正在等待对方选完人员。"},{"unique_index":59,"cn_text":"如果没有问题，请按确认按钮。"},{"unique_index":60,"cn_text":"请选择想招募为同伴的人员。"},{"unique_index":61,"cn_text":"可以选择人员并分配到班组。被分配到班组的人员会以各种方式支援任务。可在任务中通过富尔顿回收等方式增加人员数量。"},{"unique_index":62,"cn_text":"志愿兵"},{"unique_index":63,"cn_text":"交易人员"},{"unique_index":64,"cn_text":"前战俘"},{"unique_index":65,"cn_text":"军人","review_flag":"JPN_GENERIC_軍人_PRESERVED; AUX_ORDINARY_SOLDIER_EXPANSION_NOT_FORCED"},{"unique_index":66,"cn_text":"男性"},{"unique_index":67,"cn_text":"女性"},{"unique_index":68,"cn_text":"联动","review_flag":"COLLABORATION_CATEGORY_TRANSLATED_FROM_JPN"},{"unique_index":69,"cn_text":"负伤"},{"unique_index":70,"cn_text":"步行速度"},{"unique_index":71,"cn_text":"设置能力"},{"unique_index":72,"cn_text":"投掷能力"},{"unique_index":73,"cn_text":"精神值"},{"unique_index":74,"cn_text":"感知能力","review_flag":"TERMINOLOGY_REVIEW_センス"}],"notes":["JPN is authoritative. Fixed ASCII UI labels/codes remain unchanged; Japanese user-facing text is localized.","<SKILL>, <BAD STATE>, <PARAMETER>, %d and source spacing are preserved exactly where present.","JPN-specific tutorial/team wording overrides auxiliary paraphrases or omissions, including 医療班と診療所 and the Waiting Room in Mother Base composition.","No production/build files are modified."]}