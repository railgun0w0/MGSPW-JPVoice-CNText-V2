{"file_id":"LANG_WEAPON_TEXT.OLANG","resource_class":"STAGEDAT_OLANG","part":4,"range":"150-199","status":"TRANSLATED_PENDING_CSV_MERGE","translations":[{"unique_index":150,"cn_text":"大口径通用机枪。\n在保持大装弹量和穿甲弹带来的高战斗力的同时，\n缩短的枪管也改善了操控性。","cn_control_tokens":"","cn_utf8_bytes":131,"review_flag":""},{"unique_index":151,"cn_text":"内置消音器、发射气力恢复弹的\n特殊手枪。非杀伤武器。改良后\n气力恢复量增加。","cn_control_tokens":"","cn_utf8_bytes":110,"review_flag":"JPN_気力_RECOVERY_TERM_PRESERVED"},{"unique_index":152,"cn_text":"大口径通用机枪。\n虽然因重量大而依然难以操控，\n但使用穿甲弹后也成为对付装甲车辆的\n有效武器。","cn_control_tokens":"","cn_utf8_bytes":135,"review_flag":""},{"unique_index":153,"cn_text":"大口径通用机枪。\n装弹量大，可以持续保持高火力。\n另一方面因重量大而难以操控。","cn_control_tokens":"","cn_utf8_bytes":113,"review_flag":""},{"unique_index":154,"cn_text":"苏联制突击步枪。\n按住瞄准键瞄准，按攻击键开火。","cn_control_tokens":"","cn_utf8_bytes":70,"review_flag":"AUX_EMPTY_TRANSLATED_FROM_JPN"},{"unique_index":155,"cn_text":"小型轻量卡宾枪。\n按住瞄准键瞄准，按攻击键开火。","cn_control_tokens":"","cn_utf8_bytes":70,"review_flag":"AUX_EMPTY_TRANSLATED_FROM_JPN"},{"unique_index":156,"cn_text":"新型轻量突击步枪。\n配备消音器。\n按住瞄准键瞄准，按攻击键开火。","cn_control_tokens":"","cn_utf8_bytes":92,"review_flag":""},{"unique_index":157,"cn_text":"新型轻量突击步枪。\n按住瞄准键瞄准，按攻击键开火。","cn_control_tokens":"","cn_utf8_bytes":73,"review_flag":""},{"unique_index":158,"cn_text":"火绳枪。\n弹丸命中后，有一定概率\n发生不可思议的事情。","cn_control_tokens":"","cn_utf8_bytes":77,"review_flag":""},{"unique_index":159,"cn_text":"试作无壳式突击步枪。\n低后坐力弹药使其容易瞄准，\n但另一方面威力较低。","cn_control_tokens":"","cn_utf8_bytes":101,"review_flag":""},{"unique_index":160,"cn_text":"无托式突击步枪。\n威力中等，但结构紧凑、\n易于操控，后坐力也较低。","cn_control_tokens":"","cn_utf8_bytes":95,"review_flag":""},{"unique_index":161,"cn_text":"大口径突击步枪。\n弹药威力大，AUTO AIM范围也很广。\n配备激光瞄准器后更容易瞄准。","cn_control_tokens":"","cn_utf8_bytes":112,"review_flag":""},{"unique_index":162,"cn_text":"大口径突击步枪。\n弹药威力大，AUTO AIM范围也很广。\n缩短枪管后操控性也有所改善。","cn_control_tokens":"","cn_utf8_bytes":112,"review_flag":""},{"unique_index":163,"cn_text":"大口径突击步枪。\n虽然操控性较差，但弹药威力大，\nAUTO AIM范围也很广。","cn_control_tokens":"","cn_utf8_bytes":97,"review_flag":""},{"unique_index":164,"cn_text":"内置消音器、发射气力恢复弹的\n特殊手枪。非杀伤武器。由于是试作品，\n气力恢复量较低。","cn_control_tokens":"","cn_utf8_bytes":122,"review_flag":"JPN_気力_RECOVERY_TERM_PRESERVED"},{"unique_index":165,"cn_text":"苏联制轻机枪。\n长枪管使后坐力较低，但操控性较差。\n大威力弹药可有效阻止敌人行动。\n弹匣容量增加型。","cn_control_tokens":"","cn_utf8_bytes":144,"review_flag":""},{"unique_index":166,"cn_text":"苏联制轻机枪。\n长枪管使后坐力较低，但操控性较差。\n大威力弹药可有效阻止敌人行动。","cn_control_tokens":"","cn_utf8_bytes":119,"review_flag":""},{"unique_index":167,"cn_text":"罗马尼亚制突击步枪。\n枪托配备后坐力缓冲装置，\n在保持大威力的同时减轻了后坐力。","cn_control_tokens":"","cn_utf8_bytes":116,"review_flag":""},{"unique_index":168,"cn_text":"罗马尼亚制突击步枪。\n威力很大，但后坐力也很强。\n配备前握把，命中精度良好。\n","cn_control_tokens":"","cn_utf8_bytes":111,"review_flag":"TRAILING_NEWLINE_PRESERVED"},{"unique_index":169,"cn_text":"苏联制突击步枪。\n配备烟雾榴弹发射器。\n按R键切换（猎手操作类型按<I=RIGH>）。","cn_control_tokens":"<I=RIGH>","cn_utf8_bytes":107,"review_flag":"CONTROL_ICON_PRESERVED"},{"unique_index":170,"cn_text":"苏联制突击步枪。\n配备榴弹发射器。切换时按\nR键（猎手操作类型按<I=RIGH>）。","cn_control_tokens":"<I=RIGH>","cn_utf8_bytes":104,"review_flag":"CONTROL_ICON_AND_JPN_LINE_LAYOUT_PRESERVED"},{"unique_index":171,"cn_text":"苏联制突击步枪。\n大威力可有效阻止敌人行动，\n但强烈后坐力使命中精度较低。","cn_control_tokens":"","cn_utf8_bytes":107,"review_flag":""},{"unique_index":172,"cn_text":"以高压电击使目标昏厥的非杀伤武器。\n按住<I=ATK>期间电击会持续。\n使用次数越多，威力越高。","cn_control_tokens":"<I=ATK>","cn_utf8_bytes":126,"review_flag":"CONTROL_ICON_PRESERVED"},{"unique_index":173,"cn_text":"M653(烟雾榴弹)","cn_control_tokens":"","cn_utf8_bytes":18,"review_flag":"WEAPON_DISPLAY_NAME_LOCALIZED_FROM_JPN"},{"unique_index":174,"cn_text":"M653(装备霰弹枪)","cn_control_tokens":"","cn_utf8_bytes":21,"review_flag":"WEAPON_DISPLAY_NAME_LOCALIZED_FROM_JPN"},{"unique_index":175,"cn_text":"M653(装备榴弹发射器)","cn_control_tokens":"","cn_utf8_bytes":27,"review_flag":"WEAPON_DISPLAY_NAME_LOCALIZED_FROM_JPN"},{"unique_index":176,"cn_text":"M653","cn_control_tokens":"","cn_utf8_bytes":4,"review_fl