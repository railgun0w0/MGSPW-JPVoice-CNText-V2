flag":""},{"unique_index":130,"cn_text":"与其他玩家进行对战。","cn_control_tokens":"","cn_utf8_bytes":30,"review_flag":""},{"unique_index":131,"cn_text":"确定","cn_control_tokens":"","cn_utf8_bytes":6,"review_flag":""},{"unique_index":132,"cn_text":"教程","cn_control_tokens":"","cn_utf8_bytes":6,"review_flag":""},{"unique_index":133,"cn_text":"关于人员分配","cn_control_tokens":"","cn_utf8_bytes":18,"review_flag":""},{"unique_index":134,"cn_text":"招募更优秀的士兵，并合理安排人员，\n发展Mother Base吧。","cn_control_tokens":"","cn_utf8_bytes":75,"review_flag":""},{"unique_index":135,"cn_text":"在“等候室”执行“AUTO ASSIGN”后，\n会根据士兵各自的能力自动分配到相应班组。","cn_control_tokens":"","cn_utf8_bytes":108,"review_flag":""},{"unique_index":136,"cn_text":"将可以开发新的武器和道具。","cn_control_tokens":"","cn_utf8_bytes":39,"review_flag":"AUX_OVER_TIME_ADDITION_REJECTED"},{"unique_index":137,"cn_text":"通过将人员分配到各班组并提高班组等级，","cn_control_tokens":"","cn_utf8_bytes":57,"review_flag":"SOURCE_SENTENCE_FRAGMENT_PRESERVED"},{"unique_index":138,"cn_text":"Mother Base由实战部队、研究开发班、等候室等\n多个班组构成。","cn_control_tokens":"","cn_utf8_bytes":81,"review_flag":""},{"unique_index":139,"cn_text":"关于情报班","cn_control_tokens":"","cn_utf8_bytes":15,"review_flag":""},{"unique_index":140,"cn_text":"还可以了解该任务中出现的敌人和俘虏信息。","cn_control_tokens":"","cn_utf8_bytes":60,"review_flag":""},{"unique_index":141,"cn_text":"此外，在出击执行任务时，","cn_control_tokens":"","cn_utf8_bytes":36,"review_flag":"SOURCE_SENTENCE_FRAGMENT_PRESERVED"},{"unique_index":142,"cn_text":"“情报班”等级越高，送来的支援物资越充实，\n也能进行更强力的支援炮击。","cn_control_tokens":"","cn_utf8_bytes":103,"review_flag":""},{"unique_index":143,"cn_text":"要获得支援，请使用“支援补给标记”。","cn_control_tokens":"","cn_utf8_bytes":54,"review_flag":"AUX_SUPPORT_STRIKE_MARKER_ADDITION_REJECTED"},{"unique_index":144,"cn_text":"“情报班”负责为任务提供物资支援或炮击支援。","cn_control_tokens":"","cn_utf8_bytes":66,"review_flag":""},{"unique_index":145,"cn_text":"关于佣兵派遣","cn_control_tokens":"","cn_utf8_bytes":18,"review_flag":""},{"unique_index":146,"cn_text":"只要暂时从编队中移除，就会自动恢复。","cn_control_tokens":"","cn_utf8_bytes":54,"review_flag":"SOURCE_SENTENCE_FRAGMENT_PRESERVED"},{"unique_index":147,"cn_text":"在战斗中受损的大型兵器，","cn_control_tokens":"","cn_utf8_bytes":36,"review_flag":"SOURCE_SENTENCE_FRAGMENT_PRESERVED"},{"unique_index":148,"cn_text":"随着推进“MAIN OPS”或“EXTRA OPS”使时间经过，\n战斗会结束。","cn_control_tokens":"","cn_utf8_bytes":81,"review_flag":"AUX_BATTLE_WILL_TAKE_PLACE_ERROR_REJECTED"},{"unique_index":149,"cn_text":"但是，如果战斗失败，士兵可能受伤，有时甚至会死亡。\n请注意。","cn_control_tokens":"","cn_utf8_bytes":88,"review_flag":"JPN_EXPLICIT_DEATH_PRESERVED; AUX_EUPHEMISM_REJECTED"}]}