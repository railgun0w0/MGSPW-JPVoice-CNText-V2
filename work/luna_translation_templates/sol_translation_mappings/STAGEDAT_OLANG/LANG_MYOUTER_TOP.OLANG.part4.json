{"file_id":"LANG_MYOUTER_TOP.OLANG","resource_class":"STAGEDAT_OLANG","part":4,"range":"150-201","status":"TRANSLATED_PENDING_CSV_MERGE","translations":[{"unique_index":150,"cn_text":"此外，还可能获得各地的报酬和新士兵。","cn_control_tokens":"","cn_utf8_bytes":54,"review_flag":""},{"unique_index":151,"cn_text":"战斗胜利后，士兵会成长，并能获得更多GMP。","cn_control_tokens":"","cn_utf8_bytes":60,"review_flag":""},{"unique_index":152,"cn_text":"请将实战部队成员和大型兵器编成派遣部队并出击。","cn_control_tokens":"","cn_utf8_bytes":69,"review_flag":""},{"unique_index":153,"cn_text":"在“OUTER OPS”中，会向冲突地区派遣部队进行战斗行动。","cn_control_tokens":"","cn_utf8_bytes":75,"review_flag":""},{"unique_index":154,"cn_text":"关于“METAL GEAR ZEKE”的开发","cn_control_tokens":"","cn_utf8_bytes":36,"review_flag":""},{"unique_index":155,"cn_text":"根据不同的AI兵器，可以获得喷气背包、附加装甲等\n强力装备。","cn_control_tokens":"","cn_utf8_bytes":84,"review_flag":""},{"unique_index":156,"cn_text":"通过从各种AI兵器收集素材部件，\n可以推进“METAL GEAR ZEKE”的开发。","cn_control_tokens":"","cn_utf8_bytes":90,"review_flag":""},{"unique_index":157,"cn_text":"完成“METAL GEAR ZEKE”后，可将其作为强力兵器\n派往“OUTER OPS”等任务。","cn_control_tokens":"","cn_utf8_bytes":94,"review_flag":""},{"unique_index":158,"cn_text":"在“METAL GEAR”中，\n可以开发双足步行兵器“METAL GEAR ZEKE”。","cn_control_tokens":"","cn_utf8_bytes":80,"review_flag":""},{"unique_index":159,"cn_text":"关于医疗班与诊疗所","cn_control_tokens":"","cn_utf8_bytes":27,"review_flag":""},{"unique_index":160,"cn_text":"此外，“医疗班”等级越高，\n就能开发更高Rank的麻醉枪。","cn_control_tokens":"","cn_utf8_bytes":77,"review_flag":""},{"unique_index":161,"cn_text":"而且，被送往“诊疗所”后的治疗速度也会提高。","cn_control_tokens":"","cn_utf8_bytes":66,"review_flag":""},{"unique_index":162,"cn_text":"“医疗班”等级越高，\n越能降低疾病发生的频率。","cn_control_tokens":"","cn_utf8_bytes":67,"review_flag":""},{"unique_index":163,"cn_text":"将无法发挥原本的能力，并会自动被送往“诊疗所”。","cn_control_tokens":"","cn_utf8_bytes":72,"review_flag":"SOURCE_SENTENCE_FRAGMENT_CONTEXT_PRESERVED"},{"unique_index":164,"cn_text":"生病或受伤的士兵，","cn_control_tokens":"","cn_utf8_bytes":27,"review_flag":"SOURCE_SENTENCE_FRAGMENT_PRESERVED"},{"unique_index":165,"cn_text":"关于食粮班","cn_control_tokens":"","cn_utf8_bytes":15,"review_flag":""},{"unique_index":166,"cn_text":"通过向“食粮班”分配人员，可以提高“FOOD”。","cn_control_tokens":"","cn_utf8_bytes":64,"review_flag":"AUX_GENERALIZATION_REJECTED; JPN_FOOD_MECHANIC_PRESERVED"},{"unique_index":167,"cn_text":"士兵的士气会下降，并可能“叛逃”。","cn_control_tokens":"","cn_utf8_bytes":51,"review_flag":""},{"unique_index":168,"cn_text":"相反，如果食粮供给率低于100%，","cn_control_tokens":"","cn_utf8_bytes":43,"review_flag":"SOURCE_SENTENCE_FRAGMENT_PRESERVED"},{"unique_index":169,"cn_text":"当食粮供给率超过100%时，士兵士气会上升，\n并能发挥超出原本水平的能力。","cn_control_tokens":"","cn_utf8_bytes":101,"review_flag":""},{"unique_index":170,"cn_text":"随着Mother Base人员增加，需要提供适量食粮。\n当前食粮状况由右上角的“FOOD”表示。","cn_control_tokens":"","cn_utf8_bytes":112,"review_flag":""},{"unique_index":171,"cn_text":"教程到此结束。","cn_control_tokens":"","cn_utf8_bytes":21,"review_flag":""},{"unique_index":172,"cn_text":"关于武器和道具的开发","cn_control_tokens":"","cn_utf8_bytes":30,"review_flag":""},{"unique_index":173,"cn_text":"请通过开发强力的武器和道具，\n帮助完成更困难的任务。","cn_control_tokens":"","cn_utf8_bytes":76,"review_flag":"JPN_ASSIST_DIFFICULT_MISSIONS_PRESERVED"},{"unique_index":174,"cn_text":"如果GMP不足，开发会停止。\n请注意。","cn_control_tokens":"","cn_utf8_bytes":49,"review_flag":"JPN_DEFINITE_STOP_IF_INSUFFICIENT_PRESERVED"},{"unique_index":175,"cn_text":"要开始开发，需要画面所示数量的GMP（资金力）。","cn_control_tokens":"","cn_utf8_bytes":66,"review_flag":""},{"unique_index":176,"cn_text":"带有此图标的武器和道具，\n可以开始开发。","cn_control_tokens":"","cn_utf8_bytes":58,"review_flag":""},{"unique_index":177,"cn_text":"在Mother Base，可以开发任务中使用的\n武器和道具。","cn_control_tokens":"","cn_utf8_bytes":66,"review_flag":""},{"unique_index":178,"cn_text":"关于纸箱的发送与接收","cn_control_tokens":"","cn_utf8_bytes":30,"review_flag":""},{"unique_index":179,"cn_text":"如果收到陌生人寄来的纸箱，就回礼吧。\n纸箱发送者会登记在“FRIEND'S FRIENDS”标签页中。","cn_control_tokens":"","cn_utf8_bytes":119,"review_flag":""},{"unique_index":180,"cn_text":"将收件人选择为“- FREE -”后，纸箱会经由CO-OPS或对战中的对手，\n发送给不特定的对象。","cn_control_tokens":"","cn_utf8_bytes":117,"review_flag":"JPN_UNSPECIFIED_RECIPIENT_PRESERVED"},{"unique_index":181,"cn_text":"与战友互相传递武器和道具，一起完成困难的任务吧。","cn_control_tokens":"","cn_utf8_bytes":72,"review_flag":""},{"unique_index":182,"cn_text":"创建的纸箱会登记在“SENDBOX”中，\n并在CO-OPS或对战结束时配送。","cn_control_tokens":"","cn_utf8_bytes":86,"review_flag":"JPN_SENDBOX_LABEL_PRESERVED; AUX_OUT_BOX_SUBSTITUTION_REJECTED"},{"unique_index":183,"cn_text":"可以把部分武器和恢复道具装进纸箱后发送。","cn_control_tokens":"","cn_utf8_bytes":60,"review_flag":""},{"unique_index":184,"cn_text":"在“DELIVERY”中，可以向CO-OPS或对战中的对手","cn_control_tokens":"","cn_utf8_bytes":59,"review_flag":"SOURCE_SENTENCE_FRAGMENT_PRESERVED"},{"unique_index":185,"cn_text":"将自己的人员与其他玩家的人员进行交换。","cn_control_tokens":"","cn_utf8_bytes":57,"review_flag":""},{"unique_index":186,"cn_text":"返回标题菜单。","cn_control_tokens":"","cn_utf8_bytes":21,"review_flag":""},{"unique_index":187,"cn_text":"可以查看各种信息。","cn_control_tokens":"","cn_utf8_bytes":27,"review_flag":"AUX_MOTHER_BASE_PLAYER_DATA_NARROWING_REJECTED"},{"unique_index":188,"cn_text":"查看人员并进行班组编成。","cn_control_tokens":"","cn_utf8_bytes":36,"review_flag":""},{"unique_index":189,"cn_text":"将游戏记录保存到Memory Stick™。","cn_control_tokens":"","cn_utf8_bytes":42,"review_flag":"JPN_PLAIN_TEXT_MEMORY_STICK_TRADEMARK_PRESERVED; AUX_ICON_CONTROLS_REJECTED"},{"unique_index":190,"cn_text":"搜索无线LAN接入点，招募入队志愿者。","cn_control_tokens":"","cn_utf8_bytes":51,"review_flag":""},{"unique_index":191,"cn_text":"可以查看玩家信息。","cn_control_tokens":"","cn_utf8_bytes":27,"review_flag":""},{"unique_index":192,"cn_text":"可以查看更新记录。","cn_control_tokens":"","cn_utf8_bytes":27,"review_flag":""},{"unique_index":193,"cn_text":"更改游戏设置。","cn_control_tokens":"","cn_utf8_bytes":21,"review_flag":""},{"unique_index":194,"cn_text":"可以查看Mother Base内的信息。","cn_control_tokens":"","cn_utf8_bytes":38,"review_flag":""},{"unique_index":195,"cn_text":"(不要)进行Mother Base移动或打捞海底物资。","cn_control_tokens":"","cn_utf8_bytes":55,"review_flag":"SOURCE_不要_MARKER_PRESERVED"},{"unique_index":196,"cn_text":"开发“METAL GEAR ZEKE”。","cn_control_tokens":"","cn_utf8_bytes":30,"review_flag":""},{"unique_index":197,"cn_text":"查看或更改按键操作。","cn_control_tokens":"","cn_utf8_bytes":30,"review_flag":"JPN_KEY_OPERATION_PRESERVED; AUX_BUTTON_CONFIG_LABEL_NOT_FORCED"},{"unique_index":198,"cn_text":"开发武器和道具。","cn_control_tokens":"","cn_utf8_bytes":24,"review_flag":""},{"unique_index":199,"cn_text":"可以接收其他玩家的礼物，也可以自己制作并赠送。","cn_control_tokens":"","cn_utf8_bytes":69,"review_flag":""},{"unique_index":200,"cn_text":"响应冲突地区的请求，派遣佣兵部队。","cn_control_tokens":"","cn_utf8_bytes":51,"review_flag":"JPN_MERCENARY_UNIT_PRESERVED; AUX_COMBAT_UNIT_SUBSTITUTION_REJECTED"},{"unique_index":201,"cn_text":"从海底打捞了物资 %s。","cn_control_tokens":"","cn_utf8_bytes":30,"review_flag":"PRINTF_%s_PRESERVED"}]}