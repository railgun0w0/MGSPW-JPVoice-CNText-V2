{"file_id":"BRIEFING_MISSION_BLOCK_37CB00","resource_class":"BRIEFING_NBE","status":"TRANSLATED_PENDING_CSV_MERGE","translations":[{"unique_index":0,"cn_text":"Snake！\n听得见吗，Snake？\n","cn_control_tokens":"","cn_utf8_bytes":33,"review_flag":""},{"unique_index":1,"cn_text":"怎么了？\n","cn_control_tokens":"","cn_utf8_bytes":13,"review_flag":""},{"unique_index":2,"cn_text":"你帮我劝劝Amanda。\n","cn_control_tokens":"","cn_utf8_bytes":25,"review_flag":""},{"unique_index":3,"cn_text":"发生什么了？\n","cn_control_tokens":"","cn_utf8_bytes":19,"review_flag":""},{"unique_index":4,"cn_text":"她的伤明明还没痊愈，\n却已经嚷着要离开医务室去战斗了。\n","cn_control_tokens":"","cn_utf8_bytes":80,"review_flag":""},{"unique_index":5,"cn_text":"拄着拐杖还要上前线，根本就是自杀。\nSnake，你去阻止她吧。\n","cn_control_tokens":"","cn_utf8_bytes":82,"review_flag":""},{"unique_index":6,"cn_text":"Amanda在那里吗？\n","cn_control_tokens":"","cn_utf8_bytes":22,"review_flag":""},{"unique_index":7,"cn_text":"不，还在医务室。\n她嚷着“无论如何都要出去”，\n把医疗人员折腾得够呛。\n","cn_control_tokens":"","cn_utf8_bytes":102,"review_flag":""},{"unique_index":8,"cn_text":"让她出去吧。\n","cn_control_tokens":"","cn_utf8_bytes":19,"review_flag":""},{"unique_index":9,"cn_text":"你说什么！？\n","cn_control_tokens":"","cn_utf8_bytes":19,"review_flag":""},{"unique_index":10,"cn_text":"让Amanda离开医务室吧。\n","cn_control_tokens":"","cn_utf8_bytes":31,"review_flag":""},{"unique_index":11,"cn_text":"喂，Snake，别开玩笑了。\n","cn_control_tokens":"","cn_utf8_bytes":33,"review_flag":""},{"unique_index":12,"cn_text":"我是认真的。让Amanda出去吧。\n","cn_control_tokens":"","cn_utf8_bytes":40,"review_flag":""},{"unique_index":13,"cn_text":"你认真的？\n你想害死她吗？\n","cn_control_tokens":"","cn_utf8_bytes":38,"review_flag":""},{"unique_index":14,"cn_text":"你才别开玩笑。\n","cn_control_tokens":"","cn_utf8_bytes":22,"review_flag":""},{"unique_index":15,"cn_text":"那为什么？\n","cn_control_tokens":"","cn_utf8_bytes":16,"review_flag":""},{"unique_index":16,"cn_text":"Amanda不是那种会老实待在病房里的人。\n她是个只有怀着使命感行动起来，\n才能更体现自身价值的战士。\n","cn_control_tokens":"","cn_utf8_bytes":138,"review_flag":""},{"unique_index":17,"cn_text":"所以让她回到前线，对Amanda自己更好，\n也能鼓舞她的同志们，\n最终对MSF也有好处。\n","cn_control_tokens":"","cn_utf8_bytes":111,"review_flag":""},{"unique_index":18,"cn_text":"是这样吗……。\n","cn_control_tokens":"","cn_utf8_bytes":22,"review_flag":""},{"unique_index":19,"cn_text":"你对战斗的嗅觉很敏锐，\n可在看人这方面还差得远呢。\n","cn_control_tokens":"","cn_utf8_bytes":74,"review_flag":""},{"unique_index":20,"cn_text":"……那该把她分到哪个班？\n","cn_control_tokens":"","cn_utf8_bytes":37,"review_flag":""},{"unique_index":21,"cn_text":"我会考虑一个适合Amanda的岗位。\n放心，不会让她失望的。\n","cn_control_tokens":"","cn_utf8_bytes":77,"review_flag":""},{"unique_index":22,"cn_text":"了解。\n既然你这么说。\n","cn_control_tokens":"","cn_utf8_bytes":32,"review_flag":""}]}