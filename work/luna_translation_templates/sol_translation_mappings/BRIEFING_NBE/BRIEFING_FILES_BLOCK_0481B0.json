{"file_id":"BRIEFING_FILES_BLOCK_0481B0","resource_class":"BRIEFING_NBE","status":"TRANSLATED_PENDING_CSV_MERGE","translations":[{"unique_index":0,"cn_text":"Snake，听说你拍到Colibrí的照片了？","cn_control_tokens":"","cn_utf8_bytes":46,"review_flag":""},{"unique_index":1,"cn_text":"嗯，就是这张。","cn_control_tokens":"","cn_utf8_bytes":21,"review_flag":""},{"unique_index":2,"cn_text":"太厉害了！简直就像真的UFO！果然，美军和外星人勾结在一起啊。","cn_control_tokens":"","cn_utf8_bytes":87,"review_flag":""},{"unique_index":3,"cn_text":"确实，外形看起来是挺像的……。","cn_control_tokens":"","cn_utf8_bytes":45,"review_flag":""},{"unique_index":4,"cn_text":"喂，Snake，这张照片能不能帮我加洗一张？","cn_control_tokens":"","cn_utf8_bytes":56,"review_flag":""},{"unique_index":5,"cn_text":"可以，不过你打算拿来做什么？","cn_control_tokens":"","cn_utf8_bytes":42,"review_flag":""},{"unique_index":6,"cn_text":"这种照片能卖很高的价钱，也能拿来当MSF的运营经费。","cn_control_tokens":"","cn_utf8_bytes":72,"review_flag":""},{"unique_index":7,"cn_text":"哈哈，那不错。好好赚一笔吧。","cn_control_tokens":"","cn_utf8_bytes":42,"review_flag":""},{"unique_index":8,"cn_text":"你根本不信吧，Snake。不过就交给我吧！","cn_control_tokens":"","cn_utf8_bytes":53,"review_flag":""}]}