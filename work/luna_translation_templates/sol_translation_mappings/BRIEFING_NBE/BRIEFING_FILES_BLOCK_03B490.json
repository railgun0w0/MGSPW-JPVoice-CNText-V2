{"file_id":"BRIEFING_FILES_BLOCK_03B490","resource_class":"BRIEFING_NBE","status":"TRANSLATED_PENDING_CSV_MERGE","translations":[{"unique_index":0,"cn_text":"Chico说过，村子北边有座桥。","cn_control_tokens":"","cn_utf8_bytes":38,"review_flag":""},{"unique_index":1,"cn_text":"是一座用来架设铁管的窄桥。过桥后就能接上卡车的运输路线。不过桥上好像到处都有破损。","cn_control_tokens":"","cn_utf8_bytes":123,"review_flag":""},{"unique_index":2,"cn_text":"要是被发现，恐怕就无处可逃了。","cn_control_tokens":"","cn_utf8_bytes":45,"review_flag":""},{"unique_index":3,"cn_text":"要是有士兵堵住道路，就麻烦了。","cn_control_tokens":"","cn_utf8_bytes":45,"review_flag":""},{"unique_index":4,"cn_text":"有别的路吗？","cn_control_tokens":"","cn_utf8_bytes":18,"review_flag":""},{"unique_index":5,"cn_text":"那条路贴着悬崖。过桥后，靠山一侧有座堡垒遗迹。能从那边走的话，应该会轻松一点。","cn_control_tokens":"","cn_utf8_bytes":117,"review_flag":""},{"unique_index":6,"cn_text":"穿过山路，就是他们的堡垒。","cn_control_tokens":"","cn_utf8_bytes":39,"review_flag":""}]}