{"file_id":"BRIEFING_FILES_BLOCK_02AC70","resource_class":"BRIEFING_NBE","status":"TRANSLATED_PENDING_CSV_MERGE","translations":[{"unique_index":0,"cn_text":"哥斯达黎加真正的铁路开始运行，大约是在100年前。","cn_control_tokens":"","cn_utf8_bytes":69,"review_flag":""},{"unique_index":1,"cn_text":"当时是为了把中央盆地出产的咖啡从加勒比海一侧出口。","cn_control_tokens":"","cn_utf8_bytes":75,"review_flag":"AUX_EXPORT_DESTINATION_RESTORED"},{"unique_index":2,"cn_text":"早在100年前，就要穿过这片尽是丛林的地形吗！真够辛苦的。","cn_control_tokens":"","cn_utf8_bytes":81,"review_flag":"JPN_JUNGLE_TERRAIN_DETAIL_RESTORED"},{"unique_index":3,"cn_text":"听说实际施工也确实相当艰难。","cn_control_tokens":"","cn_utf8_bytes":42,"review_flag":""},{"unique_index":4,"cn_text":"后来铁路也被用来运输香蕉。这一带或许还留着支线。","cn_control_tokens":"","cn_utf8_bytes":72,"review_flag":"AUX_BANANA_TRANSPORT_RESTORED"}]}