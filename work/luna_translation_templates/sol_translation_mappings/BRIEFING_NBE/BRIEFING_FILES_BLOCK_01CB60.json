{"file_id":"BRIEFING_FILES_BLOCK_01CB60","resource_class":"BRIEFING_NBE","status":"TRANSLATED_PENDING_CSV_MERGE","translations":[{"unique_index":0,"cn_text":"营房里的敌兵已经清除了。尽管痛快地射击标靶吧。","cn_control_tokens":"","cn_utf8_bytes":69,"review_flag":""},{"unique_index":1,"cn_text":"要在规定时间内击中所有标靶，诀窍就是尽量减少移动上的浪费。","cn_control_tokens":"","cn_utf8_bytes":87,"review_flag":"AUX_PARTIAL_JPN_DETAIL_RESTORED"},{"unique_index":2,"cn_text":"也许从屋顶上进行狙击会比较容易。","cn_control_tokens":"","cn_utf8_bytes":48,"review_flag":""},{"unique_index":3,"cn_text":"当然，故意换种武器来挑战，对训练也很有效。","cn_control_tokens":"","cn_utf8_bytes":63,"review_flag":""}]}