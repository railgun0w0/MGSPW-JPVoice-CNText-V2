{"file_id":"BRIEFING_FILES_BLOCK_029020","resource_class":"BRIEFING_NBE","status":"TRANSLATED_PENDING_CSV_MERGE","translations":[{"unique_index":0,"cn_text":"雇佣兵用来搬入物资的基地在海边的高地上。","cn_control_tokens":"","cn_utf8_bytes":60,"review_flag":""},{"unique_index":1,"cn_text":"那些人擅自把这里叫作“Puerto del Alba”，意思是“曙光之港”。","cn_control_tokens":"","cn_utf8_bytes":84,"review_flag":"JPN_ARBITRARY_NAMING_RESTORED"},{"unique_index":2,"cn_text":"从基地能把周围看得一清二楚。我们本想不被发现地潜进去……可还是被守卫发现了，然后……","cn_control_tokens":"","cn_utf8_bytes":126,"review_flag":""},{"unique_index":3,"cn_text":"怎么了？","cn_control_tokens":"","cn_utf8_bytes":12,"review_flag":""},{"unique_index":4,"cn_text":"……对不起。详细的事，你去问Gálvez教授好吗？","cn_control_tokens":"","cn_utf8_bytes":64,"review_flag":""},{"unique_index":5,"cn_text":"……明白了。没必要勉强自己去回忆。","cn_control_tokens":"","cn_utf8_bytes":51,"review_flag":"AUX_PARAPHRASE_REPLACED_BY_JPN"},{"unique_index":6,"cn_text":"对不起……我实在是……","cn_control_tokens":"","cn_utf8_bytes":33,"review_flag":""},{"unique_index":7,"cn_text":"我不会让你的努力白费。你已经做得很好了。","cn_control_tokens":"","cn_utf8_bytes":60,"review_flag":"AUX_PAZ_NAME_ADDITION_REMOVED"}]}