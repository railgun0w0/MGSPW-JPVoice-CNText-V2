{"file_id":"BRIEFING_FILES_BLOCK_013B70","resource_class":"BRIEFING_NBE","status":"TRANSLATED_PENDING_CSV_MERGE","translations":[{"unique_index":0,"cn_text":"两人以上协力执行任务，称为共同作战 COrporative OPerationS，简称CO-OPS。","cn_control_tokens":"","cn_utf8_bytes":92,"review_flag":"SOURCE_TERM_PRESERVED"},{"unique_index":1,"cn_text":"CO-OPS的基本单位是<R=两人一组,双人小组>。","cn_control_tokens":"<R=两人一组,双人小组>","cn_utf8_bytes":56,"review_flag":"RUBY_LOCALIZED"},{"unique_index":2,"cn_text":"哪怕只有一个同伴，在敌境里也会让人安心不少。","cn_control_tokens":"","cn_utf8_bytes":66,"review_flag":""},{"unique_index":3,"cn_text":"实际上，两个人能做到很多一个人做不到的行动。","cn_control_tokens":"","cn_utf8_bytes":66,"review_flag":""},{"unique_index":4,"cn_text":"比如互相协力翻越高差、分工行动……","cn_control_tokens":"","cn_utf8_bytes":51,"review_flag":""},{"unique_index":5,"cn_text":"不过，只要一个人被发现，另一个人也会暴露在危险中。而且狭窄的地方可能也很难藏下两个人。","cn_control_tokens":"","cn_utf8_bytes":129,"review_flag":""},{"unique_index":6,"cn_text":"是啊。不过最重要的，还是和同伴之间的羁绊。","cn_control_tokens":"","cn_utf8_bytes":63,"review_flag":"AUX_BOND_NUANCE_RESTORED"},{"unique_index":7,"cn_text":"没错。双人小组潜入是有利还是不利，全看两人的配合。","cn_control_tokens":"","cn_utf8_bytes":75,"review_flag":""},{"unique_index":8,"cn_text":"顺带一提，如果是目标明确的战斗，投入更多人的行动也会很有效。","cn_control_tokens":"","cn_utf8_bytes":90,"review_flag":""},{"unique_index":9,"cn_text":"不过，一旦队伍达到三人以上，被发现的风险也会大幅上升。","cn_control_tokens":"","cn_utf8_bytes":81,"review_flag":""},{"unique_index":10,"cn_text":"是啊。潜入任务里，人数越少越容易行动。","cn_control_tokens":"","cn_utf8_bytes":57,"review_flag":"AUX_TRUNCATED_JPN_DETAIL_RESTORED"}]}