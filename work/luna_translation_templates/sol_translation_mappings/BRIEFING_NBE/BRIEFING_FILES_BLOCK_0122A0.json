{"file_id":"BRIEFING_FILES_BLOCK_0122A0","resource_class":"BRIEFING_NBE","status":"TRANSLATED_PENDING_CSV_MERGE","translations":[{"unique_index":0,"cn_text":"让士兵睡着或昏迷后，就可以通过搜身拿走他们身上的道具。","cn_control_tokens":"","cn_utf8_bytes":81,"review_flag":""},{"unique_index":1,"cn_text":"靠近倒地的士兵，出现图标后按<I=ACT>。","cn_control_tokens":"<I=ACT>","cn_utf8_bytes":52,"review_flag":"AUX_PARTIAL_JPN_DETAIL_RESTORED"},{"unique_index":2,"cn_text":"从背后接近并举枪控制住的士兵，以及濒死倒地的士兵，也都可以搜身。","cn_control_tokens":"","cn_utf8_bytes":96,"review_flag":"AUX_ACTION_STATE_NUANCE_RESTORED"},{"unique_index":3,"cn_text":"不过要注意，濒死的士兵过一段时间就会死。","cn_control_tokens":"","cn_utf8_bytes":60,"review_flag":"AUX_PARTIAL_JPN_DETAIL_RESTORED"},{"unique_index":4,"cn_text":"另外，手里拿着富尔顿回收装置时无法搜身。注意这一点。","cn_control_tokens":"","cn_utf8_bytes":78,"review_flag":"AUX_PARTIAL_JPN_DETAIL_RESTORED"}]}