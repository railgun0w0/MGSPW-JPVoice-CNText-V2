{"file_id":"BRIEFING_FILES_BLOCK_01FF10","resource_class":"BRIEFING_NBE","status":"TRANSLATED_PENDING_CSV_MERGE","translations":[{"unique_index":0,"cn_text":"突击兵里，尤其是那些拿霰弹枪的家伙最难对付。","cn_control_tokens":"","cn_utf8_bytes":66,"review_flag":""},{"unique_index":1,"cn_text":"他们挨上几枪也不在乎，照样会冲过来。","cn_control_tokens":"","cn_utf8_bytes":54,"review_flag":""},{"unique_index":2,"cn_text":"一旦进入霰弹枪的射程，你也绝不会全身而退。","cn_control_tokens":"","cn_utf8_bytes":63,"review_flag":"AUX_PARAPHRASE_JPN_USED"},{"unique_index":3,"cn_text":"他们一冲过来，就得尽早用威力强的武器把他们压住。","cn_control_tokens":"","cn_utf8_bytes":72,"review_flag":""}]}