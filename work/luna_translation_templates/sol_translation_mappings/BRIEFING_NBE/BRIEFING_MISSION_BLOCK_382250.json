{"file_id":"BRIEFING_MISSION_BLOCK_382250","resource_class":"BRIEFING_NBE","status":"TRANSLATED_PENDING_CSV_MERGE","translations":[{"unique_index":0,"cn_text":"Boss……有东西送给你。\n","cn_control_tokens":"","cn_utf8_bytes":32,"review_flag":""},{"unique_index":1,"cn_text":"不是寄给MSF，是给我的？\n","cn_control_tokens":"","cn_utf8_bytes":34,"review_flag":""},{"unique_index":2,"cn_text":"嗯。里面看起来像盒式磁带。\n","cn_control_tokens":"","cn_utf8_bytes":40,"review_flag":""},{"unique_index":3,"cn_text":"磁带！？\n","cn_control_tokens":"","cn_utf8_bytes":13,"review_flag":""},{"unique_index":4,"cn_text":"别担心。没有检测到爆炸物之类的反应。\n寄件人的名字也姑且写了。\n只写着“<R=EVA,EVA>”。\n","cn_control_tokens":"[\"<R=EVA,EVA>\"]","cn_utf8_bytes":122,"review_flag":"RUBY_READING_ROMANIZED"},{"unique_index":5,"cn_text":"<R=EVA,EVA>……。\n","cn_control_tokens":"[\"<R=EVA,EVA>\"]","cn_utf8_bytes":21,"review_flag":"RUBY_READING_ROMANIZED"},{"unique_index":6,"cn_text":"你认识？\n","cn_control_tokens":"","cn_utf8_bytes":13,"review_flag":""},{"unique_index":7,"cn_text":"嗯……老相识了。\n","cn_control_tokens":"","cn_utf8_bytes":25,"review_flag":""},{"unique_index":8,"cn_text":"你还真不简单啊。\n以前的女朋友寄来的情书？\n","cn_control_tokens":"","cn_utf8_bytes":62,"review_flag":""},{"unique_index":9,"cn_text":"别拿我开玩笑。总之我收下了。\n","cn_control_tokens":"","cn_utf8_bytes":43,"review_flag":""},{"unique_index":10,"cn_text":"知道了。……不过，可别移情别恋啊？\n现在对MSF来说正是关键时期。\n","cn_control_tokens":"","cn_utf8_bytes":92,"review_flag":""},{"unique_index":11,"cn_text":"什么叫移情别恋……。\n","cn_control_tokens":"","cn_utf8_bytes":31,"review_flag":""}]}