{"file_id":"BRIEFING_MISSION_BLOCK_3705D0","resource_class":"BRIEFING_NBE","status":"TRANSLATED_PENDING_CSV_MERGE","translations":[{"unique_index":0,"cn_text":"Snake，Chico到了。","cn_control_tokens":"","cn_utf8_bytes":22,"review_flag":""},{"unique_index":1,"cn_text":"Snake！","cn_control_tokens":"","cn_utf8_bytes":8,"review_flag":""},{"unique_index":2,"cn_text":"Chico，到了啊。","cn_control_tokens":"","cn_utf8_bytes":20,"review_flag":""},{"unique_index":3,"cn_text":"什么叫“到了啊”！这到底是什么玩意儿？","cn_control_tokens":"","cn_utf8_bytes":57,"review_flag":""},{"unique_index":4,"cn_text":"嘴上说着“给我新的生命”，结果是想杀了我吗！？","cn_control_tokens":"","cn_utf8_bytes":69,"review_flag":""},{"unique_index":5,"cn_text":"不合你心意吗？","cn_control_tokens":"","cn_utf8_bytes":21,"review_flag":""},{"unique_index":6,"cn_text":"那个人贩子气球到底是什么鬼！","cn_control_tokens":"","cn_utf8_bytes":42,"review_flag":""},{"unique_index":7,"cn_text":"这不就和Colibri没什么两样吗！","cn_control_tokens":"","cn_utf8_bytes":40,"review_flag":""},{"unique_index":8,"cn_text":"景色不错吧，Chico。还是说你不擅长待在高处？","cn_control_tokens":"","cn_utf8_bytes":62,"review_flag":""},{"unique_index":9,"cn_text":"不是那个意思，我只是希望你事先至少说明一下。","cn_control_tokens":"","cn_utf8_bytes":66,"review_flag":""},{"unique_index":10,"cn_text":"要是说明了，你会自己主动飞上去吗？","cn_control_tokens":"","cn_utf8_bytes":51,"review_flag":""},{"unique_index":11,"cn_text":"……！","cn_control_tokens":"","cn_utf8_bytes":9,"review_flag":""},{"unique_index":12,"cn_text":"Snake。谢谢你救了我们。","cn_control_tokens":"","cn_utf8_bytes":32,"review_flag":""},{"unique_index":13,"cn_text":"Amanda，我有一句话想劝你。","cn_control_tokens":"","cn_utf8_bytes":36,"review_flag":""},{"unique_index":14,"cn_text":"什么？","cn_control_tokens":"","cn_utf8_bytes":9,"review_flag":""},{"unique_index":15,"cn_text":"别再把Chico当小孩子了。","cn_control_tokens":"","cn_utf8_bytes":32,"review_flag":""},{"unique_index":16,"cn_text":"嗯，是啊……。我知道。我以为自己明白。","cn_control_tokens":"","cn_utf8_bytes":57,"review_flag":""},{"unique_index":17,"cn_text":"Amanda，腿好了之后你会回去吧？","cn_control_tokens":"","cn_utf8_bytes":42,"review_flag":""},{"unique_index":18,"cn_text":"当然……。我们还有该做的事。","cn_control_tokens":"","cn_utf8_bytes":42,"review_flag":""},{"unique_index":19,"cn_text":"“我们”吗……。","cn_control_tokens":"","cn_utf8_bytes":24,"review_flag":""},{"unique_index":20,"cn_text":"你这句话，是在认真考虑过Chico的未来之后才说的吗？","cn_control_tokens":"","cn_utf8_bytes":71,"review_flag":""},{"unique_index":21,"cn_text":"什么意思？我们要继承父亲的遗志，让革命成功。","cn_control_tokens":"","cn_utf8_bytes":66,"review_flag":""},{"unique_index":22,"cn_text":"不管是革命还是什么，一旦拿起枪诉诸暴力，最后所有人都会坠入地狱。","cn_control_tokens":"","cn_utf8_bytes":96,"review_flag":""},{"unique_index":23,"cn_text":"你做好这个觉悟了吗？","cn_control_tokens":"","cn_utf8_bytes":30,"review_flag":""},{"unique_index":24,"cn_text":"我早就做好觉悟了。与其抛弃<R=祖国,NICA>，我宁愿下地狱。","cn_control_tokens":"[\"<R=祖国,NICA>\"]","cn_utf8_bytes":78,"review_flag":"RUBY_READING_ROMANIZED"},{"unique_index":25,"cn_text":"是吗……。那就别再把Chico当弟弟，而要把他当作一名战士。","cn_control_tokens":"","cn_utf8_bytes":80,"review_flag":""},{"unique_index":26,"cn_text":"嗯，是啊……。","cn_control_tokens":"","cn_utf8_bytes":21,"review_flag":""},{"unique_index":27,"cn_text":"欢迎来到<R= 地　狱 ,OUTER HEAVEN>。","cn_control_tokens":"[\"<R= 地　狱 ,OUTER HEAVEN>\"]","cn_utf8_bytes":43,"review_flag":"RUBY_READING_ROMANIZED"},{"unique_index":28,"cn_text":"Snake，我有件事想拜托你。","cn_control_tokens":"","cn_utf8_bytes":35,"review_flag":""},{"unique_index":29,"cn_text":"什么？","cn_control_tokens":"","cn_utf8_bytes":9,"review_flag":""},{"unique_index":30,"cn_text":"如果遇到被抓的<R=FSLN,FRENTE>成员，希望你能救他们。那个……。","cn_control_tokens":"[\"<R=FSLN,FRENTE>\"]","cn_utf8_bytes":84,"review_flag":"RUBY_READING_ROMANIZED"},{"unique_index":31,"cn_text":"是想弥补自己招供的罪过吗？","cn_control_tokens":"","cn_utf8_bytes":39,"review_flag":""},{"unique_index":32,"cn_text":"不只是这样。他们是我的<R=同志,COMPA>。","cn_control_tokens":"[\"<R=同志,COMPA>\"]","cn_utf8_bytes":52,"review_flag":"RUBY_READING_ROMANIZED"},{"unique_index":33,"cn_text":"知道了。不过眼下最优先的是追上他们的货物。","cn_control_tokens":"","cn_utf8_bytes":63,"review_flag":""},{"unique_index":34,"cn_text":"我什么都愿意帮忙。","cn_control_tokens":"","cn_utf8_bytes":27,"review_flag":""},{"unique_index":35,"cn_text":"如果对这一带有什么不清楚的，就用无线电叫我。还有……。","cn_control_tokens":"","cn_utf8_bytes":81,"review_flag":""},{"unique_index":36,"cn_text":"嗯？","cn_control_tokens":"","cn_utf8_bytes":6,"review_flag":""},{"unique_index":37,"cn_text":"如果看到从没见过的生物，告诉我一声。","cn_control_tokens":"","cn_utf8_bytes":54,"review_flag":""},{"unique_index":38,"cn_text":"没见过的？你说过的“basilisco”那种吗？","cn_control_tokens":"","cn_utf8_bytes":54,"review_flag":""},{"unique_index":39,"cn_text":"是<R=『UMA』,UMA>啦。","cn_control_tokens":"[\"<R=『UMA』,UMA>\"]","cn_utf8_bytes":26,"review_flag":"RUBY_READING_ROMANIZED"},{"unique_index":40,"cn_text":"<R=『UMA』,UMA>？","cn_control_tokens":"[\"<R=『UMA』,UMA>\"]","cn_utf8_bytes":20,"review_flag":"RUBY_READING_ROMANIZED"},{"unique_index":41,"cn_text":"就是幸存下来的恐龙，或者罕见的<R=怪物,MONSTER>之类。我以后想成为<R=猎人,HUNTER>。","cn_control_tokens":"[\"<R=怪物,MONSTER>\",\"<R=猎人,HUNTER>\"]","cn_utf8_bytes":110,"review_flag":"RUBY_READING_ROMANIZED"},{"unique_index":42,"cn_text":"这样啊。知道了。","cn_control_tokens":"","cn_utf8_bytes":24,"review_flag":""},{"unique_index":43,"cn_text":"想听详细点的话，我之后再告诉你。","cn_control_tokens":"","cn_utf8_bytes":48,"review_flag":""},{"unique_index":44,"cn_text":"嗯。拜托你了，Chico。","cn_control_tokens":"","cn_utf8_bytes":29,"review_flag":""},{"unique_index":45,"cn_text":"好了，Snake。敌人的物资正运往下一个据点——<R=列车车库,TERMINAL>。","cn_control_tokens":"[\"<R=列车车库,TERMINAL>\"]","cn_utf8_bytes":90,"review_flag":"RUBY_READING_ROMANIZED"},{"unique_index":46,"cn_text":"Chico说，从来没人踏进过那之后的地方。","cn_control_tokens":"","cn_utf8_bytes":53,"review_flag":""},{"unique_index":47,"cn_text":"隧道另一边恐怕就是他们的大本营。","cn_control_tokens":"","cn_utf8_bytes":48,"review_flag":""},{"unique_index":48,"cn_text":"如果不能在隧道前拦住，<R=“长矛”,SPEAR>就会落到敌人手里。","cn_control_tokens":"[\"<R=“长矛”,SPEAR>\"]","cn_utf8_bytes":82,"review_flag":"RUBY_READING_ROMANIZED"},{"unique_index":49,"cn_text":"无论如何都要在这里阻止他们。赶快前进。","cn_control_tokens":"","cn_utf8_bytes":57,"review_flag":""}]}