{"file_id":"BRIEFING_FILES_BLOCK_02EA50","resource_class":"BRIEFING_NBE","status":"TRANSLATED_PENDING_CSV_MERGE","translations":[{"unique_index":0,"cn_text":"这一带是矿区吗……都能开采些什么？","cn_control_tokens":"","cn_utf8_bytes":51,"review_flag":"JPN_MINING_AREA_DETAIL_PRIMARY"},{"unique_index":1,"cn_text":"大概是金子吧。","cn_control_tokens":"","cn_utf8_bytes":21,"review_flag":""},{"unique_index":2,"cn_text":"金子？那不是很厉害吗。你怎么不早点……","cn_control_tokens":"","cn_utf8_bytes":57,"review_flag":"AUX_FASTEST_WAY_PARAPHRASE_REPLACED_BY_JPN"},{"unique_index":3,"cn_text":"不过好像没成功。我没听说这一带现在还有矿山在运营。","cn_control_tokens":"","cn_utf8_bytes":75,"review_flag":""},{"unique_index":4,"cn_text":"什么啊，原来如此……","cn_control_tokens":"","cn_utf8_bytes":30,"review_flag":"JPN_DISAPPOINTED_TONE_PRIMARY"},{"unique_index":5,"cn_text":"本来当地人就不太欢迎外国资本来开采资源。","cn_control_tokens":"","cn_utf8_bytes":60,"review_flag":"AUX_COUNTRY_RESOURCE_PARAPHRASE_SIMPLIFIED_TO_JPN"},{"unique_index":6,"cn_text":"四年前，正因为政府允许外国企业取得采矿权，甚至还发生过向国会投掷石块的骚乱。","cn_control_tokens":"","cn_utf8_bytes":114,"review_flag":"JPN_PARLIAMENT_STONING_INCIDENT_PRIMARY"}]}