{"file_id":"BRIEFING_FILES_BLOCK_041770","resource_class":"BRIEFING_NBE","status":"TRANSLATED_PENDING_CSV_MERGE","translations":[{"unique_index":0,"cn_text":"喂，Snake，Mother Base的工作什么都可以交给我！","cn_control_tokens":"","cn_utf8_bytes":61,"review_flag":""},{"unique_index":1,"cn_text":"不用勉强自己。","cn_control_tokens":"","cn_utf8_bytes":21,"review_flag":""},{"unique_index":2,"cn_text":"别把我当小孩子。我已经能独当一面了。","cn_control_tokens":"","cn_utf8_bytes":54,"review_flag":""},{"unique_index":3,"cn_text":"那你擅长什么？","cn_control_tokens":"","cn_utf8_bytes":21,"review_flag":""},{"unique_index":4,"cn_text":"呃……这个嘛……什么都行！不管把我分到哪个班，我都会努力。","cn_control_tokens":"","cn_utf8_bytes":87,"review_flag":""},{"unique_index":5,"cn_text":"哈哈……也是，你还年轻，也许学东西会很快。我考虑一下。","cn_control_tokens":"","cn_utf8_bytes":81,"review_flag":""},{"unique_index":6,"cn_text":"拜托了，Boss！我会让你看看我也能好好战斗的。","cn_control_tokens":"","cn_utf8_bytes":64,"review_flag":""}]}