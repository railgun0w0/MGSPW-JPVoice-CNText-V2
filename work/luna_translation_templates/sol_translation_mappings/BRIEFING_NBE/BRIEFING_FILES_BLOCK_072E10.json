{"file_id":"BRIEFING_FILES_BLOCK_072E10","resource_class":"BRIEFING_NBE","status":"TRANSLATED_PENDING_CSV_MERGE","translations":[{"unique_index":0,"cn_text":"那封信，你交给Strangelove博士了吗？","cn_control_tokens":"","cn_utf8_bytes":47,"review_flag":""},{"unique_index":1,"cn_text":"……还没有。","cn_control_tokens":"","cn_utf8_bytes":18,"review_flag":""},{"unique_index":2,"cn_text":"为什么？内容很重要，你得好好交给她。","cn_control_tokens":"","cn_utf8_bytes":54,"review_flag":""},{"unique_index":3,"cn_text":"抱歉。实在没找到那种机会。","cn_control_tokens":"","cn_utf8_bytes":39,"review_flag":""},{"unique_index":4,"cn_text":"下次见到她，一定要交给她。","cn_control_tokens":"","cn_utf8_bytes":39,"review_flag":""},{"unique_index":5,"cn_text":"啊，嗯。","cn_control_tokens":"","cn_utf8_bytes":12,"review_flag":""},{"unique_index":6,"cn_text":"我倒觉得那封信还是别交比较好……","cn_control_tokens":"","cn_utf8_bytes":48,"review_flag":""},{"unique_index":7,"cn_text":"Snake！","cn_control_tokens":"","cn_utf8_bytes":8,"review_flag":""},{"unique_index":8,"cn_text":"干、干嘛？","cn_control_tokens":"","cn_utf8_bytes":15,"review_flag":""},{"unique_index":9,"cn_text":"你该不会……看了那封信吧？","cn_control_tokens":"","cn_utf8_bytes":39,"review_flag":""},{"unique_index":10,"cn_text":"没、没有……","cn_control_tokens":"","cn_utf8_bytes":18,"review_flag":""},{"unique_index":11,"cn_text":"你看了吧！？","cn_control_tokens":"","cn_utf8_bytes":18,"review_flag":""},{"unique_index":12,"cn_text":"谁知道什么情报会影响作战成败？所以……","cn_control_tokens":"","cn_utf8_bytes":57,"review_flag":""},{"unique_index":13,"cn_text":"你居然看别人的信？我明明说过不许看！","cn_control_tokens":"","cn_utf8_bytes":54,"review_flag":""},{"unique_index":14,"cn_text":"不……越是叫人别看，反而越想……","cn_control_tokens":"","cn_utf8_bytes":48,"review_flag":""},{"unique_index":15,"cn_text":"我真是看错你了，Snake！！没想到你是这种人。完全是我看走眼了。","cn_control_tokens":"","cn_utf8_bytes":89,"review_flag":""},{"unique_index":16,"cn_text":"……是我不对。不过到底那个博士哪里好？","cn_control_tokens":"","cn_utf8_bytes":57,"review_flag":""},{"unique_index":17,"cn_text":"像你这种野蛮人当然不会懂。尤其是偷看别人信的家伙！","cn_control_tokens":"","cn_utf8_bytes":75,"review_flag":""},{"unique_index":18,"cn_text":"那你自己交给她不就好了。","cn_control_tokens":"","cn_utf8_bytes":36,"review_flag":""},{"unique_index":19,"cn_text":"什么！？啊，不，那个……我做不到……","cn_control_tokens":"","cn_utf8_bytes":54,"review_flag":""},{"unique_index":20,"cn_text":"前途多难啊，Huey……","cn_control_tokens":"","cn_utf8_bytes":28,"review_flag":""}]}