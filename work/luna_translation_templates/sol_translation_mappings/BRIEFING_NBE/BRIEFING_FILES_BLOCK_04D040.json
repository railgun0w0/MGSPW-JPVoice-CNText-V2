{"file_id":"BRIEFING_FILES_BLOCK_04D040","resource_class":"BRIEFING_NBE","status":"TRANSLATED_PENDING_CSV_MERGE","translations":[{"unique_index":0,"cn_text":"Snake的相机是旁轴式的吧。","cn_control_tokens":"","cn_utf8_bytes":35,"review_flag":""},{"unique_index":1,"cn_text":"<R=父亲,MI VIEJO>说过，旁轴相机虽然小，却能好好对焦。","cn_control_tokens":"[\"<R=父亲,MI VIEJO>\"]","cn_utf8_bytes":73,"review_flag":"RUBY_READING_ROMANIZED"},{"unique_index":2,"cn_text":"而且听说按下快门时也不容易抖动。","cn_control_tokens":"","cn_utf8_bytes":48,"review_flag":""},{"unique_index":3,"cn_text":"要对焦的话，只要让取景器里重叠成两层的影像完全合在一起就行。","cn_control_tokens":"","cn_utf8_bytes":90,"review_flag":""},{"unique_index":4,"cn_text":"不过换成你的话，对焦这种事手自己就会完成吧？","cn_control_tokens":"","cn_utf8_bytes":66,"review_flag":""},{"unique_index":5,"cn_text":"所以你只需要想着牢牢抓住拍摄对象就行。","cn_control_tokens":"","cn_utf8_bytes":57,"review_flag":""},{"unique_index":6,"cn_text":"毕竟，摄影最重要的就是时机。","cn_control_tokens":"","cn_utf8_bytes":42,"review_flag":""}]}