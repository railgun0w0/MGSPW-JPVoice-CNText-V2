{"file_id":"BRIEFING_MISSION_BLOCK_37BFB0","resource_class":"BRIEFING_NBE","status":"TRANSLATED_PENDING_CSV_MERGE","translations":[{"unique_index":0,"cn_text":"Snake……\n……又来了。\n","cn_control_tokens":"","cn_utf8_bytes":31,"review_flag":""},{"unique_index":1,"cn_text":"……。\n","cn_control_tokens":"","cn_utf8_bytes":10,"review_flag":""},{"unique_index":2,"cn_text":"Snake！\n","cn_control_tokens":"","cn_utf8_bytes":9,"review_flag":""},{"unique_index":3,"cn_text":"我也不想报告这种事。\nSnake！拜托了，听我说！\n","cn_control_tokens":"","cn_utf8_bytes":64,"review_flag":""},{"unique_index":4,"cn_text":"唉……。\n","cn_control_tokens":"","cn_utf8_bytes":13,"review_flag":""},{"unique_index":5,"cn_text":"“被拘留的Zadornov又不见了”！？\n……那个越狱狂！！\n","cn_control_tokens":"","cn_utf8_bytes":73,"review_flag":""},{"unique_index":6,"cn_text":"内部肯定有人协助他。\n但根本无从调查。\n","cn_control_tokens":"","cn_utf8_bytes":56,"review_flag":""},{"unique_index":7,"cn_text":"唉，真是个会惹麻烦的家伙。\n这次大概在哪一带？\n","cn_control_tokens":"","cn_utf8_bytes":68,"review_flag":""},{"unique_index":8,"cn_text":"问题是，他发现了发信器，还把它扔掉了。\n","cn_control_tokens":"","cn_utf8_bytes":58,"review_flag":""},{"unique_index":9,"cn_text":"现在完全不知道他在哪里。\n","cn_control_tokens":"","cn_utf8_bytes":37,"review_flag":""},{"unique_index":10,"cn_text":"Snake……。你、你……能找到他吗？\n","cn_control_tokens":"","cn_utf8_bytes":48,"review_flag":""},{"unique_index":11,"cn_text":"……不能放着不管。也得给其他人一个交代。\n","cn_control_tokens":"","cn_utf8_bytes":61,"review_flag":""},{"unique_index":12,"cn_text":"没错。既然无法确定他的位置，\n也就没法追加任务。\n","cn_control_tokens":"","cn_utf8_bytes":71,"review_flag":""},{"unique_index":13,"cn_text":"拜托了，Snake。\n找到Zadornov！\n","cn_control_tokens":"","cn_utf8_bytes":39,"review_flag":""}]}