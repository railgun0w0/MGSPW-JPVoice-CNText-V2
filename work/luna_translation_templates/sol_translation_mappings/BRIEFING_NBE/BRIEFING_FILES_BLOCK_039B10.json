{"file_id":"BRIEFING_FILES_BLOCK_039B10","resource_class":"BRIEFING_NBE","status":"TRANSLATED_PENDING_CSV_MERGE","translations":[{"unique_index":0,"cn_text":"Amanda，怎么去战俘收容所？","cn_control_tokens":"","cn_utf8_bytes":36,"review_flag":""},{"unique_index":1,"cn_text":"先沿着狭窄的山路往前走。道路会渐渐变宽，再往前就是三岔路口。","cn_control_tokens":"","cn_utf8_bytes":90,"review_flag":""},{"unique_index":2,"cn_text":"到了三岔路口别大意。四周都是高地，如果从中央通过，就会变成活靶子。","cn_control_tokens":"","cn_utf8_bytes":99,"review_flag":""},{"unique_index":3,"cn_text":"我会小心。","cn_control_tokens":"","cn_utf8_bytes":15,"review_flag":""},{"unique_index":4,"cn_text":"沿左边的路走，前面就是战俘收容所。","cn_control_tokens":"","cn_utf8_bytes":51,"review_flag":""}]}