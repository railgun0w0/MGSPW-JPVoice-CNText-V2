{"file_id":"BRIEFING_MISSION_BLOCK_37AF70","resource_class":"BRIEFING_NBE","status":"TRANSLATED_PENDING_CSV_MERGE","translations":[{"unique_index":0,"cn_text":"Snake，糟了。\n被拘留的Zadornov不见了。\n","cn_control_tokens":"","cn_utf8_bytes":51,"review_flag":""},{"unique_index":1,"cn_text":"喂，又来！？\n","cn_control_tokens":"","cn_utf8_bytes":19,"review_flag":""},{"unique_index":2,"cn_text":"这不对劲。\n他的义手已经被封住了，搜身也做得很彻底，\n警戒也加强了。\n","cn_control_tokens":"","cn_utf8_bytes":99,"review_flag":""},{"unique_index":3,"cn_text":"有人帮他逃跑？\n","cn_control_tokens":"","cn_utf8_bytes":22,"review_flag":""},{"unique_index":4,"cn_text":"不会吧……。总之，我准备了一个新任务。\n找到KGB特工Zadornov！\n","cn_control_tokens":"","cn_utf8_bytes":85,"review_flag":""}]}