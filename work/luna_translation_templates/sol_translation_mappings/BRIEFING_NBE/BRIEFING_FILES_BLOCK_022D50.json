{"file_id":"BRIEFING_FILES_BLOCK_022D50","resource_class":"BRIEFING_NBE","status":"TRANSLATED_PENDING_CSV_MERGE","translations":[{"unique_index":0,"cn_text":"Paz，你是联合国和平大学的学生吗？","cn_control_tokens":"","cn_utf8_bytes":48,"review_flag":""},{"unique_index":1,"cn_text":"不是，我还只是高中生。不过我经常去打扰Gálvez教授，在他的研究室里学习。","cn_control_tokens":"","cn_utf8_bytes":103,"review_flag":""},{"unique_index":2,"cn_text":"国际法、安全保障、冲突调停、人权……研究这些，并设法把它们用于和平建设。","cn_control_tokens":"","cn_utf8_bytes":108,"review_flag":"AUX_PEACEBUILDING_CLAUSE_RESTORED"},{"unique_index":3,"cn_text":"不是，我是说……我从没听说联合国还有和平大学。","cn_control_tokens":"","cn_utf8_bytes":69,"review_flag":""},{"unique_index":4,"cn_text":"啊，你说这个？准确地说，现在还处在筹备成立阶段。研究本身已经开始了，不过联合国的决议还没通过。","cn_control_tokens":"","cn_utf8_bytes":141,"review_flag":"AUX_UN_RESOLUTION_DETAIL_RESTORED"},{"unique_index":5,"cn_text":"Gálvez教授就是性子急……","cn_control_tokens":"","cn_utf8_bytes":34,"review_flag":""},{"unique_index":6,"cn_text":"啊，嗯。这样啊。","cn_control_tokens":"","cn_utf8_bytes":24,"review_flag":""},{"unique_index":7,"cn_text":"哥斯达黎加废除了军队，也曾经主办过中美洲司法法院。","cn_control_tokens":"","cn_utf8_bytes":75,"review_flag":"AUX_ARMY_ABOLITION_CLAUSE_RESTORED"},{"unique_index":8,"cn_text":"我觉得这里很适合作为和平大学的所在地。","cn_control_tokens":"","cn_utf8_bytes":57,"review_flag":""}]}