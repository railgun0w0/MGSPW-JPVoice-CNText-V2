{"file_id":"BRIEFING_FILES_BLOCK_05F2C0","resource_class":"BRIEFING_NBE","status":"TRANSLATED_PENDING_CSV_MERGE","translations":[{"unique_index":0,"cn_text":"人间的<R=天国,HEAVEN>吗……。说到法国，我脑子里只有外籍军团。","cn_control_tokens":"[\"<R=天国,HEAVEN>\"]","cn_utf8_bytes":86,"review_flag":"RUBY_READING_ROMANIZED"},{"unique_index":1,"cn_text":"你、你的印象也太偏了吧……。","cn_control_tokens":"","cn_utf8_bytes":42,"review_flag":""},{"unique_index":2,"cn_text":"法国人怎么看外籍军团？","cn_control_tokens":"","cn_utf8_bytes":33,"review_flag":""},{"unique_index":3,"cn_text":"这要怎么说呢……平时也不会特别去想。","cn_control_tokens":"","cn_utf8_bytes":54,"review_flag":""},{"unique_index":4,"cn_text":"不过也有人批评说，为了不让本国国民牺牲，就把危险任务推给外国人。","cn_control_tokens":"","cn_utf8_bytes":96,"review_flag":""},{"unique_index":5,"cn_text":"从它成立的经过来看，确实也有这种背景吧……。","cn_control_tokens":"","cn_utf8_bytes":66,"review_flag":""},{"unique_index":6,"cn_text":"不过我听说，只要持续服役，就能获得法国国籍和居留权。","cn_control_tokens":"","cn_utf8_bytes":78,"review_flag":""},{"unique_index":7,"cn_text":"只要入伍，不论国籍、出身、人种、宗教、学历等，都会得到平等的机会。","cn_control_tokens":"","cn_utf8_bytes":99,"review_flag":""},{"unique_index":8,"cn_text":"所以对贫穷国家的人来说，它也是很大的救济。","cn_control_tokens":"","cn_utf8_bytes":63,"review_flag":""},{"unique_index":9,"cn_text":"让一无所有的人拥有活下去的手段吗。某种意义上，也许和MSF很像。","cn_control_tokens":"","cn_utf8_bytes":90,"review_flag":""}]}