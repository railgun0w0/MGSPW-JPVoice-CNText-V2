{"file_id":"BRIEFING_FILES_BLOCK_0400C0","resource_class":"BRIEFING_NBE","status":"TRANSLATED_PENDING_CSV_MERGE","translations":[{"unique_index":0,"cn_text":"进行游击活动时，敌人有时会仗着人数优势展开搜索。","cn_control_tokens":"","cn_utf8_bytes":72,"review_flag":""},{"unique_index":1,"cn_text":"这种时候主动挑起战斗等于自杀。","cn_control_tokens":"","cn_utf8_bytes":45,"review_flag":""},{"unique_index":2,"cn_text":"冷静下来，仔细观察对方的行动，避开他们的视线。只专注于这一点。","cn_control_tokens":"","cn_utf8_bytes":93,"review_flag":""},{"unique_index":3,"cn_text":"当然，还要注意别发出声音。反过来，根据敌人发出的声音掌握位置也很重要。","cn_control_tokens":"","cn_utf8_bytes":105,"review_flag":""},{"unique_index":4,"cn_text":"不光要用眼睛和耳朵，也要留意敌人的气息。","cn_control_tokens":"","cn_utf8_bytes":60,"review_flag":""},{"unique_index":5,"cn_text":"贴在墙上或匍匐时，按<I=ESEARCH>可以探查敌人的气息。","cn_control_tokens":"[\"<I=ESEARCH>\"]","cn_utf8_bytes":71,"review_flag":""}]}