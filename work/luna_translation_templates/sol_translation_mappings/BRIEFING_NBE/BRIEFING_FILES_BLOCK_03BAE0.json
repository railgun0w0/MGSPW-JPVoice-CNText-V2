{"file_id":"BRIEFING_FILES_BLOCK_03BAE0","resource_class":"BRIEFING_NBE","status":"TRANSLATED_PENDING_CSV_MERGE","translations":[{"unique_index":0,"cn_text":"小心！那家伙是El Galápago！","cn_control_tokens":"","cn_utf8_bytes":36,"review_flag":""},{"unique_index":1,"cn_text":"它好像会向下喷射空气，以此减轻自身重量。","cn_control_tokens":"","cn_utf8_bytes":60,"review_flag":""},{"unique_index":2,"cn_text":"所以它的速度和坦克根本不是一个级别，而且转向也很灵活。","cn_control_tokens":"","cn_utf8_bytes":81,"review_flag":""},{"unique_index":3,"cn_text":"没有弱点吗？","cn_control_tokens":"","cn_utf8_bytes":18,"review_flag":""},{"unique_index":4,"cn_text":"攻击它的推进器，也许就能阻止它突然加速……。","cn_control_tokens":"","cn_utf8_bytes":66,"review_flag":""},{"unique_index":5,"cn_text":"另外，也可以想办法摧毁它的机枪。","cn_control_tokens":"","cn_utf8_bytes":48,"review_flag":""},{"unique_index":6,"cn_text":"明白了。试试看。","cn_control_tokens":"","cn_utf8_bytes":24,"review_flag":""},{"unique_index":7,"cn_text":"那家伙杀了我们很多同志。拜托了，替他们报仇！","cn_control_tokens":"","cn_utf8_bytes":66,"review_flag":""}]}