{"file_id":"BRIEFING_FILES_BLOCK_01CFF0","resource_class":"BRIEFING_NBE","status":"TRANSLATED_PENDING_CSV_MERGE","translations":[{"unique_index":0,"cn_text":"这是歼灭任务，不是潜入任务。","cn_control_tokens":"","cn_utf8_bytes":42,"review_flag":""},{"unique_index":1,"cn_text":"战斗无可避免。想靠躲藏蒙混过去是没用的。","cn_control_tokens":"","cn_utf8_bytes":60,"review_flag":"AUX_CROSS_ROW_SPLIT_IGNORED"},{"unique_index":2,"cn_text":"比起高迷彩率的装备，优先选择防御力更强的。","cn_control_tokens":"","cn_utf8_bytes":63,"review_flag":"AUX_CROSS_ROW_SPLIT_RESTORED"},{"unique_index":3,"cn_text":"当然，武器也必须带足。","cn_control_tokens":"","cn_utf8_bytes":33,"review_flag":"AUX_WEAPONS_NOT_AMMO_JPN_USED"},{"unique_index":4,"cn_text":"别忘了带恢复用道具！","cn_control_tokens":"","cn_utf8_bytes":30,"review_flag":""}]}