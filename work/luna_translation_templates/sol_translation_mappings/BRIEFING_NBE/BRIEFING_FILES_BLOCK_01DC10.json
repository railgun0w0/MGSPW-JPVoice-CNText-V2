{"file_id":"BRIEFING_FILES_BLOCK_01DC10","resource_class":"BRIEFING_NBE","status":"TRANSLATED_PENDING_CSV_MERGE","translations":[{"unique_index":0,"cn_text":"这次任务中，一个敌人都不能杀。","cn_control_tokens":"","cn_utf8_bytes":45,"review_flag":""},{"unique_index":1,"cn_text":"而且，只要被敌人发现一次，任务就会失败。","cn_control_tokens":"","cn_utf8_bytes":60,"review_flag":""},{"unique_index":2,"cn_text":"总之，行动一定要谨慎。","cn_control_tokens":"","cn_utf8_bytes":33,"review_flag":""},{"unique_index":3,"cn_text":"保持低姿态，附近有敌兵时，要放轻脚步慢慢走……","cn_control_tokens":"","cn_utf8_bytes":69,"review_flag":"AUX_PARTIAL_JPN_DETAIL_RESTORED"},{"unique_index":4,"cn_text":"躲在掩体后，用<I=ESEARCH>观察敌人的动静也很有效。","cn_control_tokens":"<I=ESEARCH>","cn_utf8_bytes":68,"review_flag":"AUX_PARTIAL_JPN_DETAIL_RESTORED;CONTROL_TOKEN_PRESERVED"},{"unique_index":5,"cn_text":"虽然是老办法，但也可以扔出空弹匣来诱导敌人。","cn_control_tokens":"","cn_utf8_bytes":66,"review_flag":"AUX_PARTIAL_JPN_DETAIL_RESTORED"},{"unique_index":6,"cn_text":"也要注意声音。能把声音视觉化的周围感知指示器也很方便。","cn_control_tokens":"","cn_utf8_bytes":81,"review_flag":"AUX_PARTIAL_JPN_DETAIL_RESTORED"}]}