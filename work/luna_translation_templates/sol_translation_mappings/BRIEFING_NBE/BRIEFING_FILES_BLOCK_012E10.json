{"file_id":"BRIEFING_FILES_BLOCK_012E10","resource_class":"BRIEFING_NBE","status":"TRANSLATED_PENDING_CSV_MERGE","translations":[{"unique_index":0,"cn_text":"『JUNGLE FATIGUES』是用于丛林的野战服，可以说是标准战斗服。","cn_control_tokens":"","cn_utf8_bytes":81,"review_flag":"AUX_UNSUPPORTED_STATS_IGNORED"},{"unique_index":1,"cn_text":"它的特点是，迷彩率会因区域不同而产生很大差异。","cn_control_tokens":"","cn_utf8_bytes":69,"review_flag":""},{"unique_index":2,"cn_text":"如果穿着能融入周围环境的图案，迷彩率就会提高。","cn_control_tokens":"","cn_utf8_bytes":69,"review_flag":""},{"unique_index":3,"cn_text":"反过来，如果和周围环境格格不入，就更容易被发现。","cn_control_tokens":"","cn_utf8_bytes":72,"review_flag":""},{"unique_index":4,"cn_text":"所以必须根据情况灵活选用。Sigint以前也经常为这事训我。","cn_control_tokens":"","cn_utf8_bytes":78,"review_flag":""}]}