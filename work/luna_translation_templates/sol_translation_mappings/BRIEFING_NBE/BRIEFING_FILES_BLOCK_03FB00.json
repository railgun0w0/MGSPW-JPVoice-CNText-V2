{"file_id":"BRIEFING_FILES_BLOCK_03FB00","resource_class":"BRIEFING_NBE","status":"TRANSLATED_PENDING_CSV_MERGE","translations":[{"unique_index":0,"cn_text":"对敌方据点实施破坏，也是游击战的基本战术。","cn_control_tokens":"","cn_utf8_bytes":63,"review_flag":""},{"unique_index":1,"cn_text":"破坏时应该会用到爆炸物，但只要发生爆炸，当然就会被发现。","cn_control_tokens":"","cn_utf8_bytes":84,"review_flag":""},{"unique_index":2,"cn_text":"所以，从设置炸药到引爆之间，最重要的是先确保自己的安全。","cn_control_tokens":"","cn_utf8_bytes":84,"review_flag":""},{"unique_index":3,"cn_text":"为了迅速转移到安全地点，最好在设置炸药之前就规划好撤离路线。","cn_control_tokens":"","cn_utf8_bytes":90,"review_flag":""}]}