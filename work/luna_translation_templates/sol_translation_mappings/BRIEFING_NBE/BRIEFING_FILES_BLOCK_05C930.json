{"file_id":"BRIEFING_FILES_BLOCK_05C930","resource_class":"BRIEFING_NBE","status":"TRANSLATED_PENDING_CSV_MERGE","translations":[{"unique_index":0,"cn_text":"你刚才说过会学猴子叫……。","cn_control_tokens":"","cn_utf8_bytes":39,"review_flag":""},{"unique_index":1,"cn_text":"想听吗？","cn_control_tokens":"","cn_utf8_bytes":12,"review_flag":""},{"unique_index":2,"cn_text":"嗯，不听一次总觉得心里不踏实。","cn_control_tokens":"","cn_utf8_bytes":45,"review_flag":""},{"unique_index":3,"cn_text":"那我开始了。","cn_control_tokens":"","cn_utf8_bytes":18,"review_flag":""},{"unique_index":4,"cn_text":"学得真像。","cn_control_tokens":"","cn_utf8_bytes":15,"review_flag":""},{"unique_index":5,"cn_text":"我还会别的，比如羊啊、猪啊……。","cn_control_tokens":"","cn_utf8_bytes":48,"review_flag":""},{"unique_index":6,"cn_text":"羊和猪？","cn_control_tokens":"","cn_utf8_bytes":12,"review_flag":""},{"unique_index":7,"cn_text":"哦！那猪呢？","cn_control_tokens":"","cn_utf8_bytes":18,"review_flag":""},{"unique_index":8,"cn_text":"简直一模一样！","cn_control_tokens":"","cn_utf8_bytes":21,"review_flag":""},{"unique_index":9,"cn_text":"是吗？我还会学猩猩呢！","cn_control_tokens":"","cn_utf8_bytes":33,"review_flag":""},{"unique_index":10,"cn_text":"猩猩？猩猩会叫吗？","cn_control_tokens":"","cn_utf8_bytes":27,"review_flag":""},{"unique_index":11,"cn_text":"嚯！","cn_control_tokens":"","cn_utf8_bytes":6,"review_flag":""},{"unique_index":12,"cn_text":"还有啊，我也会学兔子……。","cn_control_tokens":"","cn_utf8_bytes":39,"review_flag":""},{"unique_index":13,"cn_text":"兔子？兔子会叫吗！？","cn_control_tokens":"","cn_utf8_bytes":30,"review_flag":""},{"unique_index":14,"cn_text":"会啊。不过声音非常小，没养过兔子的话可能不太听得出来。","cn_control_tokens":"","cn_utf8_bytes":81,"review_flag":""},{"unique_index":15,"cn_text":"哦，原来如此。那是什么样的叫声？","cn_control_tokens":"","cn_utf8_bytes":48,"review_flag":""},{"unique_index":16,"cn_text":"那就仔细听。","cn_control_tokens":"","cn_utf8_bytes":18,"review_flag":""},{"unique_index":17,"cn_text":"嗯。","cn_control_tokens":"","cn_utf8_bytes":6,"review_flag":""},{"unique_index":18,"cn_text":"什么？兔子是那样叫的吗！？","cn_control_tokens":"","cn_utf8_bytes":39,"review_flag":""},{"unique_index":19,"cn_text":"真的，兔子真的这么叫！听好了？","cn_control_tokens":"","cn_utf8_bytes":45,"review_flag":""},{"unique_index":20,"cn_text":"我从没听过啊……。","cn_control_tokens":"","cn_utf8_bytes":27,"review_flag":""},{"unique_index":21,"cn_text":"是真的！","cn_control_tokens":"","cn_utf8_bytes":12,"review_flag":""}]}