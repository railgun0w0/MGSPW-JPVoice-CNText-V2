{"file_id":"BRIEFING_FILES_BLOCK_04A590","resource_class":"BRIEFING_NBE","status":"TRANSLATED_PENDING_CSV_MERGE","translations":[{"unique_index":0,"cn_text":"Chico，我见到那只会说话的猫了。","cn_control_tokens":"","cn_utf8_bytes":44,"review_flag":""},{"unique_index":1,"cn_text":"真的，Snake！你见到传说中的Trenya了！？","cn_control_tokens":"","cn_utf8_bytes":53,"review_flag":""},{"unique_index":2,"cn_text":"Trenya？它确实是这么自称的。很有名吗？","cn_control_tokens":"","cn_utf8_bytes":54,"review_flag":""},{"unique_index":3,"cn_text":"在那个圈子里算是吧。","cn_control_tokens":"","cn_utf8_bytes":30,"review_flag":""},{"unique_index":4,"cn_text":"到现在我还是难以相信。","cn_control_tokens":"","cn_utf8_bytes":33,"review_flag":""},{"unique_index":5,"cn_text":"没想到除了人类之外，竟然还有拥有语言的生物。世界真大。","cn_control_tokens":"","cn_utf8_bytes":81,"review_flag":""},{"unique_index":6,"cn_text":"不过，你居然能听懂它们的话啊，Snake。","cn_control_tokens":"","cn_utf8_bytes":53,"review_flag":""},{"unique_index":7,"cn_text":"掌握当地语言是情报工作的基本功。","cn_control_tokens":"","cn_utf8_bytes":48,"review_flag":""},{"unique_index":8,"cn_text":"不愧是Boss。用Trenya的语言说点什么给我听听吧。","cn_control_tokens":"","cn_utf8_bytes":64,"review_flag":""},{"unique_index":9,"cn_text":"喵？呜喵、呜喵喵……。","cn_control_tokens":"","cn_utf8_bytes":33,"review_flag":""},{"unique_index":10,"cn_text":"太厉害了！完全听不懂你在说什么！","cn_control_tokens":"","cn_utf8_bytes":48,"review_flag":""},{"unique_index":11,"cn_text":"是、是吗……。","cn_control_tokens":"","cn_utf8_bytes":21,"review_flag":""},{"unique_index":12,"cn_text":"那么，Trenya说了什么？","cn_control_tokens":"","cn_utf8_bytes":30,"review_flag":""},{"unique_index":13,"cn_text":"它说要带我去你之前提到的那座岛……。","cn_control_tokens":"","cn_utf8_bytes":54,"review_flag":""},{"unique_index":14,"cn_text":"真的！？那也带我去吧，Boss！","cn_control_tokens":"","cn_utf8_bytes":40,"review_flag":""},{"unique_index":15,"cn_text":"我知道你的心情，但还不知道那里有什么危险。先让我去看看情况。","cn_control_tokens":"","cn_utf8_bytes":90,"review_flag":""},{"unique_index":16,"cn_text":"太狡猾了，只让Snake一个人去。","cn_control_tokens":"","cn_utf8_bytes":41,"review_flag":""},{"unique_index":17,"cn_text":"别这么说。这里面有各种原因。","cn_control_tokens":"","cn_utf8_bytes":42,"review_flag":""},{"unique_index":18,"cn_text":"以后有机会再一起去吧。要是有余裕，我会拍些照片回来。这次就先忍忍吧。","cn_control_tokens":"","cn_utf8_bytes":102,"review_flag":""}]}