{"file_id":"BRIEFING_FILES_BLOCK_02D700","resource_class":"BRIEFING_NBE","status":"TRANSLATED_PENDING_CSV_MERGE","translations":[{"unique_index":0,"cn_text":"Catarata de la Muerte的意思是“死亡瀑布”。","cn_control_tokens":"","cn_utf8_bytes":54,"review_flag":""},{"unique_index":1,"cn_text":"真不吉利。","cn_control_tokens":"","cn_utf8_bytes":15,"review_flag":"JPN_OMINOUS_TONE_PRIMARY"},{"unique_index":2,"cn_text":"Snake的话一定没问题。毕竟你一路闯过了那么多绝境。","cn_control_tokens":"","cn_utf8_bytes":71,"review_flag":""},{"unique_index":3,"cn_text":"你说得倒轻松。","cn_control_tokens":"","cn_utf8_bytes":21,"review_flag":"AUX_ADDED_FUTURE_CLAUSE_REMOVED_PER_JPN"},{"unique_index":4,"cn_text":"对不起。不过我真的很惊讶。原来“传说中的士兵”那些故事都是真的……","cn_control_tokens":"","cn_utf8_bytes":99,"review_flag":"JPN_LEGENDARY_SOLDIER_WORDING_PRIMARY"},{"unique_index":5,"cn_text":"我既不是英雄，也不是什么传说。不过被你这么说，奇怪的是我倒不生气。","cn_control_tokens":"","cn_utf8_bytes":99,"review_flag":"JPN_NOT_ANGRY_TONE_PRIMARY"},{"unique_index":6,"cn_text":"谢谢。小心点，Snake。Peace。","cn_control_tokens":"","cn_utf8_bytes":37,"review_flag":""}]}