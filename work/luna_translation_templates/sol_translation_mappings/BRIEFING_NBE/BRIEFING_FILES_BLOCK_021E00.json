{"file_id":"BRIEFING_FILES_BLOCK_021E00","resource_class":"BRIEFING_NBE","status":"TRANSLATED_PENDING_CSV_MERGE","translations":[{"unique_index":0,"cn_text":"拿狙击步枪或火箭弹类大型发射器的敌人，基本不会主动拉近与你的距离。","cn_control_tokens":"","cn_utf8_bytes":99,"review_flag":"NO_RELIABLE_AUX_JPN_ONLY"},{"unique_index":1,"cn_text":"他们会不断转移位置，抓住你的破绽进行狙击。","cn_control_tokens":"","cn_utf8_bytes":63,"review_flag":"NO_RELIABLE_AUX_JPN_ONLY"},{"unique_index":2,"cn_text":"以眼还眼，以牙还牙。用狙击步枪对付他们吧。注意别轻易暴露自己，反过来打他们一个措手不及。","cn_control_tokens":"","cn_utf8_bytes":132,"review_flag":"NO_RELIABLE_AUX_JPN_ONLY"}]}