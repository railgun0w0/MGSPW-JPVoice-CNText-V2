{"file_id":"BRIEFING_FILES_BLOCK_060450","resource_class":"BRIEFING_NBE","status":"TRANSLATED_PENDING_CSV_MERGE","translations":[{"unique_index":0,"cn_text":"说到阿尔及利亚独立战争，你知道《豺狼的日子》吗？","cn_control_tokens":"","cn_utf8_bytes":72,"review_flag":""},{"unique_index":1,"cn_text":"就是去年被拍成电影的那本小说吧？","cn_control_tokens":"","cn_utf8_bytes":48,"review_flag":""},{"unique_index":2,"cn_text":"<R=秘密军事组织,OAS>企图暗杀戴高乐总统，雇用了一个叫“豺狼”的狙击手……。","cn_control_tokens":"[\"<R=秘密军事组织,OAS>\"]","cn_utf8_bytes":107,"review_flag":"RUBY_READING_ROMANIZED"},{"unique_index":3,"cn_text":"明明知道现实中发生了什么，我还是看得心跳加速。","cn_control_tokens":"","cn_utf8_bytes":69,"review_flag":""},{"unique_index":4,"cn_text":"如果哪天有人要狙击我，我也希望他能像那样仔仔细细地调查。","cn_control_tokens":"","cn_utf8_bytes":84,"review_flag":""},{"unique_index":5,"cn_text":"在我毫不知情的情况下，把我的一切都调查得一清二楚。","cn_control_tokens":"","cn_utf8_bytes":75,"review_flag":""},{"unique_index":6,"cn_text":"是吗？","cn_control_tokens":"","cn_utf8_bytes":9,"review_flag":""},{"unique_index":7,"cn_text":"也许被我观察的那些鸟，也会有同样的感觉……。","cn_control_tokens":"","cn_utf8_bytes":66,"review_flag":""},{"unique_index":8,"cn_text":"谁知道呢。","cn_control_tokens":"","cn_utf8_bytes":15,"review_flag":""},{"unique_index":9,"cn_text":"啾——、啾——……。","cn_control_tokens":"","cn_utf8_bytes":30,"review_flag":""},{"unique_index":10,"cn_text":"喂，Cécile？","cn_control_tokens":"","cn_utf8_bytes":16,"review_flag":""},{"unique_index":11,"cn_text":"这是凤尾绿咬鹃的心情。","cn_control_tokens":"","cn_utf8_bytes":33,"review_flag":""}]}