{"file_id":"BRIEFING_MISSION_BLOCK_372710","resource_class":"BRIEFING_NBE","status":"TRANSLATED_PENDING_CSV_MERGE","translations":[{"unique_index":0,"cn_text":"有能炸掉路障的东西吗？","cn_control_tokens":"","cn_utf8_bytes":33,"review_flag":""},{"unique_index":1,"cn_text":"没有……。还得看是什么样的路障，不过应该需要威力很大的炸药。Mother Base那边不能想想办法吗？","cn_control_tokens":"","cn_utf8_bytes":131,"review_flag":""},{"unique_index":2,"cn_text":"让研发班制造C4怎么样？","cn_control_tokens":"","cn_utf8_bytes":32,"review_flag":""},{"unique_index":3,"cn_text":"如果人手不够，恐怕还得想办法从别处招人……。","cn_control_tokens":"","cn_utf8_bytes":66,"review_flag":""},{"unique_index":4,"cn_text":"Snake，先确认一下Mother Base目前的状况。","cn_control_tokens":"","cn_utf8_bytes":52,"review_flag":""},{"unique_index":5,"cn_text":"Snake，要前往山区，就必须炸掉村子的闸门，再向北前进。","cn_control_tokens":"","cn_utf8_bytes":77,"review_flag":""},{"unique_index":6,"cn_text":"摧毁闸门需要C4炸药。先弄到C4。","cn_control_tokens":"","cn_utf8_bytes":43,"review_flag":""}]}