{"file_id":"BRIEFING_FILES_BLOCK_03E0D0","resource_class":"BRIEFING_NBE","status":"TRANSLATED_PENDING_CSV_MERGE","translations":[{"unique_index":0,"cn_text":"有Snake的消息吗？","cn_control_tokens":"","cn_utf8_bytes":23,"review_flag":""},{"unique_index":1,"cn_text":"通讯接不上……他还在Strangelove博士手里。","cn_control_tokens":"","cn_utf8_bytes":56,"review_flag":""},{"unique_index":2,"cn_text":"怎么会！","cn_control_tokens":"","cn_utf8_bytes":12,"review_flag":""},{"unique_index":3,"cn_text":"现在只能相信Boss，等下去。","cn_control_tokens":"","cn_utf8_bytes":37,"review_flag":""},{"unique_index":4,"cn_text":"要等到什么时候？","cn_control_tokens":"","cn_utf8_bytes":24,"review_flag":""},{"unique_index":5,"cn_text":"Amanda，你生气的声音也很迷人，不过先冷静一下。我们准备了应急工具。","cn_control_tokens":"","cn_utf8_bytes":96,"review_flag":""},{"unique_index":6,"cn_text":"什么工具？他们不可能漏掉的。","cn_control_tokens":"","cn_utf8_bytes":42,"review_flag":""},{"unique_index":7,"cn_text":"不。就算把身上所有东西都搜走，他们也不会发现那个。","cn_control_tokens":"","cn_utf8_bytes":75,"review_flag":""},{"unique_index":8,"cn_text":"Snake应该有好好带在身上。","cn_control_tokens":"","cn_utf8_bytes":35,"review_flag":""}]}