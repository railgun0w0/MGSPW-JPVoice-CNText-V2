{"file_id":"BRIEFING_FILES_BLOCK_03E470","resource_class":"BRIEFING_NBE","status":"TRANSLATED_PENDING_CSV_MERGE","translations":[{"unique_index":0,"cn_text":"Snake，你没事吧？","cn_control_tokens":"","cn_utf8_bytes":23,"review_flag":""},{"unique_index":1,"cn_text":"嗯。这次一定要阻止Peace Walker。","cn_control_tokens":"","cn_utf8_bytes":42,"review_flag":""},{"unique_index":2,"cn_text":"Snake，别太勉强自己。","cn_control_tokens":"","cn_utf8_bytes":29,"review_flag":""},{"unique_index":3,"cn_text":"那可做不到。","cn_control_tokens":"","cn_utf8_bytes":18,"review_flag":""},{"unique_index":4,"cn_text":"除了敌兵之外，也有可能会投入Chicolibrí。要是跟那些家伙一一纠缠，有几条命都不够用。","cn_control_tokens":"","cn_utf8_bytes":119,"review_flag":""},{"unique_index":5,"cn_text":"如果有能一下子让机器停止运转的武器，用那个也许更省事。","cn_control_tokens":"","cn_utf8_bytes":81,"review_flag":""},{"unique_index":6,"cn_text":"仔细考虑后再整备装备。","cn_control_tokens":"","cn_utf8_bytes":33,"review_flag":""}]}