    {"unique_index":0,"cn_text":"别忘了安排MSF人员的岗位。人员配置会决定Mother Base的发展方向。","cn_control_tokens":"","cn_utf8_bytes":86,"review_flag":"AUX_PARTIAL_JPN_DETAIL_RESTORED"},
    {"unique_index":1,"cn_text":"嗯。","cn_control_tokens":"","cn_utf8_bytes":6,"review_flag":""},
    {"unique_index":2,"cn_text":"我也随你安排，放哪都行。","cn_control_tokens":"","cn_utf8_bytes":36,"review_flag":""},
    {"unique_index":3,"cn_text":"你也要？　你可是Mother Base的副司令吧。","cn_control_tokens":"","cn_utf8_bytes":53,"review_flag":""},
    {"unique_index":4,"cn_text":"当然，那边的工作我也不会马虎。","cn_control_tokens":"","cn_utf8_bytes":45,"review_flag":"AUX_PARAPHRASE_JPN_NUANCE_RESTORED"},
    {"unique_index":5,"cn_text":"不过，趁MSF规模还小，我也没闲到能靠在椅子上摆架子。","cn_control_tokens":"","cn_utf8_bytes":75,"review_flag":""},
    {"unique_index":6,"cn_text":"话是这么说……","cn_control_tokens":"","cn_utf8_bytes":21,"review_flag":""},
    {"unique_index":7,"cn_text":"不是我吹，哪个班的工作交给我，我都能干得很出色。","cn_control_tokens":"","cn_utf8_bytes":72,"review_flag":""},
    {"unique_index":8,"cn_text":"把我安排到你最想重点发展的部门吧。那个班的成员，我会特别关照的。","cn_control_tokens":"","cn_utf8_bytes":96,"review_flag":"AUX_PARTIAL_JPN_DETAIL_RESTORED"},
    {"unique_index":9,"cn_text":"Kaz，悠着点。","cn_control_tokens":"","cn_utf8_bytes":18,"review_flag":""}
