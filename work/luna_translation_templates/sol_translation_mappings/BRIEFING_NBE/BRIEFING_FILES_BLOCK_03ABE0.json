{"file_id":"BRIEFING_FILES_BLOCK_03ABE0","resource_class":"BRIEFING_NBE","status":"TRANSLATED_PENDING_CSV_MERGE","translations":[{"unique_index":0,"cn_text":"Boss，你被敌方坦克袭击了？有没有地方能躲？","cn_control_tokens":"","cn_utf8_bytes":61,"review_flag":""},{"unique_index":1,"cn_text":"可以利用列车隐蔽。不过要是挨上主炮就完了……。","cn_control_tokens":"","cn_utf8_bytes":69,"review_flag":""},{"unique_index":2,"cn_text":"连货运列车也会轻易被轰飞吗……。","cn_control_tokens":"","cn_utf8_bytes":48,"review_flag":""},{"unique_index":3,"cn_text":"不过躲起来也不是没用。对方也没法瞄准看不见的目标。","cn_control_tokens":"","cn_utf8_bytes":75,"review_flag":""},{"unique_index":4,"cn_text":"一边隐蔽一边找机会，瞄准履带或后部的油箱……。","cn_control_tokens":"","cn_utf8_bytes":69,"review_flag":""},{"unique_index":5,"cn_text":"不过得小心主炮，就是这么回事。","cn_control_tokens":"","cn_utf8_bytes":45,"review_flag":""},{"unique_index":6,"cn_text":"还要留意步兵。他们可能会绕到你侧面。","cn_control_tokens":"","cn_utf8_bytes":54,"review_flag":""},{"unique_index":7,"cn_text":"明白。","cn_control_tokens":"","cn_utf8_bytes":9,"review_flag":""},{"unique_index":8,"cn_text":"只要让步兵失去战斗力，也能压制敌方部队。Snake，加油！","cn_control_tokens":"","cn_utf8_bytes":77,"review_flag":""}]}