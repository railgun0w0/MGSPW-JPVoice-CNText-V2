      "review_flag": "JPN_PRIMARY; MLG_CN_CONTEXT_AUXILIARY"
    },
    {
      "unique_index": 6,
      "cn_text": "我以前也常和朋友爬上屋顶玩。\\n被<R=老爸,MI VIEJO>发现就会挨揍。",
      "cn_control_tokens": "<R=老爸,MI VIEJO>",
