    {"unique_index":11,"cn_text":"趴下时恢复得更快。","cn_control_tokens":"","cn_utf8_bytes":27,"review_flag":""},
    {"unique_index":12,"cn_text":"使用军粮可以恢复LIFE槽。","cn_control_tokens":"","cn_utf8_bytes":34,"review_flag":""},
    {"unique_index":13,"cn_text":"按方向键下蹲下。","cn_control_tokens":"","cn_utf8_bytes":24,"review_flag":""},
    {"unique_index":14,"cn_text":"按A键蹲下。","cn_control_tokens":"","cn_utf8_bytes":16,"review_flag":""},
    {"unique_index":15,"cn_text":"要趴下，按住方向键下。","cn_control_tokens":"","cn_utf8_bytes":33,"review_flag":""},
    {"unique_index":16,"cn_text":"要趴下，按住A键。","cn_control_tokens":"","cn_utf8_bytes":25,"review_flag":""},
    {"unique_index":17,"cn_text":"很遗憾，这次不能匍匐前进。","cn_control_tokens":"","cn_utf8_bytes":39,"review_flag":""},
    {"unique_index":18,"cn_text":"轻推<I=MOVE>就会慢慢走。","cn_control_tokens":"<I=MOVE>","cn_utf8_bytes":32,"review_flag":""},
    {"unique_index":19,"cn_text":"不想发出声音，就一点一点轻轻走。","cn_control_tokens":"","cn_utf8_bytes":48,"review_flag":""},
    {"unique_index":20,"cn_text":"别出声！会被发现！","cn_control_tokens":"","cn_utf8_bytes":27,"review_flag":"AUX_EXTRA_BOSS_OMITTED"},
    {"unique_index":21,"cn_text":"屏幕右上角的指示器\\n会显示方向、声音来源位置等信息。","cn_control_tokens":"","cn_utf8_bytes":76,"review_flag":"NO_RELIABLE_AUX_MAPPING"},
    {"unique_index":22,"cn_text":"留意周围的情况。","cn_control_tokens":"","cn_utf8_bytes":24,"review_flag":""},
