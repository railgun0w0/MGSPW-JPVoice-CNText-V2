    {"unique_index":24,"cn_text":"伪装指数越低，就越容易被敌人发现。","cn_control_tokens":"","cn_utf8_bytes":51,"review_flag":"TERM_REVIEW_CAMO_INDEX"},
    {"unique_index":25,"cn_text":"动作太大或发出巨响，\\n都会降低伪装指数。","cn_control_tokens":"","cn_utf8_bytes":58,"review_flag":"TERM_REVIEW_CAMO_INDEX"},
    {"unique_index":26,"cn_text":"作战服具有伪装效果。","cn_control_tokens":"","cn_utf8_bytes":30,"review_flag":""},
