    {"unique_index":8,"cn_text":"LIFE槽右边是精神槽。\\n消耗过多会影响行动。","cn_control_tokens":"","cn_utf8_bytes":59,"review_flag":"NO_RELIABLE_AUX_MAPPING"},
    {"unique_index":9,"cn_text":"LIFE槽会随时间恢复。\\n精神槽也一样。","cn_control_tokens":"","cn_utf8_bytes":50,"review_flag":""},
