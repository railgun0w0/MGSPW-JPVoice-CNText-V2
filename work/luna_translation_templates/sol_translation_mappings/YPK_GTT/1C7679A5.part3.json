{"file_id":"1C7679A5","resource_class":"YPK_GTT","part":3,"range":[116,173],"status":"TRANSLATED_PENDING_CSV_MERGE","translations":[{"unique_index":116,"cn_text":"Snake，为什么射击同伴！？","cn_control_tokens":"","cn_utf8_bytes":35,"review_flag":""},{"unique_index":117,"cn_text":"我看错你了，Snake。\n居然向同伴开枪。","cn_control_tokens":"","cn_utf8_bytes":51,"review_flag":""},{"unique_index":118,"cn_text":"为什么向同伴开枪！？","cn_control_tokens":"","cn_utf8_bytes":30,"review_flag":""},{"unique_index":119,"cn_text":"混蛋！\n别射击同伴！！","cn_control_tokens":"","cn_utf8_bytes":31,"review_flag":""},{"unique_index":120,"cn_text":"同伴倒下了！\n做心脏按摩把他救回来。","cn_control_tokens":"","cn_utf8_bytes":52,"review_flag":""},{"unique_index":121,"cn_text":"快去救同伴！\n还来得及！！","cn_control_tokens":"","cn_utf8_bytes":37,"review_flag":""},{"unique_index":122,"cn_text":"连按<I=ACT>可以更快恢复。","cn_control_tokens":"<I=ACT>","cn_utf8_bytes":34,"review_flag":""},{"unique_index":123,"cn_text":"快救他！\n连按<I=ACT>！","cn_control_tokens":"<I=ACT>","cn_utf8_bytes":29,"review_flag":""},{"unique_index":124,"cn_text":"同伴正在救你！\n再坚持一下！","cn_control_tokens":"","cn_utf8_bytes":40,"review_flag":""},{"unique_index":125,"cn_text":"别放弃！\n等同伴来救你。","cn_control_tokens":"","cn_utf8_bytes":34,"review_flag":""},{"unique_index":126,"cn_text":"别放弃，绝对别放弃！","cn_control_tokens":"","cn_utf8_bytes":30,"review_flag":""},{"unique_index":127,"cn_text":"快给他做心脏按摩！","cn_control_tokens":"","cn_utf8_bytes":27,"review_flag":""},{"unique_index":128,"cn_text":"同伴快死了！\n快去救他！","cn_control_tokens":"","cn_utf8_bytes":34,"review_flag":""},{"unique_index":129,"cn_text":"救救同伴！\n现在做心脏按摩还来得及！","cn_control_tokens":"","cn_utf8_bytes":52,"review_flag":""},{"unique_index":130,"cn_text":"试试心脏按摩，\n也许能让他恢复呼吸。","cn_control_tokens":"","cn_utf8_bytes":52,"review_flag":""},{"unique_index":131,"cn_text":"拜托，救救同伴！","cn_control_tokens":"","cn_utf8_bytes":24,"review_flag":""},{"unique_index":132,"cn_text":"要和同伴通信，\n就从菜单窗口使用CO-OPS通信。","cn_control_tokens":"","cn_utf8_bytes":61,"review_flag":""},{"unique_index":133,"cn_text":"也可以打开CONTROLLER SETTINGS，\n把它分配到喜欢的按键上。","cn_control_tokens":"","cn_utf8_bytes":74,"review_flag":""},{"unique_index":134,"cn_text":"使用CO-OPS通信，\n就能在不惊动周围的情况下联系同伴。","cn_control_tokens":"","cn_utf8_bytes":73,"review_flag":""},{"unique_index":135,"cn_text":"要和同伴通信，\n按<I=COOPS_COMMS>使用CO-OPS通信。","cn_control_tokens":"<I=COOPS_COMMS>","cn_utf8_bytes":61,"review_flag":""},{"unique_index":136,"cn_text":"没有军粮时，可以趴下休息。\n找个安全的地方。","cn_control_tokens":"","cn_utf8_bytes":64,"review_flag":""},{"unique_index":137,"cn_text":"装备军粮后，即使LIFE降到0也会自动恢复。","cn_control_tokens":"","cn_utf8_bytes":56,"review_flag":""},{"unique_index":138,"cn_text":"趁LIFE没耗尽，记得及时恢复。\n也可以装备军粮。","cn_control_tokens":"","cn_utf8_bytes":65,"review_flag":""},{"unique_index":139,"cn_text":"及时恢复。\nLIFE耗尽就结束了。","cn_control_tokens":"","cn_utf8_bytes":41,"review_flag":""},{"unique_index":140,"cn_text":"饿了吧？\n吃点军粮怎么样？","cn_control_tokens":"","cn_utf8_bytes":37,"review_flag":""},{"unique_index":141,"cn_text":"吃军粮！\n不然会死！","cn_control_tokens":"","cn_utf8_bytes":28,"review_flag":""},{"unique_index":142,"cn_text":"用军粮！\nLIFE很危险！","cn_control_tokens":"","cn_utf8_bytes":29,"review_flag":""},{"unique_index":143,"cn_text":"LIFE在下降！\n用军粮！","cn_control_tokens":"","cn_utf8_bytes":29,"review_flag":""},{"unique_index":144,"cn_text":"LIFE太低了！\n现在是打无线电的时候吗！？","cn_control_tokens":"","cn_utf8_bytes":56,"review_flag":""},{"unique_index":145,"cn_text":"没军粮也没关系，\n趴下休息就行。","cn_control_tokens":"","cn_utf8_bytes":46,"review_flag":""},{"unique_index":146,"cn_text":"集中力下降会要命，\n偶尔休息一下。","cn_control_tokens":"","cn_utf8_bytes":49,"review_flag":""},{"unique_index":147,"cn_text":"Snake，偶尔也休息一下。","cn_control_tokens":"","cn_utf8_bytes":32,"review_flag":""},{"unique_index":148,"cn_text":"长时间行动会降低集中力，\n在战场上是致命的。","cn_control_tokens":"","cn_utf8_bytes":64,"review_flag":""},{"unique_index":149,"cn_text":"偶尔休息一下，\n这也是任务的一部分。","cn_control_tokens":"","cn_utf8_bytes":52,"review_flag":""},{"unique_index":150,"cn_text":"Snake，差不多该休息了……","cn_control_tokens":"","cn_utf8_bytes":35,"review_flag":""},{"unique_index":151,"cn_text":"有什么想知道的，\n就用无线电联系我。","cn_control_tokens":"","cn_utf8_bytes":52,"review_flag":""},{"unique_index":152,"cn_text":"打开菜单窗口，\n进行无线电CALL。","cn_control_tokens":"","cn_utf8_bytes":44,"review_flag":""},{"unique_index":153,"cn_text":"Miller呼叫。\n无线电信号良好。","cn_control_tokens":"","cn_utf8_bytes":40,"review_flag":""},{"unique_index":154,"cn_text":"要使用CQC，\n在敌人附近按<I=ATK>。","cn_control_tokens":"<I=ATK>","cn_utf8_bytes":44,"review_flag":""},{"unique_index":155,"cn_text":"要换弹，\n就在举枪状态下按<I=RELOAD>。","cn_control_tokens":"<I=RELOAD>","cn_utf8_bytes":50,"review_flag":""},{"unique_index":156,"cn_text":"举枪时按<I=RELOAD>即可换弹。","cn_control_tokens":"<I=RELOAD>","cn_utf8_bytes":37,"review_flag":""},{"unique_index":157,"cn_text":"即使没有显示图标，\n也可以按<I=RELOAD>换弹。","cn_control_tokens":"<I=RELOAD>","cn_utf8_bytes":59,"review_flag":""},{"unique_index":158,"cn_text":"匍匐时不能使用武器。","cn_control_tokens":"","cn_utf8_bytes":30,"review_flag":""},{"unique_index":159,"cn_text":"那家伙已经没有威胁了。\n只要同伴不来，应该不会再做什么。","cn_control_tokens":"","cn_utf8_bytes":82,"review_flag":""},{"unique_index":160,"cn_text":"可以直接对他进行富尔顿回收。","cn_control_tokens":"","cn_utf8_bytes":42,"review_flag":""},{"unique_index":161,"cn_text":"小心，附近有敌人。","cn_control_tokens":"","cn_utf8_bytes":27,"review_flag":""},{"unique_index":162,"cn_text":"敌人好像还没发现。","cn_control_tokens":"","cn_utf8_bytes":27,"review_flag":""},{"unique_index":163,"cn_text":"趁现在让他睡着也是个办法。","cn_control_tokens":"","cn_utf8_bytes":39,"review_flag":""},{"unique_index":164,"cn_text":"要回收阔剑地雷，\n从背后接近。","cn_control_tokens":"","cn_utf8_bytes":43,"review_flag":""},{"unique_index":165,"cn_text":"按<I=ACT>回收阔剑地雷！","cn_control_tokens":"<I=ACT>","cn_utf8_bytes":31,"review_flag":""},{"unique_index":166,"cn_text":"撞到敌人，纸箱会被解除。","cn_control_tokens":"","cn_utf8_bytes":36,"review_flag":""},{"unique_index":167,"cn_text":"戴着纸箱时也能使用武器攻击。","cn_control_tokens":"","cn_utf8_bytes":42,"review_flag":""},{"unique_index":168,"cn_text":"那种东西真能骗过敌人吗？","cn_control_tokens":"","cn_utf8_bytes":36,"review_flag":""},{"unique_index":169,"cn_text":"那个纸箱原来装什么的？","cn_control_tokens":"","cn_utf8_bytes":33,"review_flag":""},{"unique_index":170,"cn_text":"用纸箱吗，想得不错。","cn_control_tokens":"","cn_utf8_bytes":30,"review_flag":""},{"unique_index":171,"cn_text":"哦，挺有一套……","cn_control_tokens":"","cn_utf8_bytes":24,"review_flag":""},{"unique_index":172,"cn_text":"你、你在干什么？","cn_control_tokens":"","cn_utf8_bytes":24,"review_flag":""},{"unique_index":173,"cn_text":"喜欢狭窄的地方吗？","cn_control_tokens":"","cn_utf8_bytes":27,"review_flag":""}]}