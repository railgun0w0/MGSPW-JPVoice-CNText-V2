    [0,"这家伙……难道……","",null,""],[1,"是你！","",null,""],[2,"不如说……我恨你。","",null,""],[3,"我并不是思念你……","",null,""],[4,"……我一直在等你。","",null,""],[5,"你就是Strangelove博士吧。","",null,""],[6,"你是……","",null,""],[7,"谁？","",null,""],[8,"Boss……？！","",null,""],[9,"看来你捡回一条命。<->","<->",null,"CONTROL_OK"],[10,"手持武器的人都说着同样的<R=威慑力,话>。","<R=威慑力,话>",null,"CONTROL_OK"],[11,"‘不许动’吗……","",null,""],[12,"不许动！","",null,""],[13,"杀了我！","",null,""],[14,"就像杀死Boss那样。","",null,""],[15,"来吧，用同样的方式杀了我。","",null,""],[16,"我知道。\n也知道你十年前做过什么。","",null,"NEWLINE_PRESERVED"],[17,"你是来毁掉我的研究成果吧。","",null,""],[18,"回答我！","",null,""],[19,"这就是你的‘忠诚’吗？","",null,""],[20,"你为了任务赋予的权力，杀死了真正的英雄。","",null,""],[21,"你让全世界的战士失望。","",null,""],[22,"你没有选择养育你的‘恩人’，\n而是选择了虚无的‘国家’。","",null,"NEWLINE_PRESERVED"],[23,"那个杀人换来的肮脏名号，\n你还挂在身上吗？","",null,"NEWLINE_PRESERVED"],[24,"Snake！不，该叫你<R=BIG BOSS,Big Boss>吗？","<R=BIG BOSS,Big Boss>",null,"CONTROL_OK"],[25,"……那个女人背叛了<R=祖国,美国>。","<R=祖国,美国>",null,"CONTROL_OK"],[26,"来吧！到底怎么样？！","",null,""],[27,"Boss她……","",null,""],[28,"偷走<R=核武器,Davy Crockett>后叛逃了。","<R=核武器,Davy Crockett>",null,"CONTROL_OK"],[29,"你是Boss的……","",null,""],[30,"这就是你为了保护自己得出的结论？","",null,""],[31,"……那是<R=任务,任务>。","<R=任务,任务>",null,"CONTROL_OK"],[32,"给你在这世上最爱的恩人扣上污名，\n再亲手埋葬她吗？","",null,"NEWLINE_PRESERVED"],[33,"这就是世人所知的全部真相。","",null,""],[34,"那就是‘真相’吗？","",null,""],[35,"当时，只有Boss的死能阻止全面核战争。","",null,""],[36,"向苏联证明<R=本国,美国>的清白。","<R=本国,美国>",null,"CONTROL_OK"],[37,"我和你一样，都是行尸走肉。","",null,""],[38,"在从深爱的她那里得到答案前，我连死都做不到……","",null,""],[39,"我是被遗弃在这个世界上的人。","",null,""],[40,"美国政府亲手除掉那个叛徒，借此……","",null,""],[41,"她用<R=合众国,美国>的核武器攻击了苏联领土。","<R=合众国,美国>",null,"CONTROL_OK"],[42,"……你说什么？","",null,""],[43,"你夺走了她的生命，而我让她重生。","",null,""],[44,"你想见她吧？我可以让你见到。","",null,""],[45,"还真敢说。","",null,""],[46,"Boss已经不在人世了。","",null,""],[47,"想见她吗？","",null,""],[48,"这边走。","",null,""],[49,"想见她，就趁现在抽吧。","",null,""],[50,"再往前就禁烟了。","",null,""],[51,"只是<R=鼻烟,鼻烟>。你不是抽<R=雪茄,雪茄>吗？","<R=鼻烟,鼻烟> | <R=雪茄,雪茄>",null,"CONTROL_OK"],[52,"……来一点吗？","",null,""],[53,"CIA所掌握的全部数据。","",null,""],[54,"作为协助计划的条件，\n我索取了The Boss的一切资料。","",null,"NEWLINE_PRESERVED"],[55,"哺乳舱……？","",null,""],[56,"我称它为‘哺乳舱’。","",null,""],[57,"……是Boss吗？","",null,""],[58,"Boss呢？","",null,""],[59,"<R=战士,War fighter>。","<R=战士,War fighter>",null,"CONTROL_OK"],[60,"一个男人……","",null,""],[61,"创造一种无人装置作为威慑力量，\n完成只有人类无法做到的判断与行动。","",null,"NEWLINE_PRESERVED"],[62,"基于<R=相互确保摧毁,MAD>的<R=人工智能,AI>，\n在假想敌核袭击时对最佳地点实施有效报复。","<R=相互确保摧毁,MAD> | <R=人工智能,AI>",null,"CONTROL_OK;NEWLINE_PRESERVED"],[63,"Coldman的要求是这样的。","",null,""],[64,"为什么要那么做？","",null,""],[65,"也包括你的一切。","",null,""],[66,"痛苦与快乐、<R=喜悦,Joy>与<R=悲伤,Sorrow>，以及生与死的一切。","<R=喜悦,Joy> | <R=悲伤,Sorrow>",null,"CONTROL_OK"],[67,"她在各种情况下作过怎样的判断，\n夺走过什么，又被夺走过什么。","",null,"NEWLINE_PRESERVED"],[68,"她的成长经历、从军记录和身体数据，\n所有行动档案与通信记录。","",null,"NEWLINE_PRESERVED"],[69,"但你真正的目的是什么？","",null,""],[70,"据我所知，世上只有一个人\n可以被托付全人类的咽喉。","",null,"NEWLINE_PRESERVED"],[71,"……这话没错。","",null,""],[72,"所以你才索取The Boss的一切？","",null,""],[73,"<->‘我需要最卓越的共感型大脑的思维模式。’","<->",null,"CONTROL_OK"],[74,"‘能从全球尺度思考，审视过去与未来，\n在痛苦之后作出最佳判断的人。’<->","<->",null,"CONTROL_OK;NEWLINE_PRESERVED"],[75,"但我特意为那个男人准备了不同的答案。","",null,""],[76,"为此编写冷酷<R=机器,机器>的程序。","<R=机器,机器>",null,"CONTROL_OK"],[77,"我想确认Boss的真相……她最后的<R=意志,意志>。","<R=意志,意志>",null,"CONTROL_OK"],[78,"不是人为创造的虚构……","",null,""],[79,"她为何必须被最爱的弟子——你\n亲手暗杀？","",null,"NEWLINE_PRESERVED"],[80,"身为传奇英雄的她为何投敌？","",null,""],[81,"为了洗清The Boss的污名。","",null,""],[82,"要让对方无法再次发动核攻击，\n就必须迅速、确实、彻底地消灭对方。","",null,"NEWLINE_PRESERVED"],[83,"我的结论是这样的。","",null,""],[84,"Jack……！","",null,""],[85,"Jack……","",null,""],[86,"去直接问她本人吧……Jack。","",null,""],[87,"你想重现The Boss当时的<R=最后思念,遗愿>\n吗？","<R=最后思念,遗愿>",null,"CONTROL_OK;NEWLINE_PRESERVED"],[88,"哦……你理解她的心情吗？","",null,""],[89,"不，Boss她……抛弃了国家，也抛弃了我们。","",null,""],[90,"那也正是你想知道的事吧。","",null,""],[91,"不，不是。我……","",null,""],[92,"回去！","",null,""],[93,"Boss……","",null,""],[94,"回去！我已经不再是你的Boss了！","",null,""],[95,"Jack！","",null,""],[96,"Boss……？","",null,""],[97,"如果你还能再次夺走那高贵的灵魂……","",null,""],[98,"完成你的<R=目的,任务>吧，Snake。","<R=目的,任务>