  "translations":[
    [0,"放心吧，我没打算给你新的<R=任务,任务>。\n","<R=任务,任务>",null,"CONTROL_OK"],[1,"……<R=胜利,VICTORY>的Boss。","<R=胜利,VICTORY>",null,"CONTROL_OK"],[2,"非常抱歉。","",null,""],[3,"叫我Snake就好。","",null,""],[4,"十分感谢！<R=BIG BOSS,Big Boss>！","<R=BIG BOSS,Big Boss>",null,"CONTROL_OK"],[5,"是我带他们来的，没人跟踪。","",null,""],[6,"不是<R=CIA,他们>。","<R=CIA,他们>",null,"CONTROL_OK"],[7,"不用担心。","",null,""],[8,"要撤离吗？","",null,""],[9,"我们……哪一种都不被允许。","",null,""],[10,"<R=否则便只有死亡,Victoria o Muerte>’？","<R=否则便只有死亡,Victoria o Muerte>",null,"CONTROL_OK"],[11,"‘要么<R=胜利,Victoria>，<->","<R=胜利,Victoria> | <->",null,"CONTROL_OK"],[12,"我们没有胜利可言。","",null,""],[13,"听好了。","",null,""],[14,"有客人。","",null,""],[15,"怎么了，Kaz？","",null,""],[16,"谢谢。","",null,""],[17,"你们来哥伦比亚做什么？","",null,""],[18,"哥斯达黎加政府的一位大人物……","",null,""],[19,"那么……","",null,""],[20,"果然还是哥斯达黎加咖啡好喝。","",null,""],[21,"……活过来了！","",null,""],[22,"和平宪法……","",null,""],[23,"宪法第12条：\n‘禁止将军队作为常设组织。’","",null,"NEWLINE_PRESERVED"],[24,"是的。","",null,""],[25,"哥斯达黎加不设军队……","",null,""],[26,"当然，他们不是正规军。","",null,""],[27,"哥斯达黎加境内开始有人目击武装团体。","",null,""],[28,"大约从一年前开始。","",null,""],[29,"其实……","",null,""],[30,"我是哥斯达黎加联合国和平大学的Galvez教授。","",null,""],[31,"政府声称他们是‘跨国企业的警卫’。","",null,""],[32,"受<R=哥斯达黎加开发公司,CODESA>雇佣。","<R=哥斯达黎加开发公司,CODESA>",null,"CONTROL_OK"],[33,"哥斯达黎加政府怎么说？","",null,""],[34,"不，他们看起来不像游击队，而是更有组织。","",null,""],[35,"不是从尼加拉瓜逃来的<R=反政府组织,FSLN>吗？","<R=反政府组织,FSLN>",null,"CONTROL_OK"],[36,"我们不能拿起武器。","",null,""],[37,"所以政府赶不走他们？","",null,""],[38,"即使古巴导弹危机之后，我们仍勉强维持着\n与美国之间微妙的<R=均衡,平衡>。","<R=均衡,平衡>",null,"CONTROL_OK;NEWLINE_PRESERVED"],[39,"如你所知，中南美洲是美国的后院……","",null,""],[40,"CIA？","",null,""],[41,"<R=CIA,La CIA>参与其中。","<R=CIA,La CIA>",null,"CONTROL_OK"],[42,"……恐怕是的。","",null,""],[43,"他们哪来那么多资金？","",null,""],[44,"我们想委托你们——‘<R=无国界军队,Militaires Sans Frontières>’。","<R=无国界军队,Militaires Sans Frontières>",null,"CONTROL_OK"],[45,"请把他们赶出\n没有军队的哥斯达黎加。","",null,"NEWLINE_PRESERVED"],[46,"拜托了。","",null,""],[47,"听说你们不受国家或思想<R=约束,束缚>，\n会与任何敌人作战。","<R=约束,束缚>",null,"CONTROL_OK;NEWLINE_PRESERVED"],[48,"那是‘放弃战争’，不保有军队。","",null,""],[49,"日本也有被称作和平宪法的‘第九条’。","",null,""],[50,"他们正大量运入\n最先进的武器和设备。","",null,"NEWLINE_PRESERVED"],[51,"当然，那全是谎言。","",null,""],[52,"我们需要一个能安顿下来的地方。","",null,""],[53,"Snake。","",null,""],[54,"<R=哥伦比亚,这里>也正变得不安全。","<R=哥伦比亚,这里>",null,"CONTROL_OK"],[55,"这不是挺好吗？","",null,""],[56,"我们可以提供加勒比海上的海上平台，\n作为你们的前线基地。","",null,"NEWLINE_PRESERVED"],[57,"但是……","",null,""],[58,"我是以‘教育者’的身份来的。","",null,""],[59,"今晚来到这里……","",null,""],[60,"我在大学里宣讲和平已有数十年。","",null,""],[61,"那你来做什么？","",null,""],[62,"……报酬恐怕算不上丰厚。","",null,""],[63,"我不是代表政府来的。","",null,""],[64,"不。","",null,""],[65,"告诉他们，我可以介绍一位熟识的<R=谈判专家,谈判专家>。","<R=谈判专家,谈判专家>",null,"CONTROL_OK"],[66,"回去转告政府的大人物吧。","",null,""],[67,"国家无法行动。","",null,""],[68,"只能通过政治手段解决。","",null,""],[69,"如果<R=那些家伙,CIA>牵涉其中，武力解决不了问题。","<R=那些家伙,CIA>",null,"CONTROL_OK"],[70,"请帮帮我们！","",null,""],[71,"拜托了！","",null,""],[72,"我们希望你们成为‘威慑力’。","",null,""],[73,"我们只是舍弃了国家。","",null,""],[74,"我们……","",null,""],[75,"你听说我们是不隶属于任何国家的军队……","",null,""],[76,"是的，我是这样听说的。","",null,""],[77,"你似乎把我们误当成了‘<R=战争之犬,The Dogs of War>’之类的\n人。","<R=战争之犬,The Dogs of War>",null,"CONTROL_OK"],[78,"等等！","",null,""],[79,"我会去交涉。","",null,""],[80,"可以的话，我们还<R=需要,要>直升机代步。","<R=需要,要>",null,"CONTROL_OK"],[81,"我已经争取到了政府的合作。","",null,""],[82,"虽然是非官方的……","",null,""],[83,"是。","",null,""],[84,"也就是说，你想雇佣我们？","",null,""],[85,"叫我Kaz吧。","",null,""],[86,"请多关照，Paz。","",null,""],[87,"在日语里是‘和平’的意思。","",null,""],[88,"我叫<R=和平,Kazuhira>。","<R=和平,Kazuhira>",null,"CONTROL_OK"],[89,"哦？和我同名啊。","",null,""],[90,"<R=和平,La Paz>……","<R=和平,La Paz>",null,"CONTROL_OK"],[91,"她叫Paz……Paz Ortega。","",null,""],[92,"她是我的学生，在大学学习和平。","",null,""],[93,"她比任何人都痛恨战争。","",null,""],[94,"她幼年丧母，祖父母也死于内战……","",null,""],[95,"她是<R=私生女,Bastard>。","<R=私生女,Bastard>",null,"CONTROL_OK"],[96,"真残酷。","",null,""],[97,"她遭到凌辱，最后设法独自逃了出来。","",null,""],[98,"Paz才16岁，还是个孩子。","",null,""],[99,"后来，她被他们抓住了。","",null,""],[100,"Paz为寻找失踪的朋友，\n闯进了那座设施。","",null,"NEWLINE_PRESERVED"],[101,"就在几天前……","",null,""],[102,"在<R=加勒比海沿岸,Mar Caribe Costeña>的Puerto Limón以北，\n有他们运入物资的港口。","<R=加勒比海沿岸,Mar Caribe Costeña>",null,"CONTROL_OK;NEWLINE_PRESERVED"],[103,"正因为知道你是‘<R=BIG BOSS,Big Boss>’，我们才来拜托你。","<R=BIG BOSS,Big Boss>",null,"CONTROL_OK"],[104,"拜托你。","",null,""],[105,"抱歉……","",null,""],[106,"求你了！把那些家伙赶出我的祖国哥斯达黎加！","",null,""],[107,"我正是为此而活。","",null,""],[108,"我会守护和平到底。","",null,""],[109,"我的名字就是‘<R=和平,La Paz>’。","<R=和平,La Paz>",null,"CONTROL_OK"]
