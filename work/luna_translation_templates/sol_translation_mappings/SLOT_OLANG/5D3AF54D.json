  "translations":[
    [0,"我……","",null,""],[1,"国家还是恩师？任务还是信念？","",null,""],[2,"还是效忠于我？","",null,""],[3,"效忠国家吗？","",null,""],[4,"背景中播放的是1973年的热门歌曲。","",null,""],[5,"另一人身份不明，三十多岁的女性，带英国口音。","",null,""],[6,"你说什么？！","",null,""],[7,"声纹分析显示，其中一个声音与传奇英雄——\n罪犯‘The Boss’一致。","",null,"NEWLINE_PRESERVED"],[8,"Boss……","",null,""],[9,"回去！","",null,""],[10,"听着，我们不是雇佣兵，也不是外籍军团。","",null,""],[11,"不杀死它，被咬的就是你。","",null,""],[12,"我会把它赶走。","",null,""],[13,"赶不走的，那是一条凶猛的蛇。","",null,""],[14,"从这里开始。","",null,""],[15,"这到底算什么<R=地方,哪里>？！","<R=地方,哪里>",null,"CONTROL_OK"],[16,"她在森林里录制鸟鸣时，偶然发现了什么。","",null,""],[17,"Paz的朋友当时在研究鸟类。","",null,""],[18,"火之鸟？","",null,""],[19,"这是什么？绿咬鹃？","",null,""],[20,"听完这个，你应该会改变主意。","",null,""],[21,"一旦在<R=某处,哪里>安顿下来，\n我们也可能变成那种战争贩子。","<R=某处,哪里>",null,"CONTROL_OK;NEWLINE_PRESERVED"],[22,"没想到东方阵营也在开发。","",null,""],[23,"哦，我听说日本也正在开发。","",null,""],[24,"这是全球首款便携式产品。","",null,""],[25,"立体声盒式磁带播放机。","",null,""],[26,"那是什么？","",null,""],[27,"这盘磁带似乎是Paz的朋友偶然录下的。","",null,""],[28,"这是她——Paz从设施里带回来的。","",null,""],[29,"盒式磁带……？","",null,""],[30,"不，她们听到了不该听的东西。","",null,""],[31,"恐怕也看到了不该看的东西。","",null,""],[32,"你想在各个冲突地区间流浪，\n每次都被战场利用吗？","",null,"NEWLINE_PRESERVED"],[33,"她们为何遭到袭击？线索就在这里。","",null,""],[34,"她勉强逃出生天，\n她的朋友却还没有回来。","",null,"NEWLINE_PRESERVED"],[35,"不，我让她同行是有<R=理由,缘由>的。","<R=理由,缘由>",null,"CONTROL_OK"],[36,"你以为这种博取同情的故事能让我们接下委托？","",null,""],[37,"她确实被抓过，\n但我隐瞒了自己的KGB身份。","",null,"NEWLINE_PRESERVED"],[38,"哼，是<R=和平,Paz>的那套说辞吧。","<R=和平,Paz>",null,"CONTROL_OK"],[39,"……那个女孩呢？刚才的故事是编的？","",null,""],[40,"你想让我们介入KGB和CIA的争斗？","",null,""],[41,"然后把他们赶出去。","",null,""],[42,"首先前往Paz被关押的沿海设施，\n调查他们的阴谋并取得各据点的情报。","",null,"NEWLINE_PRESERVED"],[43,"我们继续做<R=流浪者,Nomad>就好。","<R=流浪者,Nomad>",null,"CONTROL_OK"],[44,"<R=BIG BOSS,Big Boss>，希望你和你的部队\n查明真相。","<R=BIG BOSS,Big Boss>",null,"CONTROL_OK;NEWLINE_PRESERVED"],[45,"我们也想知道答案。","",null,""],[46,"知道什么？","",null,""],[47,"而且CIA不只如此，他们还在这里谋划着什么。","",null,""],[48,"也就是说，驻扎在哥斯达黎加的军队由CIA出资。","",null,""],[49,"他们肯定是被派到邻国哥斯达黎加，\n妨碍我们在尼加拉瓜的行动。","",null,"NEWLINE_PRESERVED"],[50,"没错。","",null,""],[51,"那就是哥斯达黎加武装团体的真面目？","",null,""],[52,"所以CIA才会行动。","",null,""],[53,"正是。","",null,""],[54,"Kaz，我们不需要安居之地。","",null,""],[55,"可是<R=合众国,美国>也不会坐视不管吧？","<R=合众国,美国>",null,"CONTROL_OK"],[56,"革命成功后，尼加拉瓜将成为社会主义国家。","",null,""],[57,"你要推动<R=FSLN,桑地诺民族解放阵线>推翻尼加拉瓜亲美政权？","<R=FSLN,桑地诺民族解放阵线>",null,"CONTROL_OK"],[58,"我们煽动反Somoza舆论，并支援反Somoza势力——\n<R=桑地诺民族解放阵线,FSLN>。","<R=桑地诺民族解放阵线,FSLN>",null,"CONTROL_OK;NEWLINE_PRESERVED"],[59,"作为推翻亲美Somoza政权的准备……","",null,""],[60,"首先是尼加拉瓜。","",null,""],[61,"谁掌控中美洲，谁就能赢得‘冷战’。","",null,""],[62,"同时，我们将得到一座把南北美洲\n纳入射程的<R=基地,基地>。","<R=基地,基地>",null,"CONTROL_OK;NEWLINE_PRESERVED"],[63,"并失去其生产、流通和军事战略价值。","",null,""],[64,"<R=合众国,美国>会失去它的‘后院’。","<R=合众国,美国>",null,"CONTROL_OK"],[65,"借此机会可以壮大MSF。","",null,""],[66,"在这里建立社会主义国家，把南北美洲分隔开。","",null,""],[67,"我们想要这里。","",null,""],[68,"中美洲是连接南北美洲的脐带。","",null,""],[69,"智利诗人Neruda的诗……","",null,""],[70,"‘如鞭子般纤细，如酷刑般炽热的土地。’","",null,""],[71,"既然如此……事情就好办了。","",null,""],[72,"……从<R=KGB,Tsentr>来的你，该怎么称呼？","<R=KGB,Tsentr>",null,"CONTROL_OK"],[73,"你们喜欢用的代号，我十年前就舍弃了。","",null,""],[74,"我没有名字。","",null,""],[75,"那该叫你什么？John？","",null,""],[76,"那可是海上平台。","",null,""],[77,"那个代号是CIA捏造的。","",null,""],[78,"很荣幸见到传奇的<R=BIG BOSS,Big Boss>。","<R=BIG BOSS,Big Boss>",null,"CONTROL_OK"],[79,"戒烟之后，这东西就没什么用处了。","",null,""],[80,"我的肺出了问题。","",null,""],[81,"书记长授予我勋章时，\n也给了我这只义手……","",null,"NEWLINE_PRESERVED"],[82,"我以前是个老烟枪。","",null,""],[83,"还是问问‘教授’本人吧。","",null,""],[84,"Kaz，煮咖啡。","",null,""],[85,"咦？","",null,""],[86,"……雪茄点不着。","",null,""],[87,"他们愿意给我们这些无根浮萍\n一个安顿下来的地方。","",null,"NEWLINE_PRESERVED"],[88,"那样就无法回头了……","",null,""],[89,"……我们会与<R=故乡,美国>为敌。","<R=故乡,美国>",null,"CONTROL_OK"],[90,"这样啊……","",null,""],[91,"那个‘教授’恐怕是KGB。","",null,""],[92,"等等，这样一来……","",null,""],[93,"他们背后是CIA。","",null,""],[94,"不，用不着调查也知道。","",null,""],[95,"只要查明那家‘保安公司’的真面目就好。","",null,""],[96,"为了<R=和平,Paz>。","<R=和平,Paz>",null,"CONTROL_OK"],[97,"原来如此。","",null,""],[98,"为了那个女孩，为了<R=和平,Paz>。","<R=和平,Paz>",null,"CONTROL_OK"],[99,"Snake？","",null,""],[100,"等等！","",null,""],[101,"Snake，我们又不是要和他们开战。","",null,""],[102,"那么，这个已经不需要了？","",null,""],[103,"果然，你还是无法背叛祖国吗？","",null,""],[104,"Snake，这是陷阱。","",null,""],[105,"你愿意接下委托吗？","",null,""],[106,"来吧，你怎么选？","",null,""],[107,"你晋升为英雄<R=BIG BOSS,Big Boss>。","<R=BIG BOSS,Big Boss>",null,"CONTROL_OK"],[108,"然后，你奉CIA之命杀死了她……","",null,""],[109,"据我所知，她曾是你的上司，与你并肩作战……","",null,""],[110,"……难道Boss还活在哥斯达黎加？","",null,""],[111,"效忠自己……","",null,""],[112,"Snake，MSF是一门新式生意。","",null,""],[113,"Snake，我觉得这条件不坏。","",null,""],[114,"你还在吗？","",null,""]
