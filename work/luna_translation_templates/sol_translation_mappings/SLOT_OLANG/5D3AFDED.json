  "translations":[
    [0,"Snake，就是现在！","",null,""],[1,"哺乳舱的<R=伪装,模拟>数据还有些问题……","<R=伪装,模拟>",null,"CONTROL_OK"],[2,"大家<R=休息,休息>一下吧。","<R=休息,休息>",null,"CONTROL_OK"],[3,"Coldman，我想做最后一次确认。","",null,""],[4,"别拖到早上。","",null,""],[5,"还要花些时间。","",null,""],[6,"正在等待爬虫舱的<R=确认处理,确认>。","<R=确认处理,确认>",null,"CONTROL_OK"],[7,"情况如何？","",null,""],[8,"嗯……？","",null,""],[9,"<R=启动,启动>。","<R=启动,启动>",null,"CONTROL_OK"],[10,"是Boss吗？","",null,""],[11,"怎么了，Jack？","",null,""],[12,"Boss……","",null,""],[13,"……这样啊。","",null,""],[14,"这里很冷，冷得刺骨。","",null,""],[15,"心率稍微上升了。","",null,""],[16,"放下枪，<R=BIG BOSS,Big Boss>。","<R=BIG BOSS,Big Boss>",null,"CONTROL_OK"],[17,"Jack，住手。","",null,""],[18,"你是来毁掉我的吗？","",null,""],[19,"Boss已经死了！","",null,""],[20,"你不是Boss。","",null,""],[21,"Jack？","",null,""],[22,"没有符合描述的<R=任务,任务>记录。","<R=任务,任务>",null,"CONTROL_OK"],[23,"你是凭自己的<R=意志,意志>叛逃苏联的吗？","<R=意志,意志>",null,"CONTROL_OK"],[24,"……我再问一次！","",null,""],[25,"记录中没有那种任务简报。","",null,""],[26,"不是。","",null,""],[27,"被我杀了。","",null,""],[28,"然后……","",null,""],[29,"……是你的错觉。","",null,""],[30,"你背叛了美国……","",null,""],[31,"1964年9月。","",null,""],[32,"我……没有执行过那种任务。","",null,""],[33,"是格罗兹尼格勒的<R=任务,任务>。","<R=任务,任务>",null,"CONTROL_OK"],[34,"最后的<R=任务,任务>？","<R=任务,任务>",null,"CONTROL_OK"],[35,"对自己最后的<R=任务,任务>……","<R=任务,任务>",null,"CONTROL_OK"],[36,"后悔什么？","",null,""],[37,"你后悔了吗？","",null,""],[38,"你……","",null,""],[39,"怎么了，Jack？","",null,""],[40,"怎么了？你的体温在下降。","",null,""],[41,"……是Jack啊。","",null,""],[42,"闻起来像尸体啊？","",null,""],[43,"<R=狼,Lobo>？","<R=狼,Lobo>",null,"CONTROL_OK"],[44,"我叫<R=狼,Lobo>。","<R=狼,Lobo>",null,"CONTROL_OK"],[45,"那只郊狼我见过。","",null,""],[46,"很荣幸再次见到你，<R=BIG BOSS,Big Boss>。","<R=BIG BOSS,Big Boss>",null,"CONTROL_OK"],[47,"这是你就在附近的<R=征兆,迹象>。","<R=征兆,迹象>",null,"CONTROL_OK"],[48,"哺乳舱出现了和<R=研究设施,实验室>里相同的反应。","<R=研究设施,实验室>",null,"CONTROL_OK"],[49,"没那么简单，不过要用一句话概括……","",null,""],[50,"原来如此，你想东山再起？","",null,""],[51,"这是CIA的<R=拿手好戏,惯用手段>。","<R=拿手好戏,惯用手段>",null,"CONTROL_OK"],[52,"……让知情者闭嘴，或者把他们扔到<R=偏远地区,偏远地区>。","<R=偏远地区,偏远地区>",null,"CONTROL_OK"],[53,"那本该待在<R=总部,兰利>的\n<R=制服,西装男>，怎么会跑到这里？","<R=总部,兰利> | <R=制服,西装男>",null,"CONTROL_OK;NEWLINE_PRESERVED"],[54,"<R=消灭叛徒计划,食蛇者行动>。","<R=消灭叛徒计划,食蛇者行动>",null,"CONTROL_OK"],[55,"那次行动是我<R=策划,策划>的。","<R=策划,策划>",null,"CONTROL_OK"],[56,"你是……当时的相关人员？","",null,""],[57,"呵呵，真是个浪漫主义者。","",null,""],[58,"你打算让无人兵器背负人类的罪孽吗？","",null,""],[59,"这正是‘Peace Walker’发挥作用的地方。","",null,""],[60,"因此，需要一套兼具耐心与冷酷的\n<R=机器,机器>所构成的完美核威慑系统。","<R=机器,机器>",null,"CONTROL_OK;NEWLINE_PRESERVED"],[61,"‘新时代’即将到来。","",null,""],[62,"古巴导弹危机后，冷战格局开始轰然崩塌。","",null,""],[63,"<R=缓和,缓和>、<R=核不扩散条约,NPT>、<R=限制战略武器谈判,SALT>、\n<R=地下核试验限制条约,TTBT>。","<R=缓和,缓和> | <R=核不扩散条约,NPT> | <R=限制战略武器谈判,SALT> | <R=地下核试验限制条约,TTBT>",null,"CONTROL_OK;NEWLINE_PRESERVED"],[64,"我要创造新的世界秩序。","",null,""],[65,"十年前的捷林诺亚尔斯克。","",null,""],[66,"我很了解你。","",null,""],[67,"正因为<R=犹豫,迟疑>的人类参与其中，\n‘威慑理论’这种博弈才得以成立，不是吗？","<R=犹豫,迟疑>",null,"CONTROL_OK;NEWLINE_PRESERVED"],[68,"没错，正因如此，它才能成为真正的威慑力。","",null,""],[69,"AI会毫不犹豫地发射核武器？","",null,""],[70,"也就是说……人类无法按下核按钮。","",null,""],[71,"现在回想起来，\n他是从全面核战争中拯救世界的英雄。","",null,"NEWLINE_PRESERVED"],[72,"苏联潜艇军官拒绝执行\n向美国驱逐舰发射核鱼雷的命令。","",null,"NEWLINE_PRESERVED"],[73,"还记得古巴导弹危机吗？","",null,""],[74,"随着信念破灭的The Boss离去，英雄时代也结束了。","",null,""],[75,"……呵呵，你还是不明白。","",null,""],[76,"你的时代还会继续？","",null,""],[77,"将北美、南美和西印度群岛全部纳入射程，\n首先肃清这片大陆。","",null,"NEWLINE_PRESERVED"],[78,"我们将在中南美洲加勒比海沿岸部署Peace Walker。","",null,""],[79,"洪都拉斯、尼加拉瓜、哥斯达黎加、巴拿马……","",null,""],[80,"一旦获准采用，<R=总部,兰利>就会再次关注\n这个新冷战脐带般的拉丁美洲。","<R=总部,兰利>",null,"CONTROL_OK;NEWLINE_PRESERVED"],[81,"所以才需要由<R=机器,机器>构成的全自动威慑力量——\nPeace Walker。","<R=机器,机器>",null,"CONTROL_OK;NEWLINE_PRESERVED"],[82,"你的眼光确实不错。","",null,""],[83,"可用金钱购买的威慑力量，‘无国界军队’。\n这也是一种新体系。","",null,"NEWLINE_PRESERVED"],[84,"不，或许该说是你的<R=搭档,Miller>。","<R=搭档,Miller>",null,"CONTROL_OK"],[85,"这一点你应该最清楚吧？","",null,""],[86,"今后，‘没有感情的系统’将成为英雄。","",null,""],[87,"犯错的永远是人类。","",null,""],[88,"不，<R=机器,机器>不会犯错。","<R=机器,机器>",null,"CONTROL_OK"],[89,"核发射会按计划进行。","",null,""],[90,"收到消息，<R=SALT II,第二阶段限制战略武器谈判>将按计划举行。","<R=SALT II,第二阶段限制战略武器谈判>",null